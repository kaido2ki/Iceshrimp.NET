@page "/follow-requests/sent"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.FollowRequests_Outgoing]"/>
<SectionContent SectionName="top-bar-icon">
    <Icon Name="Icons.HandWaving"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.FollowRequests_Outgoing]
</SectionContent>
<SectionContent SectionName="top-bar-actions">
    <a class="action" href="/follow-requests">
        <Icon Name="Icons.ArrowSquareIn"/>
        <span class="label">@Loc[L.FollowRequests_SwitchToIncoming]</span>
    </a>
</SectionContent>

<FollowRequestList Outgoing="true"/>

@code {
}
@page "/follow-requests"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.FollowRequests]"/>
<SectionContent SectionName="top-bar-icon">
    <Icon Name="Icons.HandWaving"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.FollowRequests]
</SectionContent>
<SectionContent SectionName="top-bar-actions">
    <a class="action" href="/follow-requests/sent">
        <Icon Name="Icons.ArrowSquareOut"/>
        <span class="label">@Loc[L.FollowRequests_SwitchToOutgoing]</span>
    </a>
</SectionContent>

<FollowRequestList Outgoing="false"/>

@code {
}
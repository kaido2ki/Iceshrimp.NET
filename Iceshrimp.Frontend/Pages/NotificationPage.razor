@page "/notifications"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]

@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.Notifications]"/>
<SectionContent SectionName="top-bar-icon">
    <Icon Name="Icons.Bell"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Notifications]
</SectionContent>
<SectionContent SectionName="top-bar-actions">
    <button class="action" @onclick="MarkAllAsRead" title="@Loc[L.Notifications_MarkAllRead]">
        <Icon Name="Icons.Checks"/>
        <span class="label">@Loc[L.Notifications_MarkAllRead]</span>
    </button>
</SectionContent>

<NotificationList @ref="NotificationList"/>

@code {
    private NotificationList NotificationList { get; set; } = null!;

    private async Task MarkAllAsRead()
    {
        await NotificationList.MarkAllAsRead();
    }
}
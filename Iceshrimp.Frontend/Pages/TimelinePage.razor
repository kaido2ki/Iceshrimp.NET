@page "/"
@page "/timeline/{Timeline}"
@page "/timeline/remote/{Instance}"
@page "/tags/{Tag}"
@inject TimelineStore                  Store;
@inject StateService                   State;
@using System.Web
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Frontend.Core.Services.NoteStore
@using Iceshrimp.Frontend.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Helpers
@attribute [Authorize]
@inject JsService                      JsSvc;
@inject IStringLocalizer<Localization> Loc;
@inject GlobalComponentSvc             GlobalComponentSvc;
@inject NavigationManager              Nav;
@inject StreamingService               Streaming;
@implements IDisposable

<HeadTitle Text="@Loc[L.Common_Timeline]"/>

<SectionContent SectionName="top-bar">
    <Icon Name="Icons.House"></Icon>
    @Loc[L.Common_Timeline]
    <span class="action btn" @onclick="ScrollToTop" title="@Loc["Scroll to top"]">
        <Icon Name="Icons.ArrowLineUp"/>
        <span>@Loc["Scroll to top"]</span>
    </span>
    <span class="action btn" @onclick="RefetchTimeline" title="@Loc["Refetch"]">
        <Icon Name="Icons.ArrowsClockwise"/>
        <span>@Loc["Refetch"]</span>
    </span>
    <span class="action btn" @onclick="() => MenuRef.Toggle(MenuButton, false)" @ref="MenuButton">
        @switch (CurrentTimeline!.Enum)
        {
            case TimelineEnum.Home:
                <Icon Name="Icons.House"/>
                <span>@Loc[L.Timeline_Home]</span>
                break;
            case TimelineEnum.Local:
                <Icon Name="Icons.Users"/>
                <span>@Loc[L.Timeline_Local]</span>
                break;
            case TimelineEnum.Social:
                <Icon Name="Icons.Handshake"/>
                <span>@Loc[L.Timeline_Social]</span>
                break;
            case TimelineEnum.Bubble:
                <Icon Name="Icons.Hexagon"/>
                <span>@Loc[L.Timeline_Bubble]</span>
                break;
            case TimelineEnum.Global:
                <Icon Name="Icons.Globe"/>
                <span>@Loc[L.Timeline_Global]</span>
                break;
            case TimelineEnum.Remote:
                <Icon Name="Icons.Airplane"/>
                @if (CurrentTimeline.Remote != null)
                {
                    <span>@Loc[L.Timeline_Remote_Host, CurrentTimeline.Remote]</span>
                }
                else
                {
                    <span>@Loc[L.Timeline_Remote]</span>
                }
                break;
            case TimelineEnum.Tag:
                <Icon Name="Icons.Tag"/>
                @if (CurrentTimeline.Tag != null)
                {
                    <span>@Loc[L.Timeline_Tag_Name, CurrentTimeline.Tag]</span>
                }
                else
                {
                    <span>@Loc[L.Timeline_Tag]</span>
                }
                break;
        }
        <Menu @ref="MenuRef" Fixed="true">
            <MenuElement OnSelect="() => SwitchTimeline(TimelineEnum.Home)">
                <Text>
                    <Icon Name="Icons.House"/>@Loc[L.Timeline_Home]</Text>
            </MenuElement>
            <MenuElement OnSelect="() => SwitchTimeline(TimelineEnum.Local)">
                <Text>
                    <Icon Name="Icons.Users"/>@Loc[L.Timeline_Local]</Text>
            </MenuElement>
            <MenuElement OnSelect="() => SwitchTimeline(TimelineEnum.Social)">
                <Text>
                    <Icon Name="Icons.Handshake"/>@Loc[L.Timeline_Social]</Text>
            </MenuElement>
            <MenuElement OnSelect="() => SwitchTimeline(TimelineEnum.Bubble)">
                <Text>
                    <Icon Name="Icons.Hexagon"/>@Loc[L.Timeline_Bubble]</Text>
            </MenuElement>
            <MenuElement OnSelect="() => SwitchTimeline(TimelineEnum.Global)">
                <Text>
                    <Icon Name="Icons.Globe"/>@Loc[L.Timeline_Global]</Text>
            </MenuElement>
            <MenuElement OnSelect="PickRemote">
                <Text>
                    <Icon Name="Icons.Airplane"/>@Loc[L.Timeline_Remote]
                </Text>
            </MenuElement>
            <MenuElement OnSelect="PickTag">
                <Text>
                    <Icon Name="Icons.Tag" />@Loc[L.Timeline_Tag]
                </Text>
            </MenuElement>
        </Menu>
    </span>


</SectionContent>
<div @ref="TimelineRef" class="timeline">
    @if (NoteResponses is not null && _loaded)
    {
        <VirtualScroller InitialItems="NoteResponses" ItemProvider="Provider" StateKey="@CurrentTimeline!.Key"
                         ItemProviderById="ItemProviderById" StreamingItemProvider="Store" @ref="VirtualScroller">
            <ItemTemplate Context="note">
                <CascadingValue Value="Store" TValue="NoteMessageProvider" Name="Provider">
                    <TimelineNote Note="note"></TimelineNote>
                </CascadingValue>
            </ItemTemplate>
        </VirtualScroller>
    }
</div>

@code {
    [Parameter] public string?                        Timeline { get; set; }
    [Parameter] public string?                        Instance { get; set; }
    [Parameter] public string?                        Tag      { get; set; }
    private            bool                           _loaded;
    private            List<NoteResponse>?            NoteResponses   { get; set; }
    private            TimelineStore.Timeline?        CurrentTimeline { get; set; }
    private            Menu                           MenuRef         { get; set; } = null!;
    private            ElementReference               MenuButton      { get; set; }
    private            VirtualScroller<NoteResponse>? VirtualScroller { get; set; }
    private            ElementReference               TimelineRef     { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Timeline != null || Tag != null)
        {
            switch (Timeline)
            {
                case "local":
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Local));
                    break;
                case "social":
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Social));
                    break;
                case "bubble":
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Bubble));
                    break;
                case "global":
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Global));
                    break;
                case "remote":
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Remote, Instance));
                    break;
                case null when !string.IsNullOrEmpty(Tag):
                    SetTimeline(new TimelineStore.Timeline(TimelineEnum.Tag, Tag));
                    break;
            }
        }
        else
        {
            SetTimeline(State.TimelinePage.Current ?? new TimelineStore.Timeline(TimelineEnum.Home));
        }

        NoteResponses = await Store.GetTimelineAsync(CurrentTimeline!, new TimelineStore.Cursor { Direction = DirectionEnum.Older, Count = 20, Id = null });
        _loaded       = true;
        StateHasChanged();
    }

    private async Task<List<NoteResponse>?> Provider(DirectionEnum direction, NoteResponse start)
    {
        var res = await Store.GetTimelineAsync(CurrentTimeline!, new TimelineStore.Cursor { Direction = direction, Count = 10, Id = start.Id });
        return res;
    }

    private List<NoteResponse> ItemProviderById(List<string> arg)
    {
        return Store.GetIdsFromTimeline(CurrentTimeline!, arg);
    }

    private async Task SwitchTimeline(TimelineEnum timeline, string? remote = null)
    {
        VirtualScroller?.Save();
        _loaded = false;
        StateHasChanged();
        NoteResponses = null;
        SetTimeline(new TimelineStore.Timeline(timeline, remote));
        NoteResponses = await Store.GetTimelineAsync(CurrentTimeline!, new TimelineStore.Cursor { Direction = DirectionEnum.Older, Count = 20, Id = null });
        _loaded       = true;
        StateHasChanged();
    }

    private async Task PickRemote()
        => await GlobalComponentSvc.PromptDialog?.Prompt(new EventCallback<string?>(this, AddQuoteCallback), Loc[L.Timeline_Remote], Loc[L.User_Host], $"{CurrentTimeline!.Remote}")!;

    private async Task PickTag()
        => await GlobalComponentSvc.PromptDialog?.Prompt(new EventCallback<string?>(this, PickTagCallback), Loc[L.Timeline_Tag], "#", $"{CurrentTimeline!.Tag}")!;

    private async Task AddQuoteCallback(string? remote)
    {
        if (remote is null) return;
        await SwitchTimeline(TimelineEnum.Remote, remote);
    }

    private async Task PickTagCallback(string? tag)
    {
        if (tag is null) return;
        await SwitchTimeline(TimelineEnum.Tag, tag);
    }

    private void SetTimeline(TimelineStore.Timeline timeline)
    {
        if (CurrentTimeline != null)
        {
            _ = Streaming.UnsubscribeAsync(CurrentTimeline.Enum);
        }

        switch (timeline.Enum)
        {
            case TimelineEnum.Home:
                _ = Streaming.SubscribeAsync(TimelineEnum.Home);
                Nav.NavigateTo("/");
                break;
            case TimelineEnum.Local:
                _ = Streaming.SubscribeAsync(TimelineEnum.Local);
                Nav.NavigateTo("/timeline/local");
                break;
            case TimelineEnum.Social:
                _ = Streaming.SubscribeAsync(TimelineEnum.Social);
                Nav.NavigateTo("/timeline/social");
                break;
            case TimelineEnum.Bubble:
                _ = Streaming.SubscribeAsync(TimelineEnum.Bubble);
                Nav.NavigateTo("/timeline/bubble");
                break;
            case TimelineEnum.Global:
                _ = Streaming.SubscribeAsync(TimelineEnum.Global);
                Nav.NavigateTo("/timeline/global");
                break;
            case TimelineEnum.Remote:
                _ = Streaming.SubscribeToRemoteFeedAsync(timeline.Remote!);
                Nav.NavigateTo($"/timeline/remote/{HttpUtility.UrlEncode(timeline.Remote)}");
                break;
            case TimelineEnum.Tag:
                Nav.NavigateTo($"/tags/{HttpUtility.UrlEncode(timeline.Tag)}");
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }

        CurrentTimeline = timeline;
    }

    private async Task ScrollToTop()
    {
        await JsSvc.ScrollToElementAsync(TimelineRef, JsService.ScrollBehavior.Smooth);
    }

    private async Task RefetchTimeline()
    {
        _loaded = false;
        StateHasChanged();
        await JsSvc.ScrollToElementAsync(TimelineRef, JsService.ScrollBehavior.Instant);
        await OnInitializedAsync();
    }

    public void Dispose()
    {
        State.TimelinePage.Current = CurrentTimeline;
    }
}

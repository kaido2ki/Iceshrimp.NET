@page "/settings/about"
@using System.Text
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.InMemoryLogger
@using Iceshrimp.Frontend.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Shared.Schemas.Web
@attribute [Authorize]
@layout SettingsLayout;
@inject ApiService                     Api;
@inject VersionService                 Version;
@inject IStringLocalizer<Localization> Loc;
@inject IJSRuntime                     Js;
@inject InMemoryLogService             LogSvc;

<HeadTitle Text="@Loc[L.Settings_About]"/>
<SectionContent SectionName="top-bar-icon">
    <Icon Name="Icons.Info"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Settings_About]
</SectionContent>

<div class="body">
    @if (Instance != null)
    {
        <div class="instance">
            <h1>@Loc[L.Settings_About_CurrentInstance]</h1>
            @if (Instance.BannerUrl != null)
            {
                <img class="banner" src="@Instance.BannerUrl" alt="Instance banner"/>
            }
            <span class="name">@Instance.Name</span>
            @if (Instance.AccountDomain != Instance.WebDomain)
            {
                <span class="value">
                    <code>@@@Instance.AccountDomain</code>
                    /
                    <code>https://@Instance.WebDomain</code>
                </span>
            }
            else
            {
                <span class="value">
                    <code>@Instance.AccountDomain</code>
                </span>
            }
            <span class="name">@Loc[L.Instance_AdminEmail]</span>
            <span class="value">
                @if (Instance.ContactEmail != null)
                {
                    <a href="@($"mailto:{Instance.ContactEmail}")">@Instance.ContactEmail</a>
                }
                else
                {
                    <i>@Loc[L.Instance_NoInfoProvided]</i>
                }
            </span>
            <span class="name">@Loc[L.Common_Description]</span>
            <span class="value">
                @if (!string.IsNullOrWhiteSpace(Instance.Description))
                {
                    <MfmText Text="@Instance.Description"/>
                }
                else
                {
                    <i>@Loc[L.Instance_NoInfoProvided]</i>
                }
            </span>
            <span class="name">@Loc[L.Instance_Rules]</span>
            <span class="value">
                @if (Rules is {Count: > 0})
                {
                    <ol class="rules">
                        @foreach (var rule in Rules)
                        {
                            <li>
                                @rule.Text
                                @if (rule.Description != null)
                                {
                                    <br/>
                                    <i>@rule.Description</i>
                                }
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <i>@Loc[L.Instance_NoInfoProvided]</i>
                }
            </span>
            @if (Staff is { Admins.Count: > 0 })
            {
                <span class="name">@Loc[L.Instance_Admins]</span>
                <span class="value">
                    @foreach (var admin in Staff.Admins)
                    {
                        <UserProfileCard User="admin" ShowBio="false"/>
                    }
                </span>
            }
            @if (Staff is { Moderators.Count: > 0 })
            {
                <span class="name">@Loc[L.Instance_Moderators]</span>
                <span class="value">
                    @foreach (var moderator in Staff.Moderators)
                    {
                        <UserProfileCard User="moderator" ShowBio="false"/>
                    }
                </span>
            }
            <span class="name">@Loc[L.Instance_Limits]</span>
            <span class="value">
                <table>
                    <tbody>
                    <tr>
                        <th>@Loc[L.Instance_Limits_Regs]</th>
                        <td>@switch (Instance.Registration)
                            {
                                case Registrations.Closed:
                                    @Loc[L.Instance_Limits_Regs_Closed]
                                    break;
                                case Registrations.Invite:
                                    @Loc[L.Instance_Limits_Regs_Invite]
                                    break;
                                case Registrations.Open:
                                    @Loc[L.Instance_Limits_Regs_Open]
                                    break;
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@Loc[L.Instance_Limits_NoteCharacterCount]</th>
                        <td>@Instance.Limits.NoteLength</td>
                    </tr>
                    <tr>
                        <th>@Loc[L.Instance_Limits_BioCharacterCount]</th>
                        <td>@Instance.Limits.ProfileDescriptionLength</td>
                    </tr>
                    <tr>
                        <th>@Loc[L.Instance_Limits_FieldCount]</th>
                        <td>@Instance.Limits.ProfileFieldsCount</td>
                    </tr>
                    <tr>
                        <th>@Loc[L.Instance_Limits_FieldNameCharacterCount]</th>
                        <td>@Instance.Limits.ProfileFieldsNameLength</td>
                    </tr>
                    <tr>
                        <th>@Loc[L.Instance_Limits_FieldValueCharacterCount]</th>
                        <td>@Instance.Limits.ProfileFieldsValueLength</td>
                    </tr>
                    </tbody>
                </table>
            </span>
        </div>
    }
    <div class="version">
        <h1>@Loc[L.Settings_About_CurrentVersion]</h1>
        <span class="name">Iceshrimp.NET</span>
        <span class="value">
            <code>@Version.Version</code>
        </span>
        <span class="name">@Loc[L.Update_Codename]</span>
        <span class="value">
            <code>@Version.Codename</code>
        </span>
        @if (Version.CommitHash != null)
        {
            <span class="name">@Loc[L.Update_Commit]</span>
            <span class="value">
                <code>@Version.CommitHash</code>
            </span>
        }
        <span class="name">.NET Runtime</span>
        <span class="value">
            <code>@Environment.Version</code>
        </span>
    </div>
    <div class="logs">
        <h1>@Loc[L.ErrorUi_Logs]</h1>
        @Loc[L.ErrorUi_LogsWarning]
        <button class="button" @onclick="DownloadLogs">
            <Icon Name="Icons.DownloadSimple"/>
            <span>@Loc[L.ErrorUi_DownloadLogs]</span></button>
    </div>

</div>

@code {
    private IJSInProcessObjectReference _module = null!;
    private InstanceResponse?           Instance { get; set; }
    private List<RuleResponse>?         Rules    { get; set; }
    private StaffResponse?              Staff    { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Instance      = await Api.Instance.GetInstanceAsync();
        Rules         = await Api.Instance.GetRulesAsync();
        Staff         = await Api.Instance.GetStaffAsync();

        _module = (IJSInProcessObjectReference)await Js.InvokeAsync<IJSObjectReference>("import", "./Components/ErrorUi.razor.js");
    }

    private void DownloadLogs()
    {
        var logBytes = LogSvc.GetLogs().SelectMany(p => Encoding.UTF8.GetBytes(p)).ToArray();
        _module.InvokeVoid("DownloadFile", "log.txt", "text/plain", logBytes);
    }
}

@page "/settings/filters"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]
@layout SettingsLayout
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.Settings_Filters]"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/settings">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.SpeakerX"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Settings_Filters]
</SectionContent>
<SectionContent SectionName="top-bar-actions">
    @if (State is State.Empty or State.Loaded)
    {
        <button class="action" @onclick="NewFilter">
            <Icon Name="Icons.Plus"/>
            <span class="label">@Loc[L.Common_Add]</span>
        </button>
    }
</SectionContent>

<div class='body'>
    @if (State is State.Loaded)
    {
        <h1>@Loc[L.Settings_Filters_Heading_Active]</h1>
        @foreach (var filter in FilterList)
        {
            <article class="card filter">
                <div id="@filter.Id" class="badge-group">
                    <h3>@filter.Name</h3>
                    @if (filter.Action == FilterResponse.FilterAction.Warn)
                    {
                        <span class="badge warning">@Loc[L.Settings_Filters_Action_Warn]</span>
                    }
                    else
                    {
                        <span class="badge danger">@Loc[L.Common_Hide]</span>
                    }
                </div>
                @if (filter.Expiry != null)
                {
                    <span>
                        @Loc[L.Settings_Filters_ExpiresAt_DateTime, filter.Expiry.Value.ToLocalTime().ToString("G")]
                    </span>
                }
                <div>
                    <span>@Loc[L.Settings_Filters_Keywords]</span>
                    <ul>
                        @foreach (var keyword in filter.Keywords)
                        {
                            <li>@keyword</li>
                        }
                    </ul>
                </div>
                <div>
                    <span>@Loc[L.Settings_Filters_Contexts]</span>
                    <ul>
                        @foreach (var context in filter.Contexts)
                        {
                            <li>@context</li>
                        }
                    </ul>
                </div>
                <div class="button-group">
                    <button class="card-button" @onclick="() => EditFilter(filter)">
                        <Icon Name="Icons.PencilLine"/>
                        @Loc[L.Common_Edit]
                    </button>
                    <button class="card-button danger" @onclick="() => DeleteFilter(filter.Id)">
                        <Icon Name="Icons.Trash"/>
                        @Loc[L.Common_Delete]
                    </button>
                </div>
            </article>
        }
    }
</div>

<dialog closedby="none" class="@(Waiting ? "" : "modal filter-modal")" @ref="Dialog">
    @if (Waiting)
    {
        <LoadingSpinner/>
    }
    else
    {
        <div class="dialog-header">
            @Loc[Editing != null ? L.Settings_Filters_Heading_Edit : L.Settings_Filters_Heading_New]
        </div>

        <div class="filter-form">
            <label>
                @Loc[L.Common_Name]
                <input type="text" required class="full-width" @bind="Request.Name"/>
            </label>

            <label class="contexts">
                @Loc[L.Settings_Filters_Action]
                <select @bind="Request.Action">
                    <option value="@FilterResponse.FilterAction.Warn">
                        @Loc[L.Settings_Filters_Action_Warn]
                    </option>
                    <option value="@FilterResponse.FilterAction.Hide">
                        @Loc[L.Common_Hide]
                    </option>
                </select>
            </label>

            <div class="contexts">
                <span>@Loc[L.Settings_Filters_Contexts]</span>
                @foreach (var el in Request.Contexts)
                {
                    <div class="context">
                        <span>@el</span>
                        <button class="button" @onclick="() => Request.Contexts.Remove(el)">
                            <Icon Name="Icons.Trash"/>
                        </button>
                    </div>
                }
                <MenuButton ButtonClass="button">
                    <ButtonContent>
                        <Icon Name="Icons.Plus"/>
                        <span>@Loc[L.Common_Add]</span>
                    </ButtonContent>
                    <Elements>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Home)">
                            <Text>@Loc[L.Timeline_Home]</Text>
                        </MenuElement>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Lists)">
                            <Text>@Loc[L.Settings_Filters_Context_Lists]</Text>
                        </MenuElement>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Threads)">
                            <Text>@Loc[L.Settings_Filters_Context_Threads]</Text>
                        </MenuElement>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Notifications)">
                            <Text>@Loc[L.Notifications]</Text>
                        </MenuElement>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Accounts)">
                            <Text>@Loc[L.Settings_Filters_Context_Profiles]</Text>
                        </MenuElement>
                        <MenuElement OnSelect="() => AddFilterContext(FilterResponse.FilterContext.Public)">
                            <Text>@Loc[L.Note_Visibility_Public]</Text>
                        </MenuElement>
                    </Elements>
                </MenuButton>
            </div>

            <div class="contexts">
                <label>
                    <input type="checkbox" @bind="TemporaryFilter">
                    @Loc[L.Settings_Filters_ExpiresAt_Enable]
                </label>
                <label>
                    @Loc[L.Settings_Filters_ExpiresAt]
                    <input @bind="Request.Expiry" type="datetime-local" disabled="@(!TemporaryFilter)"/>
                </label>
            </div>

            <div class="keywords">
                <label>
                    @Loc[L.Settings_Filters_Keywords]
                    <textarea class="full-width" @bind="Keywords" @bind:event="oninput"></textarea>
                </label>
                <span>@Loc[L.Settings_Filters_KeywordInfo]</span>
                @if (Keywords.Split('\n', StringSplitOptions.TrimEntries).Any(l => l.Length > 1 && l.StartsWith('/') && l.EndsWith('/')))
                {
                    <WarningBanner>@Loc[L.Settings_Filters_RegexInfo]</WarningBanner>
                }
            </div>
        </div>

        <div class="dialog-footer button-group">
            <button class="button primary-button" @onclick="Submit">
                @Loc[L.Dialog_Submit]
            </button>
            <button class="button" @onclick="() => Js.CloseDialogAsync(Dialog)">
                @Loc[L.Common_Close]
            </button>
        </div>
    }
</dialog>

@code {
    private List<FilterResponse> FilterList      { get; set; } = [];
    private State                State           { get; set; } = State.Loading;
    private string               Keywords        { get; set; } = "";
    private bool                 TemporaryFilter { get; set; }
    private ElementReference     Dialog          { get; set; }
    private bool                 Waiting         { get; set; }
    private long?                Editing         { get; set; }

    private FilterRequest Request { get; set; } = new FilterRequest
    {
        Name     = "",
        Keywords = [],
        Action   = FilterResponse.FilterAction.Hide,
        Contexts = [],
        Expiry   = null
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            FilterList = (List<FilterResponse>)await Api.Filters.GetFiltersAsync();
            State      = State.Loaded;
        }
        catch (ApiException)
        {
            State = State.Error;
        }
    }

    private async Task DeleteFilter(long id)
    {
        try
        {
            if (await Api.Filters.DeleteFilterAsync(id))
            {
                var index = FilterList.FindIndex(p => p.Id == id);
                FilterList.RemoveAt(index);
            }
        }
        catch (ApiException) { }
    }

    private async Task Submit()
    {
        if (Waiting) return;

        Request.Name = Request.Name.Trim();

        if (Request.Name.Length < 1)
        {
            await Global.NoticeDialog?.Display(Loc[L.Settings_Filters_Error_NameRequired], NoticeDialog.NoticeType.Error)!;
            return;
        }

        Request.Keywords = Keywords.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

        if (Request.Keywords.Count == 0)
        {
            await Global.NoticeDialog?.Display(Loc[L.Settings_Filters_Error_KeywordsRequired], NoticeDialog.NoticeType.Error)!;
            return;
        }

        if (Request.Contexts.Count < 1)
        {
            await Global.NoticeDialog?.Display(Loc[L.Settings_Filters_Error_ContextRequired], NoticeDialog.NoticeType.Error)!;
            return;
        }

        if (!TemporaryFilter)
        {
            Request.Expiry = null;
        }

        Waiting = true;

        try
        {
            if (Editing is { } id)
            {
                await Api.Filters.UpdateFilterAsync(id, Request);
                FilterList.RemoveAll(p => p.Id == id);
                FilterList.Add(new FilterResponse
                {
                    Id       = id,
                    Name     = Request.Name,
                    Keywords = Request.Keywords,
                    Action   = Request.Action,
                    Contexts = Request.Contexts,
                    Expiry   = Request.Expiry
                });
            }
            else
            {
                var filter = await Api.Filters.CreateFilterAsync(Request);
                FilterList.Add(filter);
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
            Waiting = false;
            StateHasChanged();
            return;
        }

        await Js.CloseDialogAsync(Dialog);

        Waiting = false;
        StateHasChanged();
    }

    private void ResetState()
    {
        Request.Name     = "";
        Request.Keywords = [];
        Request.Action   = FilterResponse.FilterAction.Hide;
        Request.Contexts = [];
        Request.Expiry   = null;
        Keywords         = "";
        TemporaryFilter  = false;
        Editing          = null;
    }

    private void AddFilterContext(FilterResponse.FilterContext context)
    {
        if (!Request.Contexts.Contains(context))
        {
            Request.Contexts.Add(context);
        }
    }

    private async Task NewFilter()
    {
        ResetState();
        await Js.ShowDialogAsync(Dialog);
    }

    private async Task EditFilter(FilterResponse response)
    {
        Request = new FilterRequest
        {
            Name     = response.Name,
            Keywords = [],
            Action   = response.Action,
            Contexts = response.Contexts,
            Expiry   = response.Expiry
        };
        Keywords        = string.Join('\n', response.Keywords);
        TemporaryFilter = response.Expiry != null;
        Editing         = response.Id;

        await Js.ShowDialogAsync(Dialog);
    }
}
@page "/settings/account"
@using Iceshrimp.Frontend.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Frontend.Components

@attribute [Authorize]
@layout SettingsLayout
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject ILogger<Profile>               Logger;
@inject IStringLocalizer<Localization> Loc;
@inject JsService                      Js;

<HeadTitle Text="@Loc[L.Settings_Account]"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/settings">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.UserCircleGear"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Settings_Account]
</SectionContent>

@if (State is State.Loaded)
{
    <div class="body">
        <section>
            <h1>@Loc[L.Settings_Account_Heading_Preferences]</h1>
            <EditForm OnSubmit="Submit" Model="SettingsForm">
                <label>
                    @Loc[L.Settings_Account_DefaultNoteVisibility]
                    <InputSelect @bind-Value="SettingsForm.DefaultNoteVisibility">
                        <option value="@NoteVisibility.Public">@Loc[L.Note_Visibility_Public]</option>
                        <option value="@NoteVisibility.Home">@Loc[L.Note_Visibility_Unlisted]</option>
                        <option value="@NoteVisibility.Followers">@Loc[L.Note_Visibility_Followers]</option>
                        <option value="@NoteVisibility.Specified">@Loc[L.Note_Visibility_Specified]</option>
                    </InputSelect>
                </label>
                <label>
                    @Loc[L.Settings_Account_DefaultRenoteVisibility]
                    <InputSelect @bind-Value="SettingsForm.DefaultRenoteVisibility">
                        <option value="@NoteVisibility.Public">@Loc[L.Note_Visibility_Public]</option>
                        <option value="@NoteVisibility.Home">@Loc[L.Note_Visibility_Unlisted]</option>
                        <option value="@NoteVisibility.Followers">@Loc[L.Note_Visibility_Followers]</option>
                    </InputSelect>
                </label>
                <label>
                    @Loc[L.Settings_Account_TranslationLanguage]
                    <InputSelect @bind-Value="SettingsForm.TranslationLanguage">
                        <option value="serverDefault">@Loc[L.Settings_Account_TranslationLanguage_ServerDefault, InstanceResponse.DefaultTranslationLanguage]</option>
                        @foreach (var language in LocaleHelper.Languages)
                        {
                            <option value="@language.Key">@language.Value</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    @Loc[L.Settings_Account_AllowBites]
                    <InputSelect @bind-Value="SettingsForm.CanBite">
                        <option value="@BiteControl.Public">@Loc[L.Settings_Account_AllowBites_Public]</option>
                        <option value="@BiteControl.Followers">@Loc[L.Settings_Account_AllowBites_Followers]</option>
                        <option value="@BiteControl.None">@Loc[L.Settings_Account_AllowBites_None]</option>
                    </InputSelect>
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.PrivateMode"/>
                    @Loc[L.Settings_Account_PrivateMode]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.FilterInaccessible"/>
                    @Loc[L.Settings_Account_FilterInaccessible]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.HideRepliesNotFollowing"/>
                    @Loc[L.Settings_Account_FilterNotFollowing]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.ManuallyAcceptFollows" disabled="@SettingsForm.PrivateMode"/>
                    @Loc[L.Settings_Account_ManuallyAcceptFollows]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.AutoAcceptFollowed"/>
                    @Loc[L.Settings_Account_AutoAcceptFollowed]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.AlwaysMarkSensitive"/>
                    @Loc[L.Settings_Account_AlwaysMarkSensitive]
                </label>
                <label>
                    <InputCheckbox @bind-Value="SettingsForm.IsExplorable"/>
                    @Loc[L.Settings_Account_MarkExplorable]
                </label>
                <label>
                    @Loc[L.Settings_Account_AttributionDomains]
                    <a href="https://blog.joinmastodon.org/2024/07/highlighting-journalism-on-mastodon/"
                       target="_blank">(@Loc[L.Common_MoreInfo])</a>
                    <InputTextArea @bind-Value="AttributionDomains" class="full-width" placeholder="example.org"/>
                </label>
                <StateButton ExtraClasses="button" @ref="@SaveButton" OnClick="Submit">
                    <Initial>@Loc[L.StateButton_SaveChanges]</Initial>
                    <Success>@Loc[L.StateButton_Saved]</Success>
                    <Loading>@Loc[L.StateButton_Loading]<LoadingSpinner />
                    </Loading>
                    <Failed>@Loc[L.StateButton_Error]</Failed>
                </StateButton>
            </EditForm>
        </section>
        
        <h1>@Loc[L.Settings_Account_Heading_UpdatePassword]</h1>
        <EditForm OnSubmit="ChangePassword" Model="PasswordForm">
            <label for="old-password">@Loc[L.Settings_Account_Password_Old]</label>
            <InputText @bind-Value="PasswordForm.OldPassword" type="password" class="input" id="old-password" required/>
            <label for="new-password">@Loc[L.Settings_Account_Password_New]</label>
            <InputText @bind-Value="PasswordForm.NewPassword" type="password" class="input" id="new-password" minlength="8" required/>
            <label for="confirm-password">@Loc[L.Settings_Account_Password_NewConfirm]</label>
            <InputText @bind-Value="ConfirmPassword" type="password" class="input" id="confirm-password" minlength="8" required/>
            <StateButton ExtraClasses="button" @ref="@PasswordButton" OnClick="ChangePassword">
                <Initial>@Loc[L.Settings_Account_Password_StateButton_Initial]</Initial>
                <Success>@Loc[L.Settings_Account_Password_StateButton_Success]</Success>
                <Loading>@Loc[L.StateButton_Loading]<LoadingSpinner/>
                </Loading>
                <Failed>@Loc[L.StateButton_Error]</Failed>
            </StateButton>
        </EditForm>

        <h1>@Loc[L.Settings_Account_2fa]</h1>
        @if (SettingsForm.TwoFactorEnrolled == false)
        {
            <button class="button" @onclick="Enroll2FA">@Loc[L.Settings_Account_2fa_Enable]</button>
        }
        @if (SettingsForm.TwoFactorEnrolled)
        {
            <button class="button" @onclick="Disable2FAMenu">@Loc[L.Settings_Account_2fa_Disable]</button>
        }

        <dialog closedby="none" class="modal" @ref="EnrollDialog">
            @if (TwoFactorResponse is not null)
            {
                <div class="dialog-header">
                    @Loc[L.Settings_Account_2fa]
                </div>
                <p>@Loc[L.Settings_Account_2fa_EnrolInfo]</p>
                <img class="qr" src="@TwoFactorResponse.QrPng"/>
                <span>@Loc[L.Settings_Account_2fa_Secret]</span>
                <pre class="item"><code>@TwoFactorResponse.Secret</code></pre>
                <span>@Loc[L.Common_Url]</span>
                <pre class="item"><code>@TwoFactorResponse.Url</code></pre>
                <input class="otp-input" @bind="OtpEnable" autocomplete="one-time-code" autofocus
                       placeholder="@Loc[L.Settings_Account_2fa_CodePlaceholder]"/>
                <div class="dialog-footer button-group">
                    <StateButton ExtraClasses="button primary-button" @ref="TwoFactorButton" OnClick="Confirm2FA">
                        <Loading>@Loc[L.StateButton_Loading]</Loading>
                        <Failed>@Loc[L.Settings_Account_2fa_StateButton_EnableError]</Failed>
                        <Success>@Loc[L.Settings_Account_2fa_StateButton_EnableSuccess]</Success>
                        <Initial>@Loc[L.Common_Enable]</Initial>
                    </StateButton>
                    <button class="button" @onclick="() => CloseDialog(EnrollDialog)">
                        @Loc[L.Dialog_Cancel]
                    </button>
                </div>
            }
        </dialog>
    </div>
}

@code {
    private UserSettingsResponse         SettingsForm       { get; set; } = null!;
    private InstanceResponse             InstanceResponse   { get; set; } = null!;
    private ChangePasswordRequest        PasswordForm       { get; set; } = null!;
    private string                       ConfirmPassword    { get; set; } = "";
    private State                        State              { get; set; } = State.Loading;
    private StateButton                  SaveButton         { get; set; } = null!;
    private StateButton                  PasswordButton     { get; set; } = null!;
    private StateButton                  TwoFactorButton    { get; set; } = null!;
    private ElementReference             EnrollDialog       { get; set; }
    private TwoFactorEnrollmentResponse? TwoFactorResponse  { get; set; }
    private string?                      OtpEnable          { get; set; }
    private string                       AttributionDomains { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        SettingsForm       = await Api.Settings.GetSettingsAsync();
        InstanceResponse   = await Api.Instance.GetInstanceAsync();
        AttributionDomains = string.Join('\n', SettingsForm.AttributionDomains);

        PasswordForm = new ChangePasswordRequest { OldPassword = "", NewPassword = "" };
        State        = State.Loaded;
    }

    private async Task Submit()
    {
        SettingsForm.AttributionDomains = AttributionDomains.Split([' ', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (SettingsForm.TranslationLanguage == "serverDefault")
            SettingsForm.TranslationLanguage = null;

        try
        {
            var res = await Api.Settings.UpdateSettingsAsync(SettingsForm);
            SaveButton.State = StateButton.StateEnum.Loading;
            StateHasChanged();
            SaveButton.State = res ? StateButton.StateEnum.Success : StateButton.StateEnum.Failed;
        }
        catch (ApiException)
        {
            SaveButton.State = StateButton.StateEnum.Failed;
        }
    }

    private async Task ChangePassword()
    {
        if (PasswordButton.State == StateButton.StateEnum.Loading || string.IsNullOrWhiteSpace(PasswordForm.OldPassword) || PasswordForm.NewPassword.Length < 8 || ConfirmPassword.Length < 8) return;

        if (!PasswordForm.NewPassword.Equals(ConfirmPassword, StringComparison.Ordinal))
        {
            await Global.NoticeDialog?.Display(Loc[L.Settings_Account_Error_ConfirmPassword], NoticeDialog.NoticeType.Error)!;
            PasswordButton.State = StateButton.StateEnum.Failed;
            return;
        }

        PasswordButton.State = StateButton.StateEnum.Loading;

        try
        {
            var res = await Api.Auth.ChangePasswordAsync(PasswordForm);
            PasswordButton.State = res.Status == AuthStatusEnum.Authenticated
                ? StateButton.StateEnum.Success
                : StateButton.StateEnum.Failed;

            PasswordForm.OldPassword = "";
            PasswordForm.NewPassword = "";
            ConfirmPassword          = "";

            await Global.NoticeDialog?.Display(Loc[L.Settings_Account_ChangePasswordDialog_Notice], NoticeDialog.NoticeType.Error)!;
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
            PasswordButton.State = StateButton.StateEnum.Failed;
        }
    }

    private async Task Enroll2FA()
    {
        TwoFactorResponse = await Api.Settings.EnrollTwoFactorAsync();
        await Js.ShowDialogAsync(EnrollDialog);
    }

    private async Task Disable2FAMenu()
    {
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, Disable2FA), Loc[L.Settings_Account_2fa], Loc[L.Settings_Account_2fa_CodePlaceholder], null, buttonText: Loc[L.Common_Disable])!;
    }

    private async Task Disable2FA(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;

        try
        {
            await Api.Settings.DisableTwoFactorAsync(new TwoFactorRequest { Code = code });
            await Task.Delay(1000);
            SettingsForm = await Api.Settings.GetSettingsAsync();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task Confirm2FA()
    {
        if (OtpEnable is null)
        {
            return;
        }

        try
        {
            TwoFactorButton.State = StateButton.StateEnum.Loading;
            StateHasChanged();
            await Api.Settings.ConfirmTwoFactorAsync(new TwoFactorRequest { Code = OtpEnable });
            TwoFactorButton.State = StateButton.StateEnum.Success;
            StateHasChanged();
            await Task.Delay(1000);
            SettingsForm = await Api.Settings.GetSettingsAsync();
            await Js.CloseDialogAsync(EnrollDialog);
        }

        catch (ApiException e)
        {
            Logger.LogError(e, "2FA enrollment failed");
            TwoFactorButton.State = StateButton.StateEnum.Failed;
        }
    }

    private async Task CloseDialog(ElementReference dialog)
    {
        await Js.CloseDialogAsync(dialog);
    }
}

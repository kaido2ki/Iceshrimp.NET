@page "/settings/debug"
@attribute [Authorize]
@layout SettingsLayout;

@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections

@inject IStringLocalizer<Localization> Loc;
@inject ILogger<Debug> Logger;

<HeadTitle Text="@Loc[L.Settings_Debug]"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/settings">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.Bug"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Settings_Debug]
</SectionContent>

<div class="body">
    <button class="button" @onclick="@Crash">@Loc[L.Settings_Debug_Crash]</button>

</div>

@code {
    private void Crash()
    {
        Logger.LogInformation("Crashing Application");
        throw new Exception("Application intentionally crashed.");
    }
}
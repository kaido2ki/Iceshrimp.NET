@page "/settings/profile"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Configuration
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]
@layout SettingsLayout
@inject ApiService                     Api;
@inject ILogger<Profile>               Logger;
@inject IStringLocalizer<Localization> Loc;
@inject JsService                      Js
@inject GlobalComponentSvc             GlobalComponentSvc
@inject SessionService                 Session;

<HeadTitle Text="@Loc[L.Settings_Profile]"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/settings">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.User"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Settings_Profile]
</SectionContent>

<section class="body">
    @if (State is State.Loaded)
    {
        <h1>
            @Loc[L.Settings_Profile_Heading_About_Username, Session.Current?.Username ?? L.User]
        </h1>
        <section>
            <h2>@Loc[L.Settings_Profile_Heading_Images]</h2>
            @if (Banner != null)
            {
                <img class="banner" src="@Banner.Url" alt="@Banner.Description" title="@Banner.Description"/>
            }
            <img class="avatar" src="@(Avatar?.Url ?? $"/identicon/{Session.Current!.Id}")" alt="@Avatar?.Description" title="@Avatar?.Description"/>
            <div class="button-group">
                <button @onclick="OpenUploadAvatarDialogAsync" class="button">
                    <Icon Name="Icons.Upload"/>
                    @Loc[L.Settings_Profile_UploadAvatar]
                </button>
                @if (Avatar != null)
                {
                    <button @onclick="OpenEditAvatarDialogAsync" class="button">
                        <Icon Name="Icons.PencilLine"/>
                        @Loc[L.Settings_Profile_EditAvatar]
                    </button>
                }
                <button @onclick="OpenUploadBannerDialogAsync" class="button">
                    <Icon Name="Icons.Upload"/>
                    @Loc[L.Settings_Profile_UploadBanner]
                </button>
                @if (Banner != null)
                {
                    <button @onclick="OpenEditBannerDialogAsync" class="button">
                        <Icon Name="Icons.PencilLine"/>
                        @Loc[L.Settings_Profile_EditBanner]
                    </button>
                }
            </div>
        </section>

        <section>
            <h2>@Loc[L.Common_Description]</h2>
            <label>
                @Loc[L.User_DisplayName]
                <input class="full-width" @bind="@UserProfile.DisplayName" placeholder="@Session.Current?.Username"/>
            </label>
            <label>
                @Loc[L.User_Bio]
                <textarea class="full-width" @ref="Description" @bind="@UserProfile.Description" rows="5"></textarea>
            </label>
            <button @ref="EmojiButton" class="button" title="@Loc[L.Common_Emojis]" @onclick="ToggleEmojiPicker"
                    aria-label="emoji">
                <Icon Name="Icons.Smiley" Size="1.3rem"></Icon>
            </button>
            <div class="field pronouns-field">
                <label>
                    @Loc[L.User_Birthday]
                    <input type="date" class="full-width" @bind="@Birthday" disabled="@(!SetBirthday)"/>
                </label>
                <input type="checkbox" @bind="@SetBirthday">
            </div>
            <label>
                @Loc[L.User_Location]
                <input class="full-width" @bind="@UserProfile.Location"/>
            </label>
        </section>

        <section>
            <h2>@Loc[L.User_Pronouns]</h2>
            @foreach (var entry in Pronouns)
            {
                <div class="field pronouns-field">
                    <label>
                        @(LocaleHelper.Languages.GetValueOrDefault(entry.Language) ?? entry.Language.ToUpper())
                        <input class="full-width" placeholder="@Loc[L.User_Pronouns]" @bind="@entry.Value"/>
                    </label>
                    <button class="button" title="@Loc[L.Common_Remove]" @onclick="() => DeletePronouns(entry)">
                        <Icon Name="Icons.Trash"/>
                    </button>
                </div>
            }
            <div class="field">
                <InputSelect @bind-Value="@PronounsLanguage">
                    @foreach (var language in LocaleHelper.Languages.Where(l => !Pronouns.Select(p => p.Language).Contains(l.Key)))
                    {
                        <option value="@language.Key">@language.Value</option>
                    }
                </InputSelect>
                <button @onclick="AddPronouns" class="button" disabled="@(PronounsLanguage == "")">
                    <Icon Name="Icons.Plus"/>
                    @Loc[L.Common_Add]
                </button>
            </div>
        </section>

        <section>
            <h2>@Loc[L.Settings_Profile_Fields]</h2>
            <div class="fields">
                @foreach (var entry in UserProfile.Fields)
                {
                    <div class="field custom-field">
                        <input class="full-width" placeholder="@Loc[L.Common_Name]" @bind="@entry.Name" maxlength="@Limits.MaxProfileFieldNameLength"/>
                        <input class="full-width" placeholder="@Loc[L.Common_Value]" @bind="@entry.Value" maxlength="@Limits.MaxProfileFieldValueLength"/>
                        <button class="button" title="@Loc[L.Common_Remove]" @onclick="() => DeleteField(entry)">
                            <Icon Name="Icons.Trash"/>
                        </button>
                    </div>
                }
            </div>

            @if (UserProfile.Fields.Count < Limits.MaxProfileFields)
            {
                <button @onclick="AddField" class="button">
                    <Icon Name="Icons.Plus"/>
                    @Loc[L.Common_Add]
                </button>
            }
        </section>

        <div class="section">
            <h2>@Loc[L.Common_Other]</h2>
            <label>
                <input type="checkbox" @bind="@UserProfile.IsBot" @bind:after="AutomatedAccountToggle">
                @Loc[L.Settings_Profile_IsBot]
            </label>
            <label>
                <input type="checkbox" @bind="@UserProfile.IsCat">
                @Loc[L.Settings_Profile_IsCat]
            </label>
            <label>
                <input type="checkbox" @bind="@UserProfile.SpeakAsCat" disabled="@(!UserProfile.IsCat)">
                @Loc[L.Settings_Profile_SpeakAsCat]
            </label>
        </div>

        <div class="section">
            <StateButton OnClick="SaveChanges" ExtraClasses="button" @ref="SaveButton">
                <Initial>
                    <Icon Name="Icons.FloppyDisk"/>@Loc[L.StateButton_SaveChanges]
                </Initial>
                <Loading>
                    <LoadingSpinner />
                </Loading>
                <Failed>
                    <Icon Name="Icons.X"/>@Loc[L.StateButton_Error]
                </Failed>
                <Success>
                    <Icon Name="Icons.Check"/>@Loc[L.StateButton_Saved]
                </Success>
            </StateButton>
        </div>
    }
    @if (State is State.Loading)
    {
        <div class="loading"><LoadingSpinner Scale="2" /></div>
    }
</section>

<dialog closedby="none" class="modal" @ref="ImageDialog">
    @if (WaitingImg)
    {
        <LoadingSpinner Scale="1.5"/>
    }
    else
    {
        <div class="dialog-header">
            @switch (ImageState)
            {
                case ImageDialogState.UploadAvatar:
                    @Loc[L.Settings_Profile_UploadAvatar]
                    break;
                case ImageDialogState.EditAvatar:
                    @Loc[L.Settings_Profile_EditAvatar]
                    break;
                case ImageDialogState.UploadBanner:
                    @Loc[L.Settings_Profile_UploadBanner]
                    break;
                case ImageDialogState.EditBanner:
                    @Loc[L.Settings_Profile_EditBanner]
                    break;
                default:
                    break;
            }
        </div>
        @switch (ImageState)
        {
            case ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner:
                <InputFile class="input" OnChange="OnImageFileChange" accept="image/*"/>
                break;
            case ImageDialogState.EditAvatar when Avatar != null:
                <img class="avatar" src="@Avatar?.Url" alt="@Avatar?.Description" title="@Avatar?.Description"/>
                break;
            case ImageDialogState.EditBanner when Banner != null:
                <img class="banner" src="@Banner.Url" alt="@Banner.Description" title="@Banner.Description"/>
                break;
            default:
                break;
        }
        <textarea class="full-width alt-text" @bind="@ImageAlt" placeholder="@Loc[L.Common_AltText]" rows="5"></textarea>
        <div class="dialog-footer button-group">
            @if (ImageState is ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner)
            {
                <button @onclick="UploadImage" class="button primary-button" disabled="@(ImageState is ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner && ImageFile == null)">
                    @Loc[L.Dialog_Submit]
                </button>
            }
            else
            {
                <button @onclick="EditImage" class="button primary-button" disabled="@(ImageState is ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner && ImageFile == null)">
                    @Loc[L.Dialog_Submit]
                </button>
                <button @onclick="DeleteImage" class="button danger">
                    @Loc[L.Common_Delete]
                </button>
            }
            <button @onclick="() => Js.CloseDialogAsync(ImageDialog)" class="button">
                @Loc[L.Dialog_Cancel]
            </button>
        </div>
    }
</dialog>

@code {
    private UserProfileEntity UserProfile { get; set; } = null!;
    private State             State       { get; set; } = State.Loading;
    private StateButton       SaveButton  { get; set; } = null!;
    private ElementReference  ImageDialog { get; set; }
    private string            ImageAlt    { get; set; } = "";
    private IBrowserFile?     ImageFile   { get; set; }
    private ImageDialogState  ImageState  { get; set; }
    private bool              WaitingImg  { get; set; }
    private DateTime          Birthday    { get; set; } = DateTime.Now;
    private bool              SetBirthday { get; set; }
    private ElementReference  Description { get; set; }
    private ElementReference  EmojiButton { get; set; }

    private DriveFileResponse? Avatar { get; set; }
    private DriveFileResponse? Banner { get; set; }

    private List<UserPronouns> Pronouns         { get; set; } = [];
    private string             PronounsLanguage { get; set; } = "";

    private class UserPronouns
    {
        public required string Language { get; set; }
        public required string Value    { get; set; }
    }

    private enum ImageDialogState
    {
        UploadAvatar,
        EditAvatar,
        UploadBanner,
        EditBanner,
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserProfile = await Api.Profile.GetProfileAsync();
            if (UserProfile.Birthday != null)
            {
                Birthday    = DateTime.Parse(UserProfile.Birthday);
                SetBirthday = true;
            }

            if (UserProfile.Fields.Count == 0)
                AddField();

            State  = State.Loaded;

            Pronouns = UserProfile.Pronouns.Select(p => new UserPronouns { Language = p.Key, Value = p.Value }).ToList();

            Avatar = await Api.Profile.GetAvatarAsync();
            Banner = await Api.Profile.GetBannerAsync();

            UserProfile.AvatarAlt = Avatar?.Description;
            UserProfile.BannerAlt = Banner?.Description;
        }
        catch (ApiException e)
        {
            Logger.LogError($"Profile load failed: {e.Message}");
            State = State.Error;
        }
    }

    private void AddField()
    {
        UserProfile.Fields.Add(new UserProfileEntity.Field { Name = "", Value = "" });
    }

    private void DeleteField(UserProfileEntity.Field field)
    {
        UserProfile.Fields.Remove(field);
    }

    private void AddPronouns()
    {
        if (PronounsLanguage == "") return;
        Pronouns.Add(new UserPronouns { Language = PronounsLanguage, Value = "" });
        PronounsLanguage = "";
        Pronouns = Pronouns.OrderBy(p => p.Language).ToList();
    }

    private void DeletePronouns(UserPronouns pronouns)
    {
        Pronouns.Remove(pronouns);
    }

    private async Task SaveChanges()
    {
        try
        {
            SaveButton.State = StateButton.StateEnum.Loading;

            if (!SetBirthday)
                UserProfile.Birthday = null;
            else
                UserProfile.Birthday = Birthday.ToString("yyyy-MM-dd");

            UserProfile.Pronouns = Pronouns.Where(p => !string.IsNullOrWhiteSpace(p.Value)).ToDictionary(p => p.Language, p => p.Value.Trim());

            UserProfile.Fields.RemoveAll(p => string.IsNullOrWhiteSpace(p.Name) || string.IsNullOrWhiteSpace(p.Value));

            foreach (var field in UserProfile.Fields)
            {
                field.Name  = field.Name.Trim();
                field.Value = field.Value.Trim();
            }

            await Api.Profile.UpdateProfileAsync(UserProfile);
            await Session.UpdateCurrentUserAsync();
            StateHasChanged();

            SaveButton.State = StateButton.StateEnum.Success;
        }
        catch (ApiException e)
        {
            Logger.LogError($"Failed to update profile: {e.Message}");
            SaveButton.State = StateButton.StateEnum.Failed;
        }
    }

    private Task OpenUploadAvatarDialogAsync() =>
        OpenImageDialog(ImageDialogState.UploadAvatar, "");

    private Task OpenEditAvatarDialogAsync() =>
        OpenImageDialog(ImageDialogState.EditAvatar, Avatar?.Description ?? "");

    private Task OpenUploadBannerDialogAsync() =>
        OpenImageDialog(ImageDialogState.UploadBanner, "");

    private Task OpenEditBannerDialogAsync() =>
        OpenImageDialog(ImageDialogState.EditBanner, Banner?.Description ?? "");

    private async Task OpenImageDialog(ImageDialogState state, string alt)
    {
        ImageState = state;
        ImageFile  = null;
        ImageAlt   = alt;
        WaitingImg = false;

        await Js.ShowDialogAsync(ImageDialog);
    }

    private void OnImageFileChange(InputFileChangeEventArgs e)
    {
        ImageFile = e.GetMultipleFiles().First(p => p.ContentType.StartsWith("image/"));
        ImageAlt = "";
    }

    private async Task UploadImage()
    {
        if (ImageFile == null || ImageState is ImageDialogState.EditAvatar or ImageDialogState.EditBanner) return;

        WaitingImg = true;

        var alt = string.IsNullOrWhiteSpace(ImageAlt) ? null : ImageAlt.Trim();

        try
        {
            if (ImageState == ImageDialogState.UploadAvatar)
            {
                Avatar                = await Api.Profile.UpdateAvatarAsync(ImageFile, alt);
                UserProfile.AvatarAlt = alt;
            }
            else
            {
                Banner                = await Api.Profile.UpdateBannerAsync(ImageFile, alt);
                UserProfile.BannerAlt = alt;
            }
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }

        await Js.CloseDialogAsync(ImageDialog);

        WaitingImg = false;
        StateHasChanged();
    }

    private async Task EditImage()
    {
        if (ImageState is ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner) return;

        WaitingImg = true;

        var alt = string.IsNullOrWhiteSpace(ImageAlt) ? null : ImageAlt.Trim();

        try
        {
            // This isn't the most ideal solution but I don't think having a dedicated endpoint for this is better
            var profile = await Api.Profile.GetProfileAsync();

            if (ImageState == ImageDialogState.EditAvatar)
            {
                profile.AvatarAlt     = alt;
                Avatar?.Description   = alt;
                UserProfile.AvatarAlt = alt;
            }
            else
            {
                profile.BannerAlt     = alt;
                Banner?.Description   = alt;
                UserProfile.BannerAlt = alt;
            }

            await Api.Profile.UpdateProfileAsync(profile);
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }

        await Js.CloseDialogAsync(ImageDialog);

        WaitingImg = false;
        StateHasChanged();
    }

    private async Task DeleteImage()
    {
        if (ImageState is ImageDialogState.UploadAvatar or ImageDialogState.UploadBanner) return;

        WaitingImg = true;

        try
        {
            if (ImageState == ImageDialogState.EditAvatar)
            {
                await Api.Profile.DeleteAvatarAsync();
                Avatar                = null;
                UserProfile.AvatarAlt = null;
            }
            else
            {
                await Api.Profile.DeleteBannerAsync();
                Banner                = null;
                UserProfile.BannerAlt = null;
            }
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }

        await Js.CloseDialogAsync(ImageDialog);

        WaitingImg = false;
        StateHasChanged();
    }

    private async Task ToggleEmojiPicker()
    {
        await GlobalComponentSvc.EmojiPicker?.Open(EmojiButton, new EventCallback<EmojiPicker.SelectedEmoji>(this, AddEmoji))!;
    }

    private async Task AddEmoji(EmojiPicker.SelectedEmoji emoji)
    {
        var pos  = await Js.GetSelectionStartAsync(Description);
        var text = UserProfile.Description ?? "";
        var emojiString = emoji switch
        {
            EmojiPicker.SelectedEmojiResponse e => $":{e.Emoji.Name}: ",
            EmojiPicker.SelectedUnicodeEmoji e  => $"{e.Value} ",
            _                                   => throw new ArgumentOutOfRangeException(nameof(emoji)),
        };
        UserProfile.Description = text.Insert(pos, emojiString);
        StateHasChanged();
    }

    private async Task AutomatedAccountToggle()
    {
        if (UserProfile.IsBot)
        {
            await GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, AutomatedAccountCallback), Loc[L.Settings_Profile_IsBotWarning], Icons.Warning)!;
        }
    }

    private void AutomatedAccountCallback(bool confirmed) => UserProfile.IsBot = confirmed;
}

@page "/notes/{NoteId}/about"
@page "/{User}/about"
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.RegularExpressions
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Configuration
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize]
@inject ApiService                     Api;
@inject IJSRuntime                     Js;
@inject IStringLocalizer<Localization> Loc;
@inject NavigationManager              Nav;
@inject SessionService                 SessionSvc;

<HeadTitle Text="@Loc[L.Common_AboutPage]"/>

<SectionContent SectionName="top-bar">
    <Icon Name="Icons.Info"></Icon>
    @Loc[L.Common_AboutPage]
</SectionContent>

@if (State == State.Loaded)
{
    @foreach (var document in Documents)
    {
        <details>
            <summary>@document.Key</summary>
            <JsonViewer Element="document.Value.RootElement"/>
            <button @onclick="() => CopyToClipboard(document.Value)" class="btn">
                <Icon Name="Icons.Copy"/>
                @Loc[L.Common_CopyContents]
            </button>
        </details>
    }
}
@if (State == State.Loading)
{
    <HeadTitle Text="@Loc[L.StateButton_Loading]"/>

    <div class="loading"><LoadingSpinner Scale="2" /></div>
}
@if (State == State.Error)
{
    <HeadTitle Text="@Loc[L.StateButton_Error]"/>

    <div>Failure</div>
}

@code {
    [Parameter] public string?                          NoteId    { get; set; }
    [Parameter] public string?                          User      { get; set; }
    private            State                            State     { get; set; }
    private            Dictionary<string, JsonDocument> Documents { get; set; } = [];

    private async Task CopyToClipboard(JsonDocument document)
    {
        var options = new JsonSerializerOptions
        {
            Encoder       = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            WriteIndented = true
        };
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", JsonSerializer.Serialize(document.RootElement, options));
    }

    protected override async Task OnInitializedAsync()
    {
        if (NoteId != null)
        {
            var noteResponse = await Api.Notes.GetNoteAsync(NoteId);

            if (noteResponse == null)
            {
                Nav.NotFound();
                return;
            }

            Documents.Add(Loc["Note response"], JsonSerializer.SerializeToDocument(noteResponse, JsonSerialization.Options));
            
            if (SessionSvc.Current?.IsAdmin is true)
            {
                var activity = noteResponse.User.Host != null ? await Api.Admin.GetActivityAsync(noteResponse.Url, SessionSvc.Current.Id) : await Api.Admin.GetActivityByNoteIdAsync(noteResponse.Id);

                if (activity != null)
                    Documents.Add(Loc["Activity"], JsonSerializer.SerializeToDocument(activity));
            }

            State = State.Loaded;
        }
        else if (User != null)
        {
            var pattern      = "^@([^@]+)@?(.+)?$";
            var matches      = Regex.Match(User, pattern);
            var userResponse = await Api.Users.LookupUserAsync(matches.Groups[1].Value, matches.Groups[2].Value);

            if (userResponse is null)
            {
                Nav.NotFound();
                return;
            }

            var profileResponse = await Api.Users.GetUserProfileAsync(userResponse.Id);

            Documents.Add(Loc["User response"], JsonSerializer.SerializeToDocument(userResponse, JsonSerialization.Options));
            Documents.Add(Loc["Profile response"], JsonSerializer.SerializeToDocument(profileResponse, JsonSerialization.Options));

            if (SessionSvc.Current?.IsAdmin is true)
            {
                var activity = userResponse.Host != null && profileResponse?.Url != null ? await Api.Admin.GetActivityAsync(profileResponse.Url, SessionSvc.Current.Id) : await Api.Admin.GetActivityByUserIdAsync(userResponse.Id);

                if (activity != null)
                    Documents.Add(Loc["Activity"], JsonSerializer.SerializeToDocument(activity));
            }

            State = State.Loaded;
        }
        else
        {
            Nav.NotFound();
        }
    }
}
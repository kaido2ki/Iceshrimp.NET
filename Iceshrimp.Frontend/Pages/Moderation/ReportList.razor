@page "/mod/reports"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize(Roles = "moderator")]
@layout ModerationLayout
@inject ApiService                     Api;
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.Moderation_Reports]"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/mod">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.WarningCircle"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @Loc[L.Moderation_Reports]
</SectionContent>
<SectionContent SectionName="top-bar-actions">
    @if (State is State.Empty or State.Loaded)
    {
        <button class="action" @onclick="ToggleResolved">
            <Icon Name="@(Resolved ? Icons.XCircle : Icons.CheckCircle)"/>
            <span class="label">@Loc[Resolved ? L.Moderation_Reports_Unresolved : L.Moderation_Reports_Resolved]</span>
        </button>
    }
</SectionContent>

@if (State == State.Loaded)
{
    @foreach (var report in Reports)
    {
        <div class="card report">
            <div class="report-user">
                <NoteUserInfo User="report.TargetUser" Indented="false"/>
                <div class="report-details">
                    <Timestamp Date="report.CreatedAt"/>
                    @if (report.Resolved)
                    {
                        <span class="badge success">@Loc[L.Moderation_Reports_Resolved]</span>
                    }
                    else
                    {
                        <span class="badge danger">@Loc[L.Moderation_Reports_Unresolved]</span>
                    }
                </div>
            </div>
            <div>
                <MfmText Text="@Loc[L.Moderation_Reports_ByLabel, report.Reporter.DisplayName ?? report.Reporter.Username]"
                         Emoji="@report.Reporter.Emojis" Simple="true"/>
            </div>
            <span class="report-comment">@report.Comment</span>
            <div>
                @{
                    var attachments = new List<string>();
                    if (report is { Forwarded: true, TargetUser.Host: not null })
                        attachments.Add(Loc[L.Moderation_Reports_Forwarded_Host, report.TargetUser.Host]);
                    if (report.Notes.Length != 0)
                        attachments.Add(Loc[L.Moderation_Reports_NoteCount, report.Notes.Length]);
                    if (report.Rules.Length != 0)
                        attachments.Add(Loc[L.Moderation_Reports_RuleCount, report.Rules.Length]);

                    @string.Join(", ", attachments)
                }
            </div>
            <a href="/mod/reports/@report.Id">View details</a>
        </div>
    }

    <ScrollEnd IntersectionChange="LoadMore" ManualLoad="LoadMore"/>
}

@if (State == State.Empty)
{
    <i>@Loc[L.Moderation_Reports_Empty]</i>
}

@if (State == State.Loading)
{
    <div class="loading">
        <LoadingSpinner Scale="2"/>
    </div>
}

@code {
    private State                State    { get; set; } = State.Loading;
    private List<ReportResponse> Reports  { get; set; } = [];
    private string?              MaxId    { get; set; }
    private bool                 Resolved { get; set; }

    private async Task LoadReports()
    {
        State   = State.Loading;
        Reports = await Api.Moderation.GetReportsAsync(new PaginationQuery(), Resolved);
        State   = Reports.Count != 0 ? State.Loaded : State.Empty;
    }

    private async Task LoadMore()
    {
        MaxId = Reports.Last().Id;
        var res = await Api.Moderation.GetReportsAsync(new PaginationQuery { MaxId = MaxId });
        Reports.AddRange(res);
        StateHasChanged();
    }

    private async Task ToggleResolved()
    {
        Resolved = !Resolved;
        await LoadReports();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }
}
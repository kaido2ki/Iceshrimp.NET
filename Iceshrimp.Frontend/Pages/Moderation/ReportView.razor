@page "/mod/reports/{Id}"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@attribute [Authorize(Roles = "moderator")]
@layout ModerationLayout
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject IStringLocalizer<Localization> Loc;
@inject NavigationManager              Nav;
@inject SessionService                 Session;

<HeadTitle Text="@(Report != null ? Loc[L.Moderation_Report_From, Report.Reporter.DisplayName ?? Report.Reporter.Username] : Loc[L.Moderation_Reports])"/>
<SectionContent SectionName="top-bar-icon">
    <a class="action mobile-back" href="/mod/reports">
        <Icon Name="Icons.ArrowLeft"/>
    </a>
    <Icon Name="Icons.WarningCircle"/>
</SectionContent>
<SectionContent SectionName="top-bar">
    @if (Report != null)
    {
        <MfmText Text="@Loc[L.Moderation_Report_From, Report.Reporter.DisplayName ?? Report.Reporter.Username]"
                 Emoji="Report.Reporter.Emojis" Simple="true"/>
    }
    else
    {
        @Loc[L.Moderation_Reports]
    }
</SectionContent>

@if (State == State.Loaded && Report != null)
{
    <div class="card report">
        <div class="report-user">
            <NoteUserInfo User="Report.TargetUser" Indented="false"/>
            <div class="report-details">
                <Timestamp Date="Report.CreatedAt"/>
                @if (Report.Resolved)
                {
                    <span class="badge success">@Loc[L.Moderation_Reports_Resolved]</span>
                }
                else
                {
                    <span class="badge danger">@Loc[L.Moderation_Reports_Unresolved]</span>
                }
            </div>
        </div>

        @if (UserProfile != null)
        {
            <details>
                <summary>@Loc[L.User_Bio]</summary>
                <MfmText Text="@UserProfile.Bio" Emoji="@Report.TargetUser.Emojis"/>
            </details>

            @if (Report.TargetUser.Host != null)
            {
                <div class="field">
                    <span class="field-name">
                        @Loc[L.Moderation_Reports_InstanceName]
                    </span>
                    <span class="field-value">
                        @(Report.TargetUser.InstanceName != null ? Loc[L.Moderation_Reports_InstanceName_Host, Report.TargetUser.InstanceName, Report.TargetUser.Host] : Report.TargetUser.Host)
                    </span>
                </div>
            }
            <div class="field">
                <span class="field-name">
                    @Loc[L.Moderation_Reports_TargetCreatedAt]
                </span>
                <span class="field-value">
                    @UserProfile.CreatedAt.ToString("G")
                </span>
            </div>
            @if (UserProfile.ActiveAt != null)
            {
                <div class="field">
                    <span class="field-name">
                        @Loc[L.Moderation_Reports_TargetActiveAt]
                    </span>
                    <span class="field-value">
                        <Timestamp Date="@(UserProfile.ActiveAt ?? UserProfile.CreatedAt)"/>
                    </span>
                </div>
            }
            @if (UserProfile.Birthday != null)
            {
                <div class="field">
                    <span class="field-name">
                        @Loc[L.User_Birthday]
                    </span>
                    <span class="field-value">
                        @UserProfile.Birthday
                    </span>
                </div>
            }
            @if (UserProfile.Pronouns != null)
            {
                <div class="field">
                    <span class="field-name">
                        @Loc[L.User_Pronouns]
                    </span>
                    <span class="field-value">
                        @string.Join(", ", UserProfile.Pronouns.Select(p => $"{p.Value} ({LocaleHelper.Languages.GetValueOrDefault(p.Key) ?? p.Key.ToUpper()})"))
                    </span>
                </div>
            }
        }
        
        <h3>Report details</h3>
        <div class="report-user">
            <NoteUserInfo User="Report.Reporter" Indented="false"/>
            <div class="report-details">
                @if (Report.Reporter.Host != null)
                {
                    <span class="report-resolved">@Loc[L.Moderation_Reports_FromRemote, Report.Reporter.Host]</span>
                }
            </div>
        </div>
        <span class="report-comment">@Report.Comment</span>

        @if (Report.Rules.Length != 0)
        {
            <h3>@Loc[L.Report_Dialog_Rules]</h3>

            <ul class="rules">
                @foreach (var rule in Report.Rules)
                {
                    <li>
                        @rule.Text
                        @if (rule.Description != null)
                        {
                            <br>
                            <i>@rule.Description</i>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    @if (Report.Notes.Length != 0)
    {
        <div class="notes">
            @foreach (var note in Report.Notes)
            {
                <div class="note-container">
                    <NoteComponent Note="note" AsQuote="true" OpenNote="true"/>
                </div>
            }
        </div>
    }
    
    <div class="card report">
        <h3>@Loc[L.Moderation_Reports_Actions]</h3>
        @if (Report.TargetUser.IsSuspended)
        {
            <MfmText Text="@Loc[L.Moderation_Reports_TargetSuspended, Report.TargetUser.DisplayName ?? Report.TargetUser.Username]"
                     Emoji="Report.TargetUser.Emojis" Simple="true"/>
        }
        @if (Report.Resolved && Report.Assignee != null)
        {
            <MfmText Text="@Loc[L.Moderation_Reports_ResolvedBy_Username, Report.Assignee.DisplayName ?? Report.Assignee.Username]"
                     Emoji="Report.Assignee.Emojis" Simple="true"/>
        }
        <div class="button-group">
            @if (!Report.Resolved)
            {
                @if (Report.Reporter.Host == null && Report.TargetUser.Host != null && !Report.Forwarded)
                {
                    <span class="card-button" @onclick="Forward">
                        <Icon Name="Icons.PaperPlaneRight"/>
                        @Loc[L.Report_Dialog_Forward_Host, Report.TargetUser.Host]
                    </span>
                }
                <span class="card-button" @onclick="Resolve">
                    <Icon Name="Icons.CheckCircle"/>
                    @Loc[L.Moderation_Reports_MarkResolved]
                </span>
                <span class="card-button danger" @onclick="Suspend">
                    <Icon Name="Icons.Gavel"/>
                    @Loc[L.Moderation_Reports_SuspendTarget]
                </span>
            }
            <span class="card-button danger" @onclick="DeleteReport">
                <Icon Name="Icons.Trash"/>
                @Loc[L.Common_Delete]
            </span>
        </div>
    </div>
}

@if (State == State.Loading)
{
    <div class="loading">
        <LoadingSpinner Scale="2"/>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    private State                State       { get; set; }
    private ReportResponse?      Report      { get; set; }
    private UserProfileResponse? UserProfile { get; set; }

    private void Forward() =>
        Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, ForwardCallback), Loc[L.Moderation_Reports_ForwardDialog_Question], Icons.PaperPlaneRight);

    private async Task ForwardCallback(bool confirm)
    {
        if (!confirm || Id == null || Report == null) return;

        try
        {
            await Api.Moderation.ForwardReportAsync(Id);
            Report.Forwarded = true;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }
    
    private void Resolve() =>
        Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, ResolveCallback), Loc[L.Moderation_Reports_ResolveDialog_Question], Icons.CheckCircle);

    private async Task ResolveCallback(bool confirm)
    {
        if (!confirm || Id == null || Report == null) return;

        try
        {
            await Api.Moderation.ResolveReportAsync(Id);
            Report.Resolved = true;
            Report.Assignee = Session.Current;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }
    
    private void Suspend() =>
        Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, SuspendCallback), Loc[L.Moderation_Reports_SuspendDialog_Question, Report!.TargetUser.DisplayName ?? Report.TargetUser.Username], Icons.Gavel);

    private async Task SuspendCallback(bool confirm)
    {
        if (!confirm || Id == null || Report == null) return;

        try
        {
            await Api.Moderation.SuspendUserAsync(Report.TargetUser.Id);
            Report.TargetUser.IsSuspended = true;
            await ResolveCallback(true);
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void DeleteReport() =>
        Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, DeleteReportCallback), Loc[L.Moderation_Reports_DeleteDialog_Question]);

    private async Task DeleteReportCallback(bool confirm)
    {
        if (!confirm || Id == null || Report == null) return;

        try
        {
            await Api.Moderation.DeleteReportAsync(Id);
            Nav.NavigateTo("/mod/reports");
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Id == null)
        {
            Nav.NotFound();
            return;
        }

        State  = State.Loading;
        Report = await Api.Moderation.GetReportAsync(Id);

        if (Report != null)
        {
            UserProfile = await Api.Users.GetUserProfileAsync(Report.TargetUser.Id);
            State       = State.Loaded;
        }
        else
        {
            Nav.NotFound();
        }
    }
}
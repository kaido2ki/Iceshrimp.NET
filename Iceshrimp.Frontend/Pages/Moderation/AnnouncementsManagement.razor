@page "/mod/announcements"
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Localization
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.Extensions.Localization
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "moderator")]
@layout ModerationLayout
@inject ApiService                     Api;
@inject EmojiService                   EmojiSvc;
@inject GlobalComponentSvc             Global;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc["Manage announcements"]"/>

<SectionContent SectionName="top-bar">
    <Icon Name="Icons.Megaphone"></Icon>
    @Loc["Manage announcements"]
    @if (State is State.Empty or State.Loaded)
    {
        <span class="action btn" @onclick="NewAnnouncement">
            <Icon Name="Icons.Plus"/>
            <span>@Loc["New"]</span>
        </span>
    }
</SectionContent>

@if (State is State.Loaded)
{
    <div class="announcement-list">
        @foreach (var announcement in Announcements)
        {
            <AnnouncementEntry Announcement="announcement" Moderator="true" Edit="EditAnnouncement" Delete="DeleteAnnouncement"/>
        }
        @if (PaginationData is { Next: not null })
        {
            <ScrollEnd ManualLoad="FetchMore" IntersectionChange="FetchMore"></ScrollEnd>
        }
    </div>
}
@if (State is State.Empty)
{
    <i>@Loc["No announcements have been made"]</i>
}
@if (State is State.Loading)
{
    <div class="loading">
        <LoadingSpinner Scale="2"/>
    </div>
}

<dialog class="dialog" @ref="ComposeDialog">
    <div class="compose">
        <div class="header">
            <button class="btn" title="@Loc["Close"]" @onclick="CloseDialog" aria-label="close">
                <Icon Name="Icons.X"/>
            </button>
            <span>@Loc["Announcement"]</span>
            <StateButton OnClick="Send" @ref="SendButton" ExtraClasses="announce-btn" AriaLabel="aanounce"
                         Disabled="@(string.IsNullOrWhiteSpace(Draft.Title) || string.IsNullOrWhiteSpace(Draft.Text))">
                <Initial>
                    @Loc["Announce"]<Icon Name="Icons.PaperPlaneRight"/>
                </Initial>
                <Loading>
                    @Loc["Sending"]<LoadingSpinner />
                </Loading>
                <Success>
                    @Loc["Done"]<Icon Name="Icons.Check"/>
                </Success>
                <Failed>
                    @Loc["Retry"]<Icon Name="Icons.X"/>
                </Failed>
            </StateButton>
        </div>
        <input @bind="Draft.Title" @bind:event="oninput" class="input" placeholder="@Loc["Title"]" aria-label="title"
               autofocus="autofocus"/>
        <hr class="separator"/>
        <textarea @ref="Textarea" @bind="Draft.Text" @bind:event="oninput" class="textarea"
                  placeholder="@Loc["Announcement text"]" rows="5" cols="35" aria-label="announcement text"></textarea>
        <div class="footer">
            <div class="buttons">
                <button class="btn" title="@Loc["Upload image"]" @onclick="OpenUploadImage" aria-label="upload">
                    <Icon Name="Icons.Upload" Size="1.3rem"></Icon>
                </button>
                <div class="file-input">
                    <InputFile @ref="ImageInput" OnChange="UploadImage" accept="image/*">Upload!</InputFile>
                </div>
                @if (Draft.ImageUrl != null)
                {
                    <button class="btn" title="@Loc["Remove image"]" @onclick="() => Draft.ImageUrl = null" aria-label="upload">
                        <Icon Name="Icons.Trash" Size="1.3rem"></Icon>
                    </button>
                }
                <button @ref="EmojiButton" class="btn" title="@Loc["Emoji"]" @onclick="ToggleEmojiPicker"
                        aria-label="emoji">
                    <Icon Name="Icons.Smiley" Size="1.3rem"></Icon>
                </button>
                <label>
                    <input type="checkbox" @bind="Draft.ShowPopup">
                    @Loc["Show popup"]
                </label>
            </div>
            <div class="buttons">
                <button class="btn" title="@Loc["Preview"]" @onclick="() => Preview = !Preview"
                        aria-label="preview">
                    <Icon Name="Icons.Binoculars" Size="1.3rem"></Icon>
                </button>
            </div>
        </div>
        @if (Preview)
        {
            <div class="preview">
                @if (string.IsNullOrWhiteSpace(Draft.Text))
                {
                    <span>@Loc["Nothing to preview"]</span>
                }
                else
                {
                    <MfmText Text="@Draft.Text.ReplaceLineEndings("\n")" Emoji="@EmojiList"/>
                }
            </div>
        }
        @if (Draft.ImageUrl != null)
        {
            <img src="@Draft.ImageUrl" alt="@Loc["Attachment image"]"/>
        }
        <div @onclick="CloseDialog" class="backdrop"></div>
    </div>
</dialog>

@code {
    private          State                          State          { get; set; }
    private          ElementReference               ComposeDialog  { get; set; }
    private          ElementReference               Textarea       { get; set; }
    private          ElementReference               EmojiButton    { get; set; }
    private          InputFile                      ImageInput     { get; set; } = null!;
    private          StateButton                    SendButton     { get; set; } = null!;
    private          PaginationData?                PaginationData { get; set; }
    private          List<AnnouncementResponse>     Announcements  { get; set; } = [];
    private          List<EmojiResponse>            EmojiList      { get; set; } = [];
    private          AnnouncementRequest            Draft          { get; set; }
    private          string?                        Editing        { get; set; }
    private          bool                           Preview        { get; set; }

    public AnnouncementsManagement()
    {
        Draft = new AnnouncementRequest { Title = "", Text = "", ImageUrl = null, ShowPopup = true };
    }

    private async Task NewAnnouncement()
    {
        Draft            = new AnnouncementRequest { Title = "", Text = "", ImageUrl = null, ShowPopup = true };
        Editing          = null;
        SendButton.State = StateButton.StateEnum.Initial;

        if (EmojiList.Count == 0)
            EmojiList = await EmojiSvc.GetEmojiAsync();

        await Js.ShowDialogAsync(ComposeDialog, false);
    }

    private async Task EditAnnouncement(string id)
    {
        var existing = Announcements.FirstOrDefault(p => p.Id == id);
        if (existing == null) return;

        Draft            = new AnnouncementRequest { Title = existing.Title, Text = existing.Text, ImageUrl = existing.ImageUrl, ShowPopup = existing.ShowPopup };
        Editing          = id;
        SendButton.State = StateButton.StateEnum.Initial;

        if (EmojiList.Count == 0)
            EmojiList = await EmojiSvc.GetEmojiAsync();

        await Js.ShowDialogAsync(ComposeDialog);
    }

    private async Task CloseDialog()
    {
        await Js.CloseDialogAsync(ComposeDialog);
    }

    private async Task Send()
    {
        if (SendButton.State == StateButton.StateEnum.Loading) return;

        SendButton.State = StateButton.StateEnum.Loading;

        var res = Editing != null ? await Api.Announcements.EditAnnouncementAsync(Editing, Draft) : await Api.Announcements.CreateAnnouncementAsync(Draft);

        if (Editing != null)
        {
            var i = Announcements.FindIndex(p => p.Id == Editing);
            Announcements[i] = res;
        }
        else
        {
            await Api.Announcements.ReadAnnouncementAsync(res.Id);
            res.Read      = true;
            res.ReadCount = 1;
            Announcements.Insert(0, res);
        }

        SendButton.State = StateButton.StateEnum.Success;
        await CloseDialog();
    }

    private async Task DeleteAnnouncement(string id)
    {
        await Api.Announcements.DeleteAnnouncementAsync(id);

        Announcements.RemoveAll(p => p.Id == id);
    }

    private async Task OpenUploadImage()
    {
        if (ImageInput.Element is not { } element) return;
        await Js.ClickElementAsync(element);
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        if (!e.File.ContentType.StartsWith("image/")) return;

        try {
            var res = await Api.Drive.UploadFileAsync(e.File);
            Draft.ImageUrl = res.Url;
            StateHasChanged();
        }
        catch (IOException exception)
        {
            await Global.NoticeDialog?.Display(exception.Message, NoticeDialog.NoticeType.Error)!;
        }
    }

    private async Task ToggleEmojiPicker()
    {
        await Global.EmojiPicker?.Open(EmojiButton, new EventCallback<EmojiResponse>(this, AddEmoji))!;
    }

    private async Task AddEmoji(EmojiResponse emoji)
    {
        var pos         = await Js.GetSelectionStartAsync(Textarea);
        var text        = Draft.Text;
        var emojiString = $":{emoji.Name}: ";
        Draft.Text = text.Insert(pos, emojiString);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        State = State.Loading;

        try
        {
            var res = await Api.Announcements.GetAnnouncementsAsync(false, new PaginationQuery());
            PaginationData = res.Links;
            Announcements  = res.Data;
        }
        catch (ApiException)
        {
            State = State.Error;
            return;
        }

        State = Announcements.Count != 0 ? State.Loaded : State.Empty;
    }

    private async Task FetchMore()
    {
        try
        {
            var res = await Api.Announcements.GetAnnouncementsAsync(false, new PaginationQuery { MaxId = PaginationData?.Next?.Split('=')[1] });
            PaginationData = res.Links;
            Announcements.AddRange(res.Data);
        }
        catch (ApiException)
        {
            PaginationData!.Next = null;
        }
    }
}
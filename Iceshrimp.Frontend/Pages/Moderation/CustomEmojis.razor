@page "/mod/emojis"
@using Iceshrimp.Frontend.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Frontend.Components
@attribute [Authorize(Roles = "moderator")]
@layout ModerationLayout
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;

<HeadTitle Text="@Loc[L.Moderation_Emojis]"/>

<SectionContent SectionName="top-bar">
    <Icon Name="Icons.Smiley"></Icon>
    @Loc[L.Moderation_Emojis]
    @if (State is State.Empty or State.Loaded)
    {
        @if (BatchSelection)
        {
            <span class="action btn" @onclick="BatchSetCategory" disabled="@(Selected.Count == 0)">
                <Icon Name="Icons.Folder"/>
                <span>@Loc[L.Moderation_Emojis_SetCategory]</span>
            </span>
            <span class="action btn" @onclick="BatchSetLicense" disabled="@(Selected.Count == 0)">
                <Icon Name="Icons.Article"/>
                <span>@Loc[L.Moderation_Emojis_SetLicense]</span>
            </span>
            <span class="action btn" @onclick="BatchDelete" disabled="@(Selected.Count == 0)">
                <Icon Name="Icons.Trash"/>
                <span>@Loc[L.Common_Delete]</span>
            </span>
            <span class="action btn" @onclick="ToggleBatchSelection">
                <Icon Name="Icons.Selection"/>
                <span>@Loc[L.Moderation_Emojis_Select_Single]</span>
            </span>
        }
        else
        {
            <span class="action btn" @onclick="OpenUpload">
                <Icon Name="Icons.Upload"/>
                <span>@Loc[L.Drive_UploadFile]</span>
            </span>
            <span class="action btn" @onclick="OpenImport">
                <Icon Name="Icons.FileArrowUp"/>
                <span>@Loc[L.Moderation_Emojis_ImportPack]</span>
            </span>
            <span class="action btn" @onclick="ToggleBatchSelection">
                <Icon Name="Icons.SelectionPlus"/>
                <span>@Loc[L.Moderation_Emojis_Select_Multiple]</span>
            </span>
        }
    }
    @if (State is not State.Loading && !BatchSelection)
    {
        <a class="action btn" href="/mod/emojis/remote">
            <Icon Name="Icons.ArrowSquareOut"/>
            <span>@Loc[L.Timeline_Remote]</span>
        </a>
    }
</SectionContent>

@if (State is State.Empty or State.Error or State.Loaded)
{
    <div class="emoji-search">
        <input @bind="EmojiFilter" class="search" type="text" placeholder="@Loc[L.Common_Name]" aria-label="search name"/>
        <button @onclick="FilterEmojis" class="button">@Loc[L.Search]</button>
    </div>
}
@if (State is State.Loaded)
{
    @foreach (var category in Categories)
    {
        <span class="category-name">
            @if (category.Category == null)
            {
                <Icon Name="Icons.Question"/>
            }
            @(category.Category ?? Loc[L.Moderation_Emojis_Uncategorized])
        </span>
        <div class="emoji-list">
            @foreach (var emoji in category.Emojis)
            {
                <EmojiManagementEntry Emoji="@emoji" DeleteEmoji="DeleteEmoji"
                                          FilterEmojis="FilterEmojis" ToggleEmoji="SelectEmoji" BatchSelection="BatchSelection"
                                          Selected="@(Selected.Contains(emoji))"/>
            }
        </div>
    }
}
@if (State is State.Empty || (State is State.Loaded && Categories.Count == 0))
{
    @Loc[L.Moderation_Emojis_Empty]
}
@if (State is State.Loading)
{
    <div class="loading">
        <LoadingSpinner Scale="2"/>
    </div>
}

<div class="file-input">
    <InputFile @ref="UploadInput" OnChange="Upload" accept="image/*">Upload</InputFile>
    <InputFile @ref="ImportInput" OnChange="Import" accept=".zip">Import</InputFile>
</div>

@code {
    private List<EmojiResponse>                                  Emojis         { get; set; } = [];
    private List<(string? Category, List<EmojiResponse> Emojis)> Categories     { get; set; } = new();
    private string                                               EmojiFilter    { get; set; } = "";
    private State                                                State          { get; set; }
    private InputFile                                            UploadInput    { get; set; } = null!;
    private IBrowserFile                                         UploadFile     { get; set; } = null!;
    private InputFile                                            ImportInput    { get; set; } = null!;
    private IBrowserFile                                         ImportFile     { get; set; } = null!;
    private bool                                                 BatchSelection { get; set; }
    private List<EmojiResponse>                                  Selected       { get; set; } = [];

    private void FilterEmojis()
    {
        Categories = Emojis
                     .Where(p => p.Name.Contains(EmojiFilter.Trim()) || p.Tags.Count(a => a.Contains(EmojiFilter.Trim())) != 0)
                     .OrderBy(p => p.Name)
                     .ThenBy(p => p.Id)
                     .GroupBy(p => p.Category)
                     .OrderBy(p => p.Key != null)
                     .ThenBy(p => p.Key)
                     .Select(p => (p.Key, p.ToList()))
                     .ToList();
        StateHasChanged();
    }

    private void SelectEmoji(EmojiResponse emoji)
    {
        if (!BatchSelection) return;

        if (Selected.Contains(emoji))
        {
            Selected.Remove(emoji);
        }
        else
        {
            Selected.Add(emoji);
        }

        StateHasChanged();
    }

    private async Task GetEmojis()
    {
        State = State.Loading;

        Emojis = await Api.Emoji.GetAllEmojiAsync();

        if (Emojis.Count == 0)
        {
            State = State.Empty;
        }
        else
        {
            FilterEmojis();
            State = State.Loaded;
        }
    }

    private void DeleteEmoji(EmojiResponse emoji)
    {
        Selected.Remove(emoji);
        Emojis.Remove(emoji);
    }

    // The <InputFile> Component is hidden, and triggered by a sepperate button.
    // That way we get it's functionality, without the styling limitations of the InputFile component
    private async Task OpenUpload()
    {
        if (UploadInput.Element is not { } element) return;
        await Js.ClickElementAsync(element);
    }

    private async Task OpenImport()
    {
        if (ImportInput.Element is not { } element) return;
        await Js.ClickElementAsync(element);
    }

    private void ToggleBatchSelection()
    {
        BatchSelection = !BatchSelection;
        if (!BatchSelection) Selected.Clear();
        StateHasChanged();
    }

    private async Task BatchSetCategory()
    {
        if (!BatchSelection || Selected.Count == 0) return;
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, BatchSetCategoryCallback), Loc[L.Moderation_Emojis_MultiCategoryDialog_Text, Selected.Count], "", null, true)!;
    }

    private async Task BatchSetCategoryCallback(string? category)
    {
        if (category == null) return;

        try
        {
            var res = await Api.Emoji.BatchUpdateEmojiAsync(new BatchUpdateEmojiRequest { Ids = Selected.Select(p => p.Id).ToList(), Category = category });

            foreach (var emoji in res)
            {
                var e = Emojis.First(p => p.Id == emoji.Id);
                e.Category = emoji.Category;
            }

            FilterEmojis();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task BatchSetLicense()
    {
        if (!BatchSelection || Selected.Count == 0) return;
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, BatchSetLicenseCallback), Loc[L.Moderation_Emojis_MultiLicenseDialog_Text, Selected.Count], "", null, true, true)!;
    }

    private async Task BatchSetLicenseCallback(string? license)
    {
        if (license == null) return;

        try
        {
            var res = await Api.Emoji.BatchUpdateEmojiAsync(new BatchUpdateEmojiRequest { Ids = Selected.Select(p => p.Id).ToList(), License = license });

            foreach (var emoji in res)
            {
                var e = Emojis.First(p => p.Id == emoji.Id);
                e.License = emoji.License;
            }

            StateHasChanged();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task BatchDelete()
    {
        if (!BatchSelection || Selected.Count == 0) return;
        await Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, BatchDeleteCallback), Loc[L.Moderation_Emojis_MultiDeleteDialog_Question, Selected.Count], Icons.Trash, Loc[L.Common_Delete])!;
    }

    private async Task BatchDeleteCallback(bool delete)
    {
        if (!delete) return;
        try
        {
            foreach (var emoji in Selected)
            {
                var res = await Api.Emoji.DeleteEmojiAsync(emoji.Id);
                if (res) DeleteEmoji(emoji);
            }

            FilterEmojis();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        if (!e.File.ContentType.StartsWith("image/")) return;
        UploadFile = e.File;
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, UploadCallback), Loc[L.Moderation_Emojis_UploadDialog_Prompt], "", e.File.Name.Split(".")[0])!;
    }

    private async Task UploadCallback(string? name)
    {
        if (name == null) return;

        try
        {
            await Api.Emoji.UploadEmojiAsync(UploadFile, name);
            await Global.NoticeDialog?.Display(Loc[L.Moderation_Emojis_UploadDialog_SuccessNotice, name])!;
            await GetEmojis();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        if (e.File.ContentType != "application/zip") return;
        ImportFile = e.File;
        await Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, ImportCallback), Loc[L.Moderation_Emojis_ImportDialog_Question, e.File.Name], Icons.FileArrowUp)!;
    }

    private async Task ImportCallback(bool import)
    {
        if (!import) return;

        try
        {
            await Api.Emoji.ImportEmojiAsync(ImportFile);
            await Global.NoticeDialog?.Display(Loc[L.Moderation_Emojis_ImportDialog_SuccessNotice])!;
            await GetEmojis();
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetEmojis();
    }
}

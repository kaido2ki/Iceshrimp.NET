@using System.Diagnostics.CodeAnalysis
@using Iceshrimp.Assets.PhosphorIcons
@* ReSharper disable once RedundantUsingDirective *@
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Frontend.Localization
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.Extensions.Localization
@using Iceshrimp.Frontend.Core.Services.StateServicePatterns
@inject IStringLocalizer<Localization> Loc;
@inject ApiService                     Api;
@inject NavigationManager              Navigation;
@inject StateService                   StateService;
@inject IJSRuntime                     Js;

<form class="search" @onsubmit="Search" role="search">
    <section class="fields">
        <input @bind="SearchString" class="input" aria-label=""/>
        <InputSelect @bind-Value="@SearchType">
            @foreach (var type in Enum.GetValues(typeof(SearchTypeEnum)))
            {
                <option value="@type">@type</option>
            }
        </InputSelect>
        <button class="button"><Icon Name="Icons.MagnifyingGlass"/>@Loc["Search"]</button>
    </section>

    @if (SearchType == SearchTypeEnum.Note)
    {
        <details class="search-filters">
            <summary>@Loc["Advanced search"]</summary>
            <div class="filter-groups">
                <section>
                    <span>@Loc["Note in"] (<code>in:</code>)</span>
                    <label>
                        <input @bind="FilterInBookmarks" type="checkbox"/>
                        @Loc["Bookmarks"]
                    </label>
                    <label>
                        <input @bind="FilterInLikes" type="checkbox"/>
                        @Loc["Likes"]
                    </label>
                    <label>
                        <input @bind="FilterInReactions" type="checkbox"/>
                        @Loc["Reactions"]
                    </label>
                    <label>
                        <input @bind="FilterInInteractions" type="checkbox"/>
                        @Loc["Interactions"]
                    </label>
                    <span class="subgroup">@Loc["Note has"] (<code>has:</code>)</span>
                    <label>
                        <input @bind="FilterHasFile" type="checkbox"/>
                        @Loc["File"]
                    </label>
                    <label>
                        <input @bind="FilterHasMedia" type="checkbox"/>
                        @Loc["Media"]
                    </label>
                    <label>
                        <input @bind="FilterHasAudio" type="checkbox"/>
                        @Loc["Audio"]
                    </label>
                    <label>
                        <input @bind="FilterHasImage" type="checkbox"/>
                        @Loc["Image"]
                    </label>
                    <label>
                        <input @bind="FilterHasVideo" type="checkbox"/>
                        @Loc["Video"]
                    </label>
                    <label>
                        <input @bind="FilterHasPoll" type="checkbox"/>
                        @Loc["Poll"]
                    </label>
                </section>
                <section>
                    <label for="filter-from">@Loc["From user"] (<code>from:</code>)</label>
                    <input @bind="FilterFrom" type="text" class="input" id="filter-from" placeholder="user | user@@example.org"/>
                    <label for="filter-instance">@Loc["From instance"] (<code>instance:</code>)</label>
                    <input @bind="FilterInstance" type="text" class="input" id="filter-instance"
                           placeholder="local | example.org"/>
                    <label for="filter-mentions">@Loc["Mentions"] (<code>mentions:</code>)</label>
                    <input @bind="FilterMentions" type="text" class="input" id="filter-mentions"
                           placeholder="user | user@@example.org"/>
                    <label for="filter-reply">@Loc["Replying to"] (<code>reply:</code>)</label>
                    <input @bind="FilterReply" type="text" class="input" id="filter-reply" placeholder="user | user@@example.org"/>
                </section>
                <section>
                    <label for="filter-before">@Loc["Posted before - inclusive"] (<code>before:</code>)</label>
                    <input @bind="FilterBefore" type="text" class="input" id="filter-before" placeholder="YYYY-MM-DD"/>
                    <label for="filter-after">@Loc["Posted after - exclusive"] (<code>after:</code>)</label>
                    <input @bind="FilterAfter" type="text" class="input" id="filter-after" placeholder="YYYY-MM-DD"/>
                    <a class="subgroup" href="https://iceshrimp.net/help/fts" target="_blank">@Loc["More search filters"]</a>
                </section>
            </div>
        </details>
    }
</form>

@if (_resultType == ResultType.Notes)
{
    <div class="note-results">
        @if (NoteSearchInstance?.NoteResponses != null)
        {
            foreach (var note in NoteSearchInstance?.NoteResponses!)
            {
                <div class="wrapper">
                    <div @onclick="() => OpenNote(note.Id)" class="note-container">
                        <Note NoteResponse="note" OpenNote="false"/>
                    </div>
                </div>
            }

            <div class="end">
                <ScrollEnd ManualLoad="NoteSearchInstance.FetchOlder" IntersectionChange="async () => { if (!NoteSearchInstance.SearchComplete) { await NoteSearchInstance.FetchOlder(); } }"/>
            </div>
        }
    </div>
}
@if (_resultType == ResultType.Users)
{
    <div class="user-results">
        @if (UserSearchInstance?.UserResponses != null)
        {
            foreach (var user in UserSearchInstance?.UserResponses!)
            {
                <div @onclick="() => OpenProfile(user)" class="wrapper">
                    <UserProfileCard User="user"/>
                </div>
            }

            <div class="end">
                <ScrollEnd ManualLoad="UserSearchInstance.FetchOlder" IntersectionChange="async () => { if (!UserSearchInstance.SearchComplete) { await UserSearchInstance.FetchOlder(); } }"/>
            </div>
        }
    </div>
}

@code {
    private string                      SearchString       { get; set; } = "";
    private string                      SearchFilters      { get; set; } = "";
    private SearchTypeEnum              SearchType         { get; set; } = SearchTypeEnum.Note;
    private NoteSearch?                 NoteSearchInstance { get; set; }
    private UserSearch?                 UserSearchInstance { get; set; }
    private IJSInProcessObjectReference Module             { get; set; } = null!;
    private ResultType                  _resultType;
    private bool                        _setScroll;
    private float                       _scrollTop;

    private string FilterFrom           { get; set; } = "";
    private string FilterInstance       { get; set; } = "";
    private string FilterMentions       { get; set; } = "";
    private string FilterReply          { get; set; } = "";
    private bool   FilterInBookmarks    { get; set; }
    private bool   FilterInLikes        { get; set; }
    private bool   FilterInReactions    { get; set; }
    private bool   FilterInInteractions { get; set; }
    private bool   FilterHasFile        { get; set; }
    private bool   FilterHasMedia       { get; set; }
    private bool   FilterHasAudio       { get; set; }
    private bool   FilterHasImage       { get; set; }
    private bool   FilterHasVideo       { get; set; }
    private bool   FilterHasPoll        { get; set; }
    private string FilterBefore         { get; set; } = "";
    private string FilterAfter          { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        Module = (IJSInProcessObjectReference)await Js.InvokeAsync<IJSObjectReference>("import", "/Components/SearchComponent.razor.js");
        var state = StateService.Search.GetState();
        if (state != null)
        {
            NoteSearchInstance = new NoteSearch(state.SearchString + state.SearchFilters, Api, state.SearchResults);
            _resultType        = ResultType.Notes;
            _scrollTop         = state.ScrollTop;
            _setScroll         = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_setScroll)
        {
            SetScrollY(_scrollTop);
            _setScroll = false;
        }
    }

    private void SetFilters()
    {
        if (SearchType == SearchTypeEnum.User)
        {
            SearchFilters = "";
            return;
        }

        var filters = new List<string>();
        
        if (!string.IsNullOrWhiteSpace(FilterFrom))
            filters.Add("from:" + FilterFrom.Trim().TrimStart('@'));
        if (!string.IsNullOrWhiteSpace(FilterInstance) && (FilterInstance.Equals("instance", StringComparison.InvariantCultureIgnoreCase) || FilterInstance.Contains('.')))
            filters.Add("instance:" + FilterInstance.Trim().ToLowerInvariant());
        if (!string.IsNullOrWhiteSpace(FilterReply))
            filters.Add("reply:" + FilterReply.Trim().TrimStart('@'));
        foreach (var mention in FilterMentions.Split([' ', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            filters.Add("mentions:" + mention.TrimStart('@'));
        if (FilterInBookmarks) filters.Add("in:bookmarks");
        if (FilterInLikes) filters.Add("in:likes");
        if (FilterInReactions) filters.Add("in:reactions");
        if (FilterInInteractions) filters.Add("in:interactions");
        if (FilterHasFile) filters.Add("has:file");
        if (FilterHasMedia) filters.Add("has:media");
        if (FilterHasAudio) filters.Add("has:audio");
        if (FilterHasImage) filters.Add("has:image");
        if (FilterHasVideo) filters.Add("has:video");
        if (FilterHasPoll) filters.Add("has:poll");
        if (DateOnly.TryParseExact(FilterBefore, "O", out var filterBefore))
            filters.Add("before:" + filterBefore.ToString("O"));
        if (DateOnly.TryParseExact(FilterAfter, "O", out var filterAfter))
            filters.Add("after:" + filterAfter.ToString("O"));

        SearchFilters =  filters.Count != 0 ? " " : "";
        SearchFilters += string.Join(' ', filters);
    }

    private async Task Search()
    {
        SetFilters();
        if (string.IsNullOrWhiteSpace(SearchString) && string.IsNullOrWhiteSpace(SearchFilters)) return;

        NoteSearchInstance = null;
        _resultType        = ResultType.None;
        StateHasChanged();
        try
        {
            var lookup = await Api.Search.LookupAsync(SearchString + SearchFilters);
            if (lookup is not null && lookup.TargetUrl.Contains("user"))
            {
                var user = await Api.Users.GetUserAsync(lookup.TargetUrl.Split("users/")[1]);
                if (user is not null)
                {
                    var username                    = $"@{user.Username}";
                    if (user.Host != null) username += $"@{user.Host}";
                    Navigation.NavigateTo($"/{username}");
                }
            }
            else if (lookup is not null && lookup.TargetUrl.Contains("notes"))
            {
                Navigation.NavigateTo(lookup.TargetUrl);
            }
        }
        catch (ApiException)
        {
            if (SearchType == SearchTypeEnum.Note)
            {
                var searchRes = await Api.Search.SearchNotesAsync(SearchString + SearchFilters, new PaginationQuery { Limit = 20 });
                if (searchRes.Count > 0)
                {
                    NoteSearchInstance = new NoteSearch(searchString: SearchString + SearchFilters, api: Api, noteResponses: searchRes);
                    _resultType        = ResultType.Notes;
                    StateHasChanged();
                }
            }

            if (SearchType == SearchTypeEnum.User)
            {
                var searchRes = await Api.Search.SearchUsersAsync(SearchString, new PaginationQuery() { Limit = 20 });
                if (searchRes.Count > 0)
                {
                    UserSearchInstance = new UserSearch(searchString: SearchString, api: Api, userResponses: searchRes);
                    _resultType        = ResultType.Users;
                    StateHasChanged();
                }
            }
        }
    }

    private void OpenNote(string id)
    {
        StateService.Search.SetState(new SearchState { SearchResults = NoteSearchInstance!.NoteResponses, ScrollTop = GetScrollY(), SearchString = NoteSearchInstance!.SearchString, SearchFilters = SearchFilters });
        Navigation.NavigateTo($"/notes/{id}");
    }

    private void OpenProfile(UserResponse user)
    {
        var username                    = $"@{user.Username}";
        if (user.Host != null) username += $"@{user.Host}";
        Navigation.NavigateTo($"/{username}");
    }

    private float GetScrollY()
    {
        return Module.Invoke<float>("GetScrollY");
    }

    private void SetScrollY(float scrollTop)
    {
        Module.InvokeVoid("SetScrollY", scrollTop);
    }

    private enum ResultType
    {
        Notes,
        Users,
        None
    }

    private enum SearchTypeEnum
    {
        Note,
        User
    }

    [method: SetsRequiredMembers]
    private class UserSearch(string searchString, ApiService api, List<UserResponse> userResponses)
    {
        internal required string             MinId        = userResponses.Last().Id;
        internal required string             SearchString = searchString;
        internal required ApiService         Api          = api;
        public required   List<UserResponse> UserResponses { get; init; } = userResponses;
        public            bool               SearchComplete;

        public async Task FetchOlder()
        {
            var pq  = new PaginationQuery { Limit = 15, MaxId = MinId };
            var res = await Api.Search.SearchUsersAsync(SearchString, pq);
            switch (res.Count)
            {
                case > 0:
                    MinId = res.Last().Id;
                    UserResponses.AddRange(res);
                    break;
                case 0:
                    SearchComplete = true;
                    break;
            }
        }
    }

    [method: SetsRequiredMembers]
    private class NoteSearch(string searchString, ApiService api, List<NoteResponse> noteResponses)
    {
        internal required string             MinId        = noteResponses.Last().Id;
        public required   string             SearchString = searchString;
        internal required ApiService         Api          = api;
        public required   List<NoteResponse> NoteResponses { get; init; } = noteResponses;
        public            bool               SearchComplete;

        public async Task FetchOlder()
        {
            var pq  = new PaginationQuery { Limit = 15, MaxId = MinId };
            var res = await Api.Search.SearchNotesAsync(SearchString, pq);
            switch (res.Count)
            {
                case > 0:
                    MinId = res.Last().Id;
                    NoteResponses.AddRange(res);
                    break;
                case 0:
                    SearchComplete = true;
                    break;
            }
        }
    }
}

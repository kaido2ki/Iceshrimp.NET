@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Frontend.Core.Services.NoteStore
@using Iceshrimp.MfmSharp
@using Iceshrimp.Shared.Schemas.Web
@inject IJSRuntime                     Js
@inject JsService                      JsSvc
@inject ApiService                     ApiService
@inject ComposeService                 ComposeService
@inject EmojiService                   EmojiService
@inject SessionService                 SessionService
@inject MetadataService                MetadataService
@inject IStringLocalizer<Localization> Loc;
@inject GlobalComponentSvc             GlobalComponentSvc
@inject SettingsService                Settings;
@inject NoteActions                    NoteActions;
<dialog @onkeydown="HandleKeyDown" class="dialog" @ref="Dialog">
    <div class="compose">
        <div class="header">
            <button class="btn" title="@Loc[L.Common_Close]" @onclick="CloseDialog" aria-label="close" disabled="@(SendLock || UploadingFiles != 0)">
                <Icon Name="Icons.X"/>
            </button>
            @if (string.IsNullOrEmpty(NoteId))
            {
                <Dropdown TBind="NoteVisibility" Elements="@DropDownCreate()" @bind-Value="NoteDraft.Visibility"/>
            }
            <StateButton OnClick="SendNote" @ref="SendButton" ExtraClasses="post-btn" AriaLabel="post"
                         Disabled="@SendingDisabled()">
                <Initial>
                    @if(string.IsNullOrEmpty(NoteId))
                    {
                        @Loc[L.Compose_PublishNote]
                        <Icon Name="Icons.PaperPlaneRight"/>
                    }
                    else
                    {
                        @Loc[L.Compose_SaveEdit]
                        <Icon Name="Icons.Pencil"/>
                    }
                </Initial>
                <Loading>
                    @Loc[L.Compose_Sending]<LoadingSpinner />
                </Loading>
                <Success>
                    @Loc[L.Dialog_Confirm]<Icon Name="Icons.Check"/>
                </Success>
                <Failed>
                    @Loc[L.StateButton_Error]<Icon Name="Icons.X"/>
                </Failed>
            </StateButton>
        </div>
        @if (ReplyOrQuote != null && !Preview)
        {
            <div class="reply-or-quote">
                <NoteComponent Note="ReplyOrQuote" AsQuote="true" OpenNote="false"/>
            </div>
        }
        @if (NoteDraft.Cw != null)
        {
            <input @bind="NoteDraft.Cw" @bind:event="oninput" class="input cw-field" placeholder="Content Warning"
                   aria-label="content warning"/>
            <hr class="separator"/>
        }
        <textarea @ref="Textarea" @bind="NoteDraft.Text" @bind:event="oninput" class="textarea"
                  placeholder="@Loc[TextPlaceholder ?? L.Compose_BodyPlaceholder_Note]" rows="5"
                  cols="35" autofocus="autofocus" aria-label="note text" data-quote="@((NoteDraft.RenoteId != null || AttachedQuote != null).ToString())"></textarea>
        <div class="footer">
            <div class="buttons">
                <button class="btn" title="@Loc[L.Drive_UploadFile]" @onclick="OpenUpload" aria-label="upload">
                    <Icon Name="Icons.Upload" Size="1.3rem"></Icon>
                </button>
                <div class="file-input">
                    <InputFile @ref="UploadInput" OnChange="Upload" multiple>Upload!</InputFile>
                </div>
                <button class="btn" title="@Loc[L.Note_Poll]" @onclick="TogglePoll" aria-label="poll">
                    <Icon Name="Icons.MicrophoneStage" Size="1.3rem"></Icon>
                </button>
                <button class="btn" title="@Loc[L.Note_Cw]" @onclick="ToggleCw" aria-label="content warning">
                    <Icon Name="Icons.EyeSlash" Size="1.3rem"></Icon>
                </button>
                <button class="btn" title="@Loc[L.User_AddMention]" @onclick="AddMention" aria-label="add mention">
                    <Icon Name="Icons.At" Size="1.3rem"></Icon>
                </button>
                <button @ref="EmojiButton" class="btn" title="@Loc[L.Common_Emojis]" @onclick="ToggleEmojiPicker"
                        aria-label="emoji">
                    <Icon Name="Icons.Smiley" Size="1.3rem"></Icon>
                </button>
                @if (NoteDraft.RenoteId == null && AttachedQuote == null)
                {
                    <button class="btn" title="@Loc[L.Compose_Quote_Add]" @onclick="AddQuote" aria-label="add quote">
                        <Icon Name="Icons.Quotes" Size="1.3rem"></Icon>
                    </button>
                }
            </div>
            <div class="buttons">
                <span title="@Loc[L.Compose_CharacterLimit]"
                      aria-label="character limit">@(NoteLength - ((NoteDraft.Cw?.Length ?? 0) + NoteDraft.Text.Length))</span>
                <button class="btn" title="@Loc[L.Compose_TogglePreview]" @onclick="() => Preview = !Preview"
                        aria-label="preview">
                    <Icon Name="Icons.Binoculars" Size="1.3rem"></Icon>
                </button>
            </div>
        </div>
        @if (AttachedQuote != null)
        {
            <div>
                <span>
                    <Icon Name="Icons.Quotes"/>
                    <a href="@($"/notes/{AttachedQuote}")" target="_blank">@Loc[L.Compose_Quote]</a>
                    <button class="btn" title="@Loc[L.Compose_Quote_Remove]" @onclick="RemoveQuote" aria-label="remove quote">
                        <Icon Name="Icons.Trash" Size="1rem"></Icon>
                    </button>
                </span>
            </div>
        }
        @if (UploadingFiles != 0)
        {
            <div>
                <span><LoadingSpinner/> @(UploadingFiles == 1 ? Loc[L.Drive_Uploading] : Loc[L.Drive_Uploading_Count, UploadingFiles])</span>
            </div>
        }
        @if (Attachments.Count != 0)
        {
            <div class="attachments">
                @foreach (var attachment in Attachments)
                {
                    <ComposeAttachment File="@attachment" AddInlineMedia="AddInlineMedia" RemoveAttachment="RemoveAttachment"/>
                }
            </div>
        }
        @if (NoteDraft.Poll != null)
        {
            <div class="poll">
                <div class="choices">
                    @foreach (var entry in PollChoices)
                    {
                        <div class="choice">
                            <input class="input" placeholder="@Loc[L.Compose_Poll_ChoicePlaceholder]" @bind="@entry.Value"/>
                            <button class="button" title="@Loc[L.Common_Delete]" @onclick="() => DeletePollChoice(entry)">
                                <Icon Name="Icons.Trash"/>
                            </button>
                        </div>
                    }
                    @if (PollChoices.Count < 10)
                    {
                        <div class="choice">
                            <input class="input" placeholder="@Loc[L.Compose_Poll_ChoicePlaceholder]" @bind="@PollEntry"/>
                            <button class="button" title="@Loc[L.Common_Add]" @onclick="AddPollChoice">
                                <Icon Name="Icons.Plus"/>
                            </button>
                        </div>
                    }
                </div>
                <label class="inline-label">
                    <input type="checkbox" @bind="NoteDraft.Poll.Multiple"/>
                    @Loc[L.Note_Poll_MultipleChoice]
                </label>
                <div class="expire">
                    <div>
                        <label for="poll-expires">@Loc[L.Compose_Poll_ExpiresAt]</label>
                        <select @bind="PollExpires" id="poll-expires">
                            <option value="@PollExpire.Never">@Loc[L.Compose_Poll_ExpiresAt_Never]</option>
                            <option value="@PollExpire.ExpiresAt">@Loc[L.Compose_Poll_ExpiresAt_DateTime]</option>
                            <option value="@PollExpire.ExpiresAfter">@Loc[L.Compose_Poll_ExpiresAt_AfterDuration]</option>
                        </select>
                    </div>
                    @switch (PollExpires)
                    {
                        case PollExpire.Never:
                            break;
                        case PollExpire.ExpiresAt:
                            <input type="datetime-local" class="input" @bind="PollExpireTime"/>
                            break;
                        case PollExpire.ExpiresAfter:
                            <input type="number" class="input" placeholder="@Loc[L.Compose_Poll_Duration]" min="@(PollExpiresAft == PollExpireAfter.Minutes ? 5 : 1)" @bind="PollExpireLen"/>
                            <select @bind="PollExpiresAft">
                                <option value="@PollExpireAfter.Minutes">@Loc[L.Duration_Minutes]</option>
                                <option value="@PollExpireAfter.Hours">@Loc[L.Duration_Hours]</option>
                                <option value="@PollExpireAfter.Days">@Loc[L.Duration_Days]</option>
                            </select>
                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                </div>
            </div>
        }
        @if (Preview)
        {
            <div class="preview">
                @if (string.IsNullOrWhiteSpace(NoteDraft.Text))
                {
                    <span>@Loc[L.Compose_NoPreview]</span>
                }
                else
                {
                    <MfmText Text="@NoteDraft.Text.ReplaceLineEndings("\n")" Emoji="EmojiList"/>
                }
            </div>
        }
        <div @onclick="CloseDialog" class="backdrop"></div>
    </div>
</dialog>


@code {
    private ElementReference         Dialog { get; set; }
    private IJSObjectReference       _module = null!;
    private IList<DriveFileResponse> Attachments     { get; set; } = [];
    private InputFile                UploadInput     { get; set; } = null!;
    private NoteBase?                ReplyOrQuote    { get; set; }
    private string?                  TextPlaceholder { get; set; }
    private ElementReference         Textarea        { get; set; }
    private ElementReference         EmojiButton     { get; set; }
    private StateButton              SendButton      { get; set; } = null!;
    private bool                     Preview         { get; set; }
    private List<EmojiResponse>      EmojiList       { get; set; } = [];
    private int                      NoteLength      { get; set; }
    private bool                     SendLock        { get; set; }
    private int                      UploadingFiles  { get; set; }
    private string?                  AttachedQuote   { get; set; }
    private List<Choice>             PollChoices     { get; set; } = [];
    private string                   PollEntry       { get; set; } = "";
    private PollExpire               PollExpires     { get; set; }
    private DateTime                 PollExpireTime  { get; set; }
    private int                      PollExpireLen   { get; set; }
    private PollExpireAfter          PollExpiresAft  { get; set; }
    private (string, string)?        PastedText      { get; set; }
    private string?                  NoteId          { get; set; }

    private DotNetObjectReference<Compose> _objRef = null!;

    private NoteCreateRequest NoteDraft { get; set; } = new()
    {
        Text       = "",
        Visibility = NoteVisibility.Followers, // FIXME: Default to visibilty in settings
        Cw         = null
    };

    private Dictionary<string, string> AvailablePlaceholders { get; set; } = new() { { "default", L.Compose_BodyPlaceholder_Note }, { "reply", L.Compose_BodyPlaceholder_Reply }, { "quote", L.Compose_BodyPlaceholder_Quote } };

    private class Choice
    {
        public required string Value { get; set; }
    }

    private enum PollExpire
    {
        Never,
        ExpiresAt,
        ExpiresAfter
    }

    private enum PollExpireAfter
    {
        Minutes,
        Hours,
        Days,
    }

    private bool SendingDisabled() =>
        NoteLength - ((NoteDraft.Cw?.Length ?? 0) + NoteDraft.Text.Length) < 0 || UploadingFiles != 0 || NoteDraft.Poll != null && PollChoices.Count(p => !string.IsNullOrWhiteSpace(p.Value)) < 2 || AttachedQuote != null && string.IsNullOrWhiteSpace(NoteDraft.Cw) && string.IsNullOrWhiteSpace(NoteDraft.Text) && Attachments.Count == 0 && NoteDraft.Poll == null;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e is { Code: "Enter", CtrlKey: true } or { Code: "Enter", MetaKey: true })
        {
            if (!SendingDisabled()) await SendNote();
        }

        if (e is { Code: "Escape" })
        {
            if (!SendLock && UploadingFiles == 0) await CloseDialog();
        }
    }

    RenderFragment DropdownIcon(NoteVisibility vis)
    {
        return vis switch
        {
            NoteVisibility.Public => (@<Icon Name="Icons.Globe"/>),
            NoteVisibility.Home => (@<Icon Name="Icons.House"/>),
            NoteVisibility.Followers => (@<Icon Name="Icons.Lock"/>),
            NoteVisibility.Specified => (@<Icon Name="Icons.Envelope"/>),
            _ => throw new ArgumentOutOfRangeException()
        };
    }

    RenderFragment DropdownContent(NoteVisibility vis)
    {
        return vis switch
        {
            NoteVisibility.Public => (@<span class="dropdown-title">@Loc[L.Note_Visibility_Public]</span>),
            NoteVisibility.Home => (@<span class="dropdown-title">@Loc[L.Note_Visibility_Unlisted]</span>),
            NoteVisibility.Followers => (@<span class="dropdown-title">@Loc[L.Note_Visibility_Followers]</span>),
            NoteVisibility.Specified => (@<span class="dropdown-title">@Loc[L.Note_Visibility_Specified]</span>),
            _ => throw new ArgumentOutOfRangeException()
        };
    }

    private IList<DropdownElement<NoteVisibility>> DropDownCreate()
    {
        return Enum.GetValues<NoteVisibility>()
                   .Where(vis => ReplyOrQuote == null || ReplyOrQuote.Visibility <= vis)
                   .Select(vis =>
                               new DropdownElement<NoteVisibility>
                               {
                                   #pragma warning disable BL0005 // Setting this outside the component is fine until this is reworked
                                   Icon = DropdownIcon(vis), Content = DropdownContent(vis), Selection = vis
                                   #pragma warning restore BL0005
                               })
                   .ToList();
    }

    // The <InputFile> Component is hidden, and triggered by a sepperate button.
    // That way we get it's functionality, without the styling limitations of the InputFile component
    private async Task OpenUpload()
    {
        if (UploadInput.Element is not { } element) return;
        await JsSvc.ClickElementAsync(element);
    }

    public async Task OpenDialogRedraft(NoteResponse note)
    {
        await ResetState();
        NoteDraft.Text       = note.Text ?? "";
        NoteDraft.Cw         = note.Cw;
        NoteDraft.Visibility = note.Visibility;
        foreach (var attachment in note.Attachments)
        {
            Attachments.Add(new DriveFileResponse
            {
                Id           = attachment.Id,
                ContentType  = attachment.ContentType,
                Description  = attachment.AltText,
                Filename     = attachment.FileName,
                IsAvatar     = false,
                IsBanner     = false,
                Sensitive    = attachment.IsSensitive,
                ThumbnailUrl = attachment.ThumbnailUrl,
                Url          = attachment.Url
            });
        }
        NoteDraft.RenoteId   = note.RenoteId;
        NoteDraft.ReplyId    = note.ReplyId;
        UploadingFiles       = 0;
        StateHasChanged();
        await JsSvc.ShowDialogAsync(Dialog, false);
    }

    public async Task OpenDialogEdit(NoteBase note)
    {
        await ResetState();
        NoteId             = note.Id;
        NoteDraft.Text     = note.Text ?? "";
        NoteDraft.Cw       = note.Cw;
        if (note.Poll != null)
        {
            NoteDraft.Poll = new PollRequest { ExpiresAt = note.Poll.ExpiresAt, Choices = note.Poll.Choices.Select(x => x.Value).ToList(), Multiple = note.Poll.Multiple };
            PollChoices    = note.Poll.Choices.Select(x => new Choice {Value = x.Value}).ToList();
            PollEntry      = "";
            PollExpires    = note.Poll.ExpiresAt is null ? PollExpire.Never : PollExpire.ExpiresAt;
            PollExpireTime = note.Poll.ExpiresAt ?? DateTime.Now;
            PollExpireLen  = ((note.Poll.ExpiresAt ?? DateTime.Now) - DateTime.Now).Days;
            PollExpiresAft = PollExpireAfter.Days;
        }
        UploadingFiles     = 0;
        foreach (var attachment in note.Attachments)
        {
            Attachments.Add(new DriveFileResponse
            {
                Id = attachment.Id,
                ContentType = attachment.ContentType,
                Description = attachment.AltText,
                Filename = attachment.FileName,
                IsAvatar = false,
                IsBanner = false,
                Sensitive = attachment.IsSensitive,
                ThumbnailUrl = attachment.ThumbnailUrl,
                Url = attachment.Url
            });
        }
        StateHasChanged();
        await JsSvc.ShowDialogAsync(Dialog, false);
    }

    public async Task OpenDialog(NoteBase? replyTo = null, NoteBase? quote = null, string? noteText = null)
    {
        var settings = await Settings.GetUserSettingsAsync();
        if (replyTo != null)
        {
            var mentions = await EnumerateMentions(replyTo);
            await ResetState();
            ReplyOrQuote         = replyTo;
            NoteDraft.ReplyId    = replyTo.Id;
            NoteDraft.Visibility = settings.DefaultNoteVisibility > replyTo.Visibility ? settings.DefaultNoteVisibility : replyTo.Visibility;
            NoteDraft.Cw         = replyTo.Cw;
            TextPlaceholder      = AvailablePlaceholders["reply"];
            foreach (var el in mentions)
            {
                NoteDraft.Text += $"@{el} ";
            }
        }
        else if (quote != null)
        {
            await ResetState();
            ReplyOrQuote         = quote;
            NoteDraft.RenoteId   = quote.Id;
            NoteDraft.Visibility = settings.DefaultNoteVisibility > quote.Visibility ? settings.DefaultNoteVisibility : quote.Visibility;
            TextPlaceholder      = AvailablePlaceholders["quote"];
        }
        else if (!string.IsNullOrWhiteSpace(noteText))
        {
            await ResetState();
            NoteDraft.Text = noteText;
        }
        else
        {
            await ResetState();
        }

        StateHasChanged();

        await JsSvc.ShowDialogAsync(Dialog, false);
    }

    private async Task<List<string>> EnumerateMentions(NoteBase noteBase)
    {
        List<string> mentions = [];
        if (noteBase.User.Id != SessionService.Current!.Id)
        {
            var userMention = noteBase.User.Username;
            if (noteBase.User.Host != null)
            {
                userMention += $"@{noteBase.User.Host}";
            }

            mentions.Add(userMention);
        }

        var instance = await MetadataService.Instance.Value;
        var mfmNodes = noteBase.Text != null ? MfmParser.Parse(noteBase.Text) : [];
        foreach (var node in mfmNodes)
        {
            if (node is MfmMentionNode mentionNode)
            {
                mentions.Add(mentionNode.Acct.Replace($"@{instance.AccountDomain}", ""));
            }
        }

        mentions = mentions.Distinct().ToList();
        mentions.Remove(SessionService.Current.Username);
        return mentions;
    }

    private async Task ResetState()
    {
        var settings = await Settings.GetUserSettingsAsync();
        ReplyOrQuote     = null;
        Attachments      = new List<DriveFileResponse>();
        NoteDraft        = new NoteCreateRequest { Text = "", Visibility = settings.DefaultNoteVisibility, Cw = null };
        TextPlaceholder  = AvailablePlaceholders["default"];
        PastedText       = null;
        SendButton.State = StateButton.StateEnum.Initial;
        AttachedQuote    = null;
        NoteId           = null;

        if (EmojiList.Count == 0)
            EmojiList = await EmojiService.GetEmojiAsync();

        await _module.InvokeVoidAsync("setupPaste", _objRef, Textarea, UploadInput.Element);
    }

    private async Task CloseDialog()
    {
        await JsSvc.CloseDialogAsync(Dialog);
    }

    private async Task SendNote()
    {
        if (SendLock) return;
        SendLock         = true;
        SendButton.State = StateButton.StateEnum.Loading;
        if (Attachments.Count > 0)
        {
            NoteDraft.MediaIds = Attachments.Select(x => x.Id).Distinct().ToList();
        }

        NoteDraft.RenoteId ??= AttachedQuote;

        if (NoteDraft.Poll != null)
        {
            NoteDraft.Poll.Choices = PollChoices.Select(p => p.Value).Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
            NoteDraft.Poll.ExpiresAt = PollExpires switch
            {
                PollExpire.ExpiresAt => PollExpireTime.ToUniversalTime(),
                PollExpire.ExpiresAfter => PollExpiresAft switch
                {
                    PollExpireAfter.Minutes => DateTime.UtcNow.AddMinutes(Math.Min(PollExpireLen, 5)),
                    PollExpireAfter.Hours   => DateTime.UtcNow.AddHours(Math.Min(PollExpireLen, 1)),
                    PollExpireAfter.Days    => DateTime.UtcNow.AddDays(Math.Min(PollExpireLen, 1)),
                    _                       => throw new ArgumentOutOfRangeException()
                },
                _ => null
            };
        }

        try
        {
            if (NoteId != null)
                await ApiService.Notes.EditNoteAsync(NoteId, new NoteUpdateRequest
                {
                    Text = NoteDraft.Text,
                    Cw = NoteDraft.Cw,
                    Poll = NoteDraft.Poll,
                    MediaIds = NoteDraft.MediaIds
                });
            else
                await ApiService.Notes.CreateNoteAsync(NoteDraft);
        }
        catch (ApiException e)
        {
            SendButton.State = StateButton.StateEnum.Failed;
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
            return;
        }

        if (ReplyOrQuote != null)
        {
            await NoteActions.RefetchNoteAsync(ReplyOrQuote.Id);
        }

        if (NoteId != null)
        {
            await NoteActions.RefetchNoteAsync(NoteId);
        }

        SendButton.State = StateButton.StateEnum.Success;
        await CloseDialog();
        SendLock         = false;
        SendButton.State = StateButton.StateEnum.Initial;
        // FIXME: Implement timeline refresh and call it here.
    }
    
    private void TogglePoll()
    {
        if (NoteDraft.Poll != null)
        {
            NoteDraft.Poll = null;
        }
        else
        {
            NoteDraft.Poll = new PollRequest
            {
                ExpiresAt = null,
                Multiple  = false,
                Choices   = []
            };
            PollChoices    = [];
            PollEntry      = "";
            PollExpires    = PollExpire.Never;
            PollExpireTime = DateTime.Now;
            PollExpireLen  = 7;
            PollExpiresAft = PollExpireAfter.Days;
        }
    }

    private void ToggleCw()
    {
        NoteDraft.Cw = NoteDraft.Cw == null ? "" : null;
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        UploadingFiles += e.FileCount;
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                var res = await ApiService.Drive.UploadFileAsync(file);
                Attachments.Add(res);
            }
            catch (ApiException ex) when (ex.Response is { StatusCode: 413, Details: { Length: > 0 } details })
            {
                const string prefix = "The media upload size limit is set to ";
                const string suffix = " bytes.";
                string       msg;
                if (details.StartsWith(prefix) && long.TryParse(details[prefix.Length..^suffix.Length], out var bytes))
                    msg = Loc[L.Compose_Error_AttachmentSize_Bytes, bytes.ToString()]; //TODO: fix grammar
                else
                    msg = Loc[L.Compose_Error_AttachmentSize];

                await GlobalComponentSvc.NoticeDialog?.Display(msg, NoticeDialog.NoticeType.Error)!;
            }
            catch (ApiException ex)
            { 
                await GlobalComponentSvc.NoticeDialog?.DisplayApiError(ex)!;
            }
            catch (Exception ex)
            { 
                await GlobalComponentSvc.NoticeDialog?.Display(ex.Message, NoticeDialog.NoticeType.Error)!;
            }

            UploadingFiles -= 1;
        }

        Attachments = Attachments.DistinctBy(a => a.Id).ToList();
    }

    private void RemoveAttachment(string id)
    {
        var attachment = Attachments.FirstOrDefault(p => p.Id == id);
        if (attachment == null) return;
        Attachments.Remove(attachment);
        StateHasChanged();
    }

    private void AddPollChoice()
    {
        if (string.IsNullOrWhiteSpace(PollEntry)) return;
        PollChoices.Add(new Choice { Value = PollEntry });
        PollEntry = "";
    }

    private void DeletePollChoice(Choice choice)
    {
        PollChoices.Remove(choice);
    }

    private async Task InsertTextAsync(string? text)
    {
        if (text == null) return;
        NoteDraft.Text = await _module.InvokeAsync<string>("insertText", Textarea, text);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task PasteQuote(string pastedText)
    {
        PastedText = (pastedText, "");

        try
        {
            var res = await ApiService.Search.LookupAsync(pastedText);
            if (res == null || !res.TargetUrl.StartsWith("/notes/"))
            {
                await InsertTextAsync(PastedText?.Item1);
                return;
            }

            PastedText = (pastedText, res.TargetUrl.Split('/').Last());
            await GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, PasteQuoteCallback), Loc[L.Compose_AttachQuoteDialog_Question], Icons.Quotes)!;
        }
        catch (ApiException)
        {
            await InsertTextAsync(PastedText?.Item1);
        }
    }

    private async Task PasteQuoteCallback(bool confirm)
    {
        if (!confirm)
        {
            await InsertTextAsync(PastedText?.Item1);
            return;
        }

        AttachedQuote = PastedText?.Item2;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import",
                                                               "./Components/Compose.razor.js");

            var instance = await MetadataService.Instance.Value;
            NoteLength = instance.Limits.NoteLength;
        }
    }

    private async Task ToggleEmojiPicker()
    {
        await GlobalComponentSvc.EmojiPicker?.Open(EmojiButton, new EventCallback<EmojiResponse>(this, AddEmoji))!;
    }

    private async Task AddMention() =>
        await GlobalComponentSvc.UserDialog?.Select(new EventCallback<UserResponse?>(this, AddMentionCallback), Loc[L.Compose_AddMentionDialog_Submit])!;

    private async Task AddMentionCallback(UserResponse? user)
    {
        if (user == null) return;

        var mentionString = user.Host != null ? $"@{user.Username}@{user.Host} " : $"@{user.Username} ";
        await InsertTextAsync(mentionString);
        StateHasChanged();
    }

    private async Task AddQuote() =>
        await GlobalComponentSvc.PromptDialog?.Prompt(new EventCallback<string?>(this, AddQuoteCallback), Loc[L.Compose_Quote_Add], Loc[L.Compose_AttachQuoteDialog_Placeholder], "")!;

    private async Task AddQuoteCallback(string? url)
    {
        if (url == null) return;

        try
        {
            var res = await ApiService.Search.LookupAsync(url);
            if (res != null)
            {
                if (!res.TargetUrl.StartsWith("/notes/"))
                {
                    await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.Compose_Error_AttachQuote], NoticeDialog.NoticeType.Error)!;
                    return;
                }

                AttachedQuote = res.TargetUrl[7..];
            }
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void RemoveQuote()
    {
        AttachedQuote = null;
    }

    private async Task AddEmoji(EmojiResponse emoji)
    {
        var emojiString = $":{emoji.Name}: ";
        await InsertTextAsync(emojiString);
        StateHasChanged();
    }

    private async Task AddInlineMedia(string url)
    {
        var mediaString = $"$[media {url} ] ";
        await InsertTextAsync(mediaString);
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        TextPlaceholder = AvailablePlaceholders["default"];

        _objRef = DotNetObjectReference.Create(this);

        ComposeService.ComposeDialog = this;
    }
}

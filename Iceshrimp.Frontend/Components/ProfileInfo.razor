@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@inject ApiService                     Api
@inject GlobalComponentSvc             GlobalComponentSvc;
@inject IJSRuntime                     Js;
@inject JsService                      JsSvc;
@inject IStringLocalizer<Localization> Loc;
@inject MetadataService                MetadataService
@inject NavigationManager              Nav;

<div class="profile-info">
    @if (User.MovedTo != null)
    {
        <WarningBanner>
            @Loc[L.Settings_Migration_MigratedNotice]
            <a href="@User.MovedTo" target="_blank">@Loc[L.Settings_Migration_GotoMigrated]</a>
        </WarningBanner>
    }
    <div class="top-row">
        <div class="badges">
            @if (UserProfile.Lang != null && (UserProfile.Pronouns?.TryGetValue(UserProfile.Lang, out var pronouns) ?? false))
            {
                <span class="badge">@pronouns</span>
            }
            @switch (UserProfile.Role)
            {
                case Role.Moderator:
                    <span class="badge">
                        <Icon Name="Icons.Shield" Size="1.3em"/>
                        @Loc[L.User_Badge_ModeratorRole]
                    </span>
                    break;
                case Role.Admin:
                    <span class="badge">
                        <Icon Name="Icons.ShieldStar" Size="1.3em"/>
                        @Loc[L.User_Badge_AdminRole]
                    </span>
                    break;
                case Role.None:
                    break;
                default:
                    throw new ArgumentOutOfRangeException();
            }
            @if (User.IsBot)
            {
                <span class="badge">
                    <Icon Name="Icons.Robot" Size="1.3em"/>
                    @Loc[L.User_Badge_IsBot]
                </span>
            }
            @if (UserProfile.IsLocked)
            {
                <span class="badge">
                    <Icon Name="Icons.Lock" Size="1.3em"/>
                    @Loc[L.User_Badge_IsLocked]
                </span>
            }
            @if (UserProfile.Relations.HasFlag(Relations.FollowedBy))
            {
                <span class="badge">
                    @Loc[L.User_Badge_FollowedBy]
                </span>
            }
        </div>
        <div class="profile-buttons">
            <FollowButton User="User" UserProfile="UserProfile"/>
            <MenuButton ButtonClass="button context-button">
                <ButtonContent>
                    <Icon Name="Icons.DotsThreeOutline" Size="1.3rem"/>
                </ButtonContent>
                <Elements>
                    @if (UserProfile.Relations.HasFlag(Relations.Self))
                    {
                        <MenuElement Icon="Icons.Pencil" OnSelect="EditProfile">
                            <Text>@Loc[L.User_Menu_EditProfile]</Text>
                        </MenuElement>
                    }
                    else if (UserProfile.Relations.HasFlag(Relations.CanBite))
                    {
                        <MenuElement Icon="Icons.Tooth" OnSelect="Bite">
                            <Text>@Loc[L.Common_Bite]</Text>
                        </MenuElement>
                    }
                    @if (User.Host != null)
                    {
                        <MenuElement Icon="Icons.ArrowsClockwise" OnSelect="RefetchUser">
                            <Text>@Loc[L.Common_Refetch]</Text>
                        </MenuElement>
                    }
                    <MenuElement Icon="Icons.Info" OnSelect="OpenAbout">
                        <Text>@Loc[L.AboutPage]</Text>
                    </MenuElement>
                    <hr class="rule"/>
                    @if (User.Host != null && UserProfile.Url != null)
                    {
                        <MenuElement Icon="Icons.ArrowSquareOut" OnSelect="OpenOriginal">
                            <Text>@Loc[L.Common_OpenOriginal]</Text>
                        </MenuElement>
                    }
                    @if (CanShare)
                    {
                        <MenuElement Icon="Icons.Share" OnSelect="Share">
                            <Text>@Loc[L.Common_Share]</Text>
                        </MenuElement>
                    }
                    <MenuElement Icon="Icons.Share" OnSelect="CopyLink">
                        <Text>@Loc[L.Common_CopyLink]</Text>
                    </MenuElement>
                    @if (User.Host != null && UserProfile.Url != null)
                    {
                        <MenuElement Icon="Icons.ShareNetwork" OnSelect="CopyLinkRemote">
                            <Text>@Loc[L.Common_CopyLink_Remote]</Text>
                        </MenuElement>
                    }
                    <MenuElement Icon="Icons.At" OnSelect="CopyUsername">
                        <Text>@Loc[L.User_Menu_CopyUsername]</Text>
                    </MenuElement>
                    @if (User.Host == null)
                    {
                        <MenuElement Icon="Icons.Atom" OnSelect="CopyAtomFeed">
                            <Text>@Loc[L.User_Menu_CopyFeed_Atom]</Text>
                        </MenuElement>
                        <MenuElement Icon="Icons.BracketsCurly" OnSelect="CopyJsonFeed">
                            <Text>@Loc[L.User_Menu_CopyFeed_Json]</Text>
                        </MenuElement>
                        <MenuElement Icon="Icons.Rss" OnSelect="CopyRssFeed">
                            <Text>@Loc[L.User_Menu_CopyFeed_Rss]</Text>
                        </MenuElement>
                    }
                    @if (!UserProfile.Relations.HasFlag(Relations.Self))
                    {
                        <hr class="rule"/>
                        @if (UserProfile.Relations.HasFlag(Relations.Muting))
                        {
                            <MenuElement Icon="Icons.Eye" OnSelect="Unmute">
                                <Text>@Loc[L.User_Menu_Mute_Remove]</Text>
                            </MenuElement>
                        }
                        else
                        {
                            <MenuElement Icon="Icons.EyeSlash" OnSelect="Mute">
                                <Text>@Loc[L.User_Menu_Mute_Add]</Text>
                            </MenuElement>
                            <MenuElement Icon="Icons.Timer" OnSelect="TemporaryMute">
                                <Text>@Loc[L.User_Menu_Mute_AddTemporary]</Text>
                            </MenuElement>
                        }
                        
                        @if (UserProfile.Relations.HasFlag(Relations.MutedRenotes))
                        {
                            <MenuElement Icon="Icons.Repeat" OnSelect="UnmuteRenotes">
                                <Text>@Loc[L.User_Menu_MuteRenotes_Remove]</Text>
                            </MenuElement>
                        }
                        else
                        {
                            <MenuElement Icon="Icons.EyeClosed" OnSelect="MuteRenotes">
                                <Text>@Loc[L.User_Menu_MuteRenotes_Add]</Text>
                            </MenuElement>
                        }

                        @if (UserProfile.Relations.HasFlag(Relations.FollowedBy))
                        {
                            <MenuElement Icon="Icons.LinkBreak" OnSelect="RemoveFromFollowers" Danger>
                                <Text>@Loc[L.User_Menu_RemoveFollower]</Text>
                            </MenuElement>
                        }

                        @if (UserProfile.Relations.HasFlag(Relations.Blocking))
                        {
                            <MenuElement Icon="Icons.Prohibit" OnSelect="Unblock" Danger>
                                <Text>@Loc[L.User_Menu_Block_Remove]</Text>
                            </MenuElement>
                        }
                        else
                        {
                            <MenuElement Icon="Icons.Prohibit" OnSelect="Block" Danger>
                                <Text>@Loc[L.User_Menu_Block_Add]</Text>
                            </MenuElement>
                        }

                        <MenuElement Icon="Icons.WarningCircle" OnSelect="Report" Danger>
                            <Text>@Loc[L.Report_User]</Text>
                        </MenuElement>
                    }
                </Elements>
            </MenuButton>
        </div>
    </div>
    @if (UserProfile.Bio != null)
    {
        <div class="bio">
            <MfmText Text="@UserProfile.Bio" Emoji="@Emojis"/>
        </div>
    }
    @if (!UserProfile.Relations.HasFlag(Relations.Self))
    {
        <details class="memo-details">
            <summary>@Loc[L.User_Memo]</summary>
            <EditForm OnSubmit="SetMemo" Model="MemoForm">
                <textarea class="input memo" @bind="@MemoForm.Text" @bind:event="oninput" @bind:after="ResetMemoButton" rows="5"></textarea>
                <StateButton ExtraClasses="button" @ref="@MemoButton" OnClick="SetMemo">
                    <Initial>@Loc[L.StateButton_SaveChanges]</Initial>
                    <Success>@Loc[L.StateButton_Saved]</Success>
                    <Loading>@Loc[L.StateButton_Loading]<LoadingSpinner/>
                    </Loading>
                    <Failed>@Loc[L.StateButton_Retry]</Failed>
                </StateButton>
            </EditForm>
        </details>
    }
    <div class="data">
        @if (UserProfile.Birthday != null)
        {
            <div class="birthday field">
                <span class="field-name">
                    <Icon Name="Icons.Balloon" Size="1.3em"/>
                    @Loc[L.User_Birthday]
                </span>
                <span class="field-value">@UserProfile.Birthday</span>
            </div>
        }
        @if (UserProfile.Location != null)
        {
            <div class="location field">
                <span class="field-name">
                    <Icon Name="Icons.MapPin" Size="1.3em"/>
                    @Loc[L.User_Location]
                </span>
                <span class="field-value">@UserProfile.Location</span>
            </div>
        }
        @if (UserProfile.Pronouns != null && UserProfile.Pronouns.Count != 0)
        {
            <div class="pronouns field">
                <span class="field-name">
                    <Icon Name="Icons.IdentificationCard" Size="1.3em"/>
                    @Loc[L.User_Pronouns]
                </span>
                <span class="field-value">@string.Join(", ", UserProfile.Pronouns.Select(p => $"{p.Value} ({_languages.GetValueOrDefault(p.Key) ?? p.Key.ToUpper()})"))</span>
            </div>
        }
    </div>
    @if (UserProfile.Fields != null)
    {
        <div class="fields">
            @foreach (var field in UserProfile.Fields)
            {
                <ProfileInfoField Field="field" Emojis="@Emojis"/>
            }
        </div>
    }
    <div class="metadata">
        <div class="section">
            <div class="field-data">
                @UserProfile.Followers
            </div>
            <div class="field-text">
                @Loc[L.User_Followers]
            </div>
        </div>
        <div class="section">
            <div class="field-data">
                @UserProfile.Following
            </div>
            <div class="field-text">
                @Loc[L.User_Following]
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required UserResponse        User        { get; set; }
    [Parameter] [EditorRequired] public required UserProfileResponse UserProfile { get; set; }
    [Parameter] [EditorRequired] public required List<EmojiResponse> Emojis      { get; set; }

    private UserMemoRequest   MemoForm    { get; set; } = null!;
    private StateButton       MemoButton  { get; set; } = null!;
    private bool              CanShare    { get; set; }
    private InstanceResponse? _instance;

    private Dictionary<string, string> _languages = LanguageHelper.Bcp47Languages;

    private void EditProfile() => Nav.NavigateTo("/settings/profile");

    private async Task Bite() {
        try {
            await Api.Users.BiteUserAsync(User.Id);
            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_BiteDialog_Notice, User.DisplayName ?? User.Username])!;
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task RemoveFromFollowersAction(bool confirm)
    {
        if (!confirm) return;

        var removed = await Api.Users.RemoveUserFromFollowersAsync(User.Id);
        if (!removed) return;

        await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_RemoveFollowerDialog_Notice, User.DisplayName ?? User.Username])!;

        UserProfile.Relations &= ~Relations.FollowedBy;
        StateHasChanged();
    }

    private void RemoveFromFollowers() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, RemoveFromFollowersAction), Loc[L.User_RemoveFollowerDialog_Question, User.DisplayName ?? User.Username]);

    private void Mute() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, MuteCallback), Loc[L.User_MuteDialog_Question, User.DisplayName ?? User.Username]);

    private async Task MuteCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.MuteUserAsync(User.Id, null);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_MuteDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations += (int)Relations.Muting;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void TemporaryMute() =>
        GlobalComponentSvc.SelectDialog?.Select(new EventCallback<object?>(this, TemporaryMuteCallback), Loc[L.User_MuteDialog_Question, User.DisplayName ?? User.Username], [(Loc[L.Timestamp_Hour_X, 1], DateTime.Now.AddHours(1)), (Loc[L.Timestamp_Hour_X, 3], DateTime.Now.AddHours(3)), (Loc[L.Timestamp_Hour_X, 8], DateTime.Now.AddHours(8)), (Loc[L.Timestamp_Day_X, 1], DateTime.Now.AddDays(1)), (Loc[L.Timestamp_Week_X, 1], DateTime.Now.AddDays(7))]);

    private async Task TemporaryMuteCallback(object? value)
    {
        if (value is not DateTime expires) return;

        try
        {
            await Api.Users.MuteUserAsync(User.Id, expires);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_MuteDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations += (int)Relations.Muting;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void Unmute() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, UnmuteCallback), Loc[L.User_UnmuteDialog_Question, User.DisplayName ?? User.Username]);

    private async Task UnmuteCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.UnmuteUserAsync(User.Id);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_UnmuteDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations -= (int)Relations.Muting;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }
    
    private void MuteRenotes() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, MuteRenotesCallback), Loc[L.User_MuteRenotesDialog_Question, User.DisplayName ?? User.Username]);

    private async Task MuteRenotesCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.MuteRenotesAsync(User.Id);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_MuteRenotesDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations += (int)Relations.MutedRenotes;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }
    
    private void UnmuteRenotes() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, UnmuteRenotesCallback), Loc[L.User_UnmuteRenotesDialog_Question, User.DisplayName ?? User.Username]);

    private async Task UnmuteRenotesCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.UnmuteRenotesAsync(User.Id);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_UnmuteRenotesDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations -= (int)Relations.MutedRenotes;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }
    
    
    private void Block() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, BlockCallback), Loc[L.User_BlockDialog_Question, User.DisplayName ?? User.Username]);

    private void Report() =>
        GlobalComponentSvc.ReportDialog?.ReportUser(User);

    private async Task BlockCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.BlockUserAsync(User.Id);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_BlockDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations += (int)Relations.Blocking;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void Unblock() =>
        GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, UnblockCallback), Loc[L.User_UnblockDialog_Question, User.DisplayName ?? User.Username]);

    private async Task UnblockCallback(bool confirm)
    {
        if (!confirm) return;

        try
        {
            await Api.Users.UnblockUserAsync(User.Id);

            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_UnblockDialog_Notice, User.DisplayName ?? User.Username])!;

            UserProfile.Relations -= (int)Relations.Blocking;
            StateHasChanged();
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void OpenAbout()
    {
        Nav.NavigateTo($"{Nav.Uri}/about");
    }

    private void OpenOriginal()
    {
        if (UserProfile.Url != null)
            Js.InvokeVoidAsync("open", UserProfile.Url, "_blank");
    }

    private async Task CopyLink()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"https://{_instance?.WebDomain}/@{User.Username}" + (User.Host != null ? $"@{User.Host}" : ""));
    }

    private void CopyLinkRemote()
    {
        if (UserProfile.Url != null)
            Js.InvokeVoidAsync("navigator.clipboard.writeText", UserProfile.Url);
    }

    private void CopyUsername() => Js.InvokeVoidAsync("navigator.clipboard.writeText", $"@{User.Username}" + (User.Host != null ? $"@{User.Host}" : ""));

    private void Share() => JsSvc.ShareAsync(User.DisplayName ?? User.Username, UserProfile.Url ?? $"https://{_instance?.WebDomain}/@{User.Username}" + (User.Host != null ? $"@{User.Host}" : ""));

    private void CopyAtomFeed() => Js.InvokeVoidAsync("navigator.clipboard.writeText", $"https://{_instance?.WebDomain}/users/{User.Id}/feed.atom");

    private void CopyJsonFeed() => Js.InvokeVoidAsync("navigator.clipboard.writeText", $"https://{_instance?.WebDomain}/users/{User.Id}/feed.json");
    
    private void CopyRssFeed() => Js.InvokeVoidAsync("navigator.clipboard.writeText", $"https://{_instance?.WebDomain}/users/{User.Id}/feed.rss");

    private async Task RefetchUser() =>
        await GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, RefetchUserCallback), Loc[L.User_RefetchDialog_Question, User.DisplayName ?? User.Username])!;

    private async Task RefetchUserCallback(bool refetch)
    {
        if (!refetch) return;

        try
        {
            var res = await Api.Users.RefetchUserAsync(User.Id);
            if (res != null)
            {
                User = res;
                var newProfile = await Api.Users.GetUserProfileAsync(User.Id);
                if (newProfile != null)
                    UserProfile = newProfile;
                StateHasChanged();
                await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_RefetchDialog_Notice, User.DisplayName ?? User.Username])!;
            }
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task SetMemo()
    {
        if (MemoButton.State == StateButton.StateEnum.Loading || (UserProfile.Memo ?? "") == MemoForm.Text) return;

        MemoButton.State = StateButton.StateEnum.Loading;

        try
        {
            await Api.Users.SetMemoAsync(UserProfile.Id, MemoForm);
        }
        catch (ApiException)
        {
            MemoButton.State = StateButton.StateEnum.Failed;
        }

        UserProfile.Memo = MemoForm.Text;
        MemoButton.State = StateButton.StateEnum.Success;

        StateHasChanged();
    }

    private void ResetMemoButton()
    {
        if (MemoButton.State == StateButton.StateEnum.Success)
        {
            MemoButton.State = StateButton.StateEnum.Initial;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _instance = await MetadataService.Instance.Value;
        MemoForm  = new UserMemoRequest { Text = UserProfile.Memo ?? "" };
        CanShare  = await JsSvc.CanShareAsync(User.DisplayName ?? User.Username, UserProfile.Url ?? $"https://{_instance?.WebDomain}/@{User.Username}" + (User.Host != null ? $"@{User.Host}" : ""));
    }
}
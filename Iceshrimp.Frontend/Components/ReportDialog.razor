@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Frontend.Localization
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.Extensions.Localization
@inject ApiService                     Api;
@inject GlobalComponentSvc             GlobalComponentSvc;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;
@inject SessionService                 Session;

<dialog class="dialog" @ref="Dialog">
    <div class="report @(Waiting ? "waiting" : "")">
        @if (Waiting)
        {
            <LoadingSpinner Scale="1.5"/>
        }
        else
        {
            @if (ReportedNote != null)
            {
                <span>@Loc["Report note"]</span>
                <div class="report-note">
                    <NoteComponent Note="ReportedNote" AsQuote="true" OpenNote="false"/>
                </div>
            }
            else if (ReportedUser != null)
            {
                <span>@Loc["Report user"]</span>
                <div class="report-user">
                    <UserAvatar User="ReportedUser" Title="true"/>
                    <div class="name-section">
                        <UserDisplayName User="@ReportedUser"/>
                        <span class="identifier">
                            @@@ReportedUser.Username
                            @if (ReportedUser.Host != null)
                            {
                                <span class="host">@@@ReportedUser.Host</span>
                            }
                        </span>
                    </div>
                </div>
                
                <span>@Loc["Notes"]</span>

                <div class="note-ids">
                    @foreach (var id in NoteIds)
                    {
                        <a href="/notes/@id" target="_blank">@id</a>
                    }
                </div>

                <div class="report-note-add">
                    <input type="text" @bind="NewNoteId" placeholder="@Loc["Note ID or URL"]"/>
                    <button @onclick="AddNoteId" class="button">@Loc["Add note"]</button>
                </div>
            }

            @if (Rules.Count != 0)
            {
                <span>@Loc["Rule violations"]</span>

                <ol class="rules">
                    @foreach (var rule in Rules)
                    {
                        <li>
                            <label class="inline-label">
                                <input type="checkbox" @onchange="args => UpdateRules(rule.Id, (bool?)args.Value)"/>
                                @rule.Text
                            </label>
                        </li>
                    }
                </ol>
            }

            <textarea class="input" @bind="Comment" @bind:event="oninput" rows="5"
                      placeholder="@Loc["Report details"]"></textarea>
            
            @if (ReportedUser?.Host != null && (Session?.Current?.IsModerator ?? false) || (Session?.Current?.IsAdmin ?? false))
            {
                <label>
                    @Loc["Forward to {0}", ReportedUser?.Host!]
                    <InputCheckbox @bind-Value="Forward"/>
                </label>
            }
            
            <div class="buttons">
                <button class="button submit-btn" @onclick="Submit"
                        disabled="@string.IsNullOrWhiteSpace(Comment)">@Loc["Submit"]</button>
                <button class="button" @onclick="Cancel">@Loc["Cancel"]</button>
            </div>
        }
    </div>
</dialog>

@code {
    private ElementReference   Dialog       { get; set; }
    private List<RuleResponse> Rules        { get; set; } = [];
    private string             Comment      { get; set; } = "";
    private List<string>       RuleIds      { get; set; } = [];
    private List<string>       NoteIds      { get; set; } = [];
    private string             NewNoteId    { get; set; } = "";
    private NoteBase?          ReportedNote { get; set; }
    private UserResponse?      ReportedUser { get; set; }
    private bool               Forward      { get; set; }
    private bool               Waiting      { get; set; }

    private async Task CloseDialog()
    {
        await Js.CloseDialogAsync(Dialog);
    }

    public async Task ReportNote(NoteBase note)
    {
        Comment      = "";
        RuleIds      = [];
        NoteIds      = [];
        NewNoteId    = "";
        ReportedNote = note;
        ReportedUser = null;
        Forward      = false;

        StateHasChanged();

        await Js.ShowDialogAsync(Dialog);
    }

    public async Task ReportUser(UserResponse user)
    {
        Comment      = "";
        RuleIds      = [];
        NoteIds      = [];
        NewNoteId    = "";
        ReportedNote = null;
        ReportedUser = user;
        Forward      = false;

        StateHasChanged();

        await Js.ShowDialogAsync(Dialog);
    }

    private async Task Submit()
    {
        try
        {
            if (ReportedNote != null)
            {
                Waiting = true;
                await Api.Notes.ReportNoteAsync(ReportedNote.Id, new NoteReportRequest { Comment = Comment, RuleIds = RuleIds, Forward = Forward});
                Waiting = false;
                await CloseDialog();
            }
            else if (ReportedUser != null)
            {
                Waiting = true;
                await Api.Users.ReportUserAsync(ReportedUser.Id, new UserReportRequest { Comment = Comment, RuleIds = RuleIds, NoteIds = NoteIds, Forward = Forward});
                Waiting = false;
                await CloseDialog();
            }
        }
        catch (ApiException e)
        {
            Waiting = false;
            await GlobalComponentSvc.NoticeDialog?.Display(Loc[e.Response.Message ?? "Unable to submit report"], NoticeDialog.NoticeType.Error)!;
        }
    }

    private async Task Cancel()
    {
        await CloseDialog();
    }

    private void UpdateRules(string id, bool? check)
    {
        if (check is true && !RuleIds.Contains(id))
            RuleIds.Add(id);
        if (check is false)
            RuleIds.Remove(id);
    }

    private async Task AddNoteId()
    {
        if (ReportedUser == null) return;

        if (Uri.TryCreate(NewNoteId, UriKind.Absolute, out _))
        {
            var res = await Api.Search.LookupAsync(NewNoteId);

            if (res != null && res.TargetUrl.StartsWith("/notes/"))
            {
                var id = res.TargetUrl.Split('/').Last();
                if (!NoteIds.Contains(id))
                    NoteIds.Add(id);

                NewNoteId = "";
                return;
            }

            await GlobalComponentSvc.NoticeDialog?.Display(Loc["Note not found"], NoticeDialog.NoticeType.Error)!;
            return;
        }

        NoteResponse? note = null;

        try
        {
            note = await Api.Notes.GetNoteAsync(NewNoteId);
        }
        catch (ApiException)
        {
        }

        if (note != null)
        {
            if (note.User.Id == ReportedUser.Id)
            {
                if (!NoteIds.Contains(NewNoteId))
                    NoteIds.Add(NewNoteId);

                NewNoteId = "";
            }
            else
            {
                await GlobalComponentSvc.NoticeDialog?.Display(Loc["Note doesn't belong to reported user"], NoticeDialog.NoticeType.Error)!;
            }

            return;
        }

        await GlobalComponentSvc.NoticeDialog?.Display(Loc["Note not found"], NoticeDialog.NoticeType.Error)!;
    }

    protected override async Task OnInitializedAsync()
    {
        Rules                           = await Api.Instance.GetRulesAsync();
        GlobalComponentSvc.ReportDialog = this;
    }
}
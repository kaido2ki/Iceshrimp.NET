@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject IStringLocalizer<Localization> Loc;

<div @ref="EmojiButton" class="emoji-entry @(Selected ? "batch-selected" : "")" @onclick="SelectEmoji" @onclick:stopPropagation="true">
    <InlineEmoji Name="@Emoji.Name" Url="@Emoji.PublicUrl" Hover="@true" Size="3rem"/>
    <div class="emoji-details">
        <span class="emoji-name">@Emoji.Name</span>
        <span class="emoji-meta">
            @if (Remote)
            {
                @Emoji.Category
            }
            else
            {
                @foreach (var tag in Emoji.Tags)
                {
                    <span>@tag</span>
                }
            }
        </span>
        <span class="labels">
            @if (Emoji.Sensitive)
            {
                <Icon Name="Icons.EyeSlash" title="@Loc[L.Drive_Entry_Sensitive]"/>
            }
            @if (!string.IsNullOrWhiteSpace(Emoji.License))
            {
                <Icon Name="Icons.Article" title="@Emoji.License"/>
            }
        </span>
    </div>
    <Menu @ref="EmojiMenu" Id="@($"emoji-menu-{Emoji.Id}")">
        @if (Remote)
        {
            <MenuElement Icon="Icons.Copy" OnSelect="Clone">
                <Text>@Loc[L.Moderation_Emojis_Clone]</Text>
            </MenuElement>
        }
        else
        {
            <MenuElement Icon="Icons.CursorText" OnSelect="Rename">
                <Text>@Loc[L.Common_Rename]</Text>
            </MenuElement>
        }
        @if (Emoji.Sensitive)
        {
            <MenuElement Icon="Icons.Eye" OnSelect="MarkNotSensitive">
                <Text>@Loc[L.Drive_Entry_Menu_Sensitive_Remove]</Text>
            </MenuElement>
        }
        else
        {
            <MenuElement Icon="Icons.EyeSlash" OnSelect="MarkAsSensitive">
                <Text>@Loc[L.Drive_Entry_Menu_Sensitive_Add]</Text>
            </MenuElement>
        }
        @if (!Remote)
        {
            <MenuElement Icon="Icons.TextAa" OnSelect="SetTags">
                <Text>@Loc[L.Moderation_Emojis_SetTags]</Text>
            </MenuElement>
            <MenuElement Icon="Icons.Folder" OnSelect="SetCategory">
                <Text>@Loc[L.Moderation_Emojis_SetCategory]</Text>
            </MenuElement>
            <MenuElement Icon="Icons.Article" OnSelect="SetLicense">
                <Text>@Loc[L.Moderation_Emojis_SetLicense]</Text>
            </MenuElement>
            <hr class="rule"/>
            <MenuElement Icon="Icons.Trash" OnSelect="Delete" Danger>
                <Text>@Loc[L.Common_Delete]</Text>
            </MenuElement>
        }
    </Menu>
</div>

@code {
    [Parameter, EditorRequired] public required EmojiResponse                Emoji          { get; set; }
    [Parameter]                 public          bool                         Remote         { get; set; }
    [Parameter]                 public          EventCallback<EmojiResponse> DeleteEmoji    { get; set; }
    [Parameter]                 public          EventCallback                FilterEmojis   { get; set; }
    [Parameter]                 public          EventCallback<EmojiResponse> ToggleEmoji    { get; set; }
    [Parameter]                 public          bool                         BatchSelection { get; set; }
    [Parameter]                 public          bool                         Selected       { get; set; }
    private                                     ElementReference             EmojiButton    { get; set; }
    private                                     Menu                         EmojiMenu      { get; set; } = null!;

    private async Task SelectEmoji()
    {
        if (BatchSelection)
        {
            await ToggleEmoji.InvokeAsync(Emoji);
        }
        else
        {
            await EmojiMenu.Toggle(EmojiButton);
        }
    }

    private async Task Clone() =>
        await Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, CloneCallback), @Loc[L.Moderation_Emojis_CloneDialog_Question_Name_Host, Emoji.Name, Emoji.Category ?? ""], Icons.Copy)!;

    private async Task CloneCallback(bool confirm)
    {
        if (!confirm || !Remote || Emoji.Category == null) return;

        try
        {
            // Remote emojis endpoint sets EmojiResponse.Category to the emoji's host
            var res = await Api.Emoji.CloneEmojiAsync(Emoji.Name, Emoji.Category);
            if (res != null) await Global.NoticeDialog?.Display(Loc[L.Moderation_Emojis_CloneDialog_SuccessNotice_Name_Host, Emoji.Name, Emoji.Category])!;
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task Rename() =>
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, RenameCallback), Loc[L.Common_Rename], "", Emoji.Name)!;

    private async Task RenameCallback(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        try
        {
            var res = await Api.Emoji.UpdateEmojiAsync(Emoji.Id, new UpdateEmojiRequest { Name = name });
            if (res != null)
            {
                Emoji.Name = res.Name;
                StateHasChanged();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task MarkSensitive(bool sensitive)
    {
        try
        {
            var res = await Api.Emoji.UpdateEmojiAsync(Emoji.Id, new UpdateEmojiRequest { Sensitive = sensitive });
            if (res != null)
            {
                Emoji.Sensitive = res.Sensitive;
                StateHasChanged();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task MarkNotSensitive() => await MarkSensitive(false);

    private async Task MarkAsSensitive() => await MarkSensitive(true);

    private async Task SetTags() =>
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, SetTagsCallback), Loc[L.Moderation_Emojis_TagsDialog_Prompt], "one\ntwo\nthree", string.Join("\n", Emoji.Tags), true, true)!;

    private async Task SetTagsCallback(string? tags)
    {
        if (tags == null) return;

        try
        {
            var res = await Api.Emoji.UpdateEmojiAsync(Emoji.Id, new UpdateEmojiRequest { Tags = string.IsNullOrWhiteSpace(tags) ? [] : tags.Replace(" ", "").Split("\n").ToList() });
            if (res != null)
            {
                Emoji.Tags = res.Tags;
                StateHasChanged();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task SetCategory() =>
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, SetCategoryCallback), Loc[L.Moderation_Emojis_SetCategory], "", Emoji.Category, true)!;

    private async Task SetCategoryCallback(string? category)
    {
        if (category == null) return;

        try
        {
            var res = await Api.Emoji.UpdateEmojiAsync(Emoji.Id, new UpdateEmojiRequest { Category = category });
            if (res != null)
            {
                Emoji.Category = res.Category;
                await FilterEmojis.InvokeAsync();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task SetLicense() =>
        await Global.PromptDialog?.Prompt(new EventCallback<string?>(this, SetLicenseCallback), Loc[L.Moderation_Emojis_SetLicense], "", Emoji.License, true, true)!;

    private async Task SetLicenseCallback(string? license)
    {
        if (license == null) return;

        try
        {
            var res = await Api.Emoji.UpdateEmojiAsync(Emoji.Id, new UpdateEmojiRequest { License = license });
            if (res != null)
            {
                Emoji.License = res.License;
                StateHasChanged();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private async Task Delete() =>
        await Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, DeleteCallback), Loc[L.Moderation_Emojis_SingleDeleteDialog_Question, Emoji.Name], Icons.Trash, Loc[L.Common_Delete])!;

    private async Task DeleteCallback(bool delete)
    {
        if (!delete) return;
        try
        {
            var res = await Api.Emoji.DeleteEmojiAsync(Emoji.Id);
            if (res)
            {
                await DeleteEmoji.InvokeAsync(Emoji);
                await FilterEmojis.InvokeAsync();
            }
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }
}

@using Iceshrimp.Frontend.Core.Services
@inject JsService Js;

<div @ref="Popover" class="menu" id="@Id" popover="auto">
    <div class="elements" @onclick="Close">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required RenderFragment   ChildContent { get; set; }
    [Parameter] [EditorRequired] public required string           Id           { get; set; }
    private                                      ElementReference Popover      { get; set; }

    public async Task Toggle(ElementReference source)
    {
        await Js.TogglePopoverAsync(Popover, source);
    }

    private async Task Close()
    {
        await Js.HidePopoverAsync(Popover);
    }
}
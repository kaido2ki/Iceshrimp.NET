@* ReSharper disable once RedundantUsingDirective *@
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Shared.Schemas.Web
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject IStringLocalizer<Localization> Loc;
@inject NavigationManager              NavigationManager

<div class="notification@(NotificationResponse.Read ? " read" : "")">
    @if (NotificationResponse is not { Type: NotificationType.Mention } and not { Type: NotificationType.Reply })
    {
        <div class="notification-header">
            @if (NotificationResponse is { User: not null })
            {
                <UserAvatar User="@NotificationResponse.User" OnClick="@OpenProfile"/>
            }

            <div class="notification-body">
                @if (NotificationResponse is { User: not null })
                {
                    <a class="display-name" href="/@NotificationResponse.User.Handle" title="@NotificationResponse.User.Handle">
                        <UserDisplayName User="@NotificationResponse.User" />
                    </a>
                }
                
                @switch (NotificationResponse)
                {
                    case { Note: not null, Type: NotificationType.Like, User: not null }: 
                        <span class="notification-icon"><Icon Name="Icons.Heart" Pack="IconStyle.Fill" Size="0.8em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_like]</span> 
                        break; 
                    case { Note: not null, Reaction: not null, Type: NotificationType.Reaction }:
                        <span class="notification-reaction" title="@NotificationResponse.Reaction.Name">
                            <InlineEmoji Name="@NotificationResponse.Reaction.Name" Url="@NotificationResponse.Reaction.Url" Hover="true" Size="1.25em"/>
                        </span>
                        <span class="notification-text">@Loc[L.Notification_Body_reaction]</span>
                        break;
                    case { Type: NotificationType.Follow, User: not null }:
                        <span class="notification-icon"><Icon Name="Icons.HandWaving" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_follow]</span>
                        break;
                    case { Type: NotificationType.FollowRequestReceived }:
                        <span class="notification-icon"><Icon Name="Icons.Clock" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_follow_request_received]</span>
                        break;
                    case { Type: NotificationType.FollowRequestAccepted }:
                        <span class="notification-icon"><Icon Name="Icons.Check" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_follow_request_accepted]</span>
                        break;
                    case { Type: NotificationType.Renote }:
                        <span class="notification-icon"><Icon Name="Icons.Repeat" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_renote]</span>
                        break;
                    case { Type: NotificationType.Quote }:
                        <span class="notification-icon"><Icon Name="Icons.Quotes" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_quote]</span>
                        break;
                    case { Bite: { BiteBack: true }, Type: NotificationType.Bite }:
                        <span class="notification-icon"><Icon Name="Icons.Tooth" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_bite_Back]</span>
                        break;
                    case { Note: not null, Type: NotificationType.Bite }:
                        <span class="notification-icon"><Icon Name="Icons.Tooth" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_bite_Note]</span>
                        break;
                    case { Type: NotificationType.Bite }:
                        <span class="notification-icon"><Icon Name="Icons.Tooth" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_bite]</span>
                        break;
                    case { Type: NotificationType.Edit }:
                        <span class="notification-icon"><Icon Name="Icons.PencilLine" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_edit]</span>
                        break;
                    case { Type: NotificationType.PollVote }:
                        <span class="notification-icon"><Icon Name="Icons.MicrophoneStage" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_poll_vote]</span>
                        break;
                    case { Type: NotificationType.PollEnded }:
                        <span class="notification-icon"><Icon Name="Icons.Timer" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_poll_ended]</span>
                        break;
                    case { Type: NotificationType.Report, User: not null }:
                        <span class="notification-icon"><Icon Name="Icons.WarningCircle" Size="0.9em"/></span>
                        <span class="notification-text">@Loc[L.Notification_Body_report]</span>
                        break;
                    default:
                        <span class="notification-icon"><Icon Name="Icons.Question" Size="0.9em"/></span>
                        <span class="notification-text">
                            <i>@Loc[L.Notification_Unsupported]</i>
                        </span>
                        <details>
                            <summary>@Loc[L.Notification_Unsupported_ToggleDetails]</summary>
                            <p>@Loc[L.Notification_Unsupported_Details_Id, NotificationResponse.Id]</p>
                            <p>@Loc[L.Notification_Unsupported_Details_Type, NotificationResponse.Type]</p>
                        </details>
                        break;
                }
            </div>
        
            <span class="notification-metadata">
                <Timestamp Date="@DateTime.Parse(NotificationResponse.CreatedAt)"/>
                @if (!NotificationResponse.Read)
                {
                    <button class="mark-as-read" @onclick="MarkAsRead" title="@Loc[L.Notification_MarkRead]">
                        <Icon Name="Icons.Check"/>
                    </button>
                }
            </span>
        </div>
    }

    @if (NotificationResponse is { Note: not null })
    {
        <div class="@(NotificationResponse is not { Type: NotificationType.Mention or NotificationType.Reply } ? "notification-note" : "")" @onclick="MarkAsRead">
            <NoteComponent Note="NotificationResponse.Note" AsQuote="@(NotificationResponse is not { Type: NotificationType.Mention } and not { Type: NotificationType.Reply })" OpenNote="true"/>
        </div>
    }

    @switch (NotificationResponse)
    {
        case { Type: NotificationType.Bite, Bite: not null, User: not null }:
            <div class="notification-actions">
                <button class="button" @onclick="BiteBack">
                    <Icon Name="Icons.Tooth"/>
                    @Loc[L.Notification_Action_Bite_BiteBack]
                </button>
            </div>
            break;
    }
</div>

@code {
    [Parameter] public required NotificationResponse NotificationResponse { get; set; }

    private void OpenProfile()
    {
        var username                                          = $"@{NotificationResponse.User?.Username}";
        if (NotificationResponse.User?.Host != null) username += $"@{NotificationResponse.User.Host}";
        NavigationManager.NavigateTo($"/{username}");
    }

    private async Task MarkAsRead()
    {
        if (NotificationResponse.Read) return;

        NotificationResponse.Read = true;
        try
        {
            await Api.Notifications.MarkNotificationAsReadAsync(NotificationResponse.Id);
            StateHasChanged();
        }
        catch (ApiException)
        {
            NotificationResponse.Read = false;
        }
    }

    private async Task BiteBack()
    {
        if (NotificationResponse is not { Bite: { } bite, User: { } user }) return;
        await MarkAsRead();

        try
        {
            await Api.Misc.BiteBackAsync(bite.Id);
            await Global.NoticeDialog?.Display(Loc[L.Notification_Action_Bite_BiteBack_Notice, user.DisplayName ?? user.Username])!;
        }
        catch (ApiException e)
        {
            await Global.NoticeDialog?.DisplayApiError(e)!;
        }
    }
}

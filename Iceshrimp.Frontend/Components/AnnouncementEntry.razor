@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Frontend.Localization
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.Extensions.Localization
@using Iceshrimp.Assets.PhosphorIcons
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject IStringLocalizer<Localization> Loc;
@inject MetadataService                Meta;

<div class="announcement @(Announcement.Read is false ? "unread" : "")">
    <span class="title">@Announcement.Title</span>
    <MfmText Text="@Announcement.Text" Emoji="[]"/>
    @if (Announcement.ImageUrl != null)
    {
        <img src="@Announcement.ImageUrl" alt="@Loc["Announcement image"]"/>
    }
    <span class="metadata">
        @if (Announcement.UpdatedAt != null)
        {
            @Loc["Announced {0} - Edited {1}", Announcement.CreatedAt.ToLocalTime().ToString("G"), Announcement.UpdatedAt.Value.ToLocalTime().ToString("G")]
        }
        else
        {
            @Announcement.CreatedAt.ToLocalTime().ToString("G")
        }
    </span>
    @if (Moderator)
    {
        @if (Announcement.ReadCount != null)
        {
            <span class="metadata">
                @Loc["Users read: {0}/{1}", Announcement.ReadCount, Meta.Instance.Value.Result.UserCount]
            </span>
        }
        <div class="buttons">
            <span class="button" @onclick="() => Edit.InvokeAsync(Announcement.Id)">
                <Icon Name="Icons.Pencil"/>
                @Loc["Edit"]
            </span>
            <span class="button danger" @onclick="DeleteAnnouncementAsync">
                <Icon Name="Icons.Trash"/>
                @Loc["Delete"]
            </span>
        </div>
    }
    else if (Announcement.Read is false)
    {
        <div class="buttons">
            <span class="button" @onclick="MarkAsReadAsync">
                <Icon Name="Icons.Check"/>
                @Loc["Mark as read"]
            </span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required AnnouncementResponse  Announcement { get; set; }
    [Parameter]                 public          bool                  Moderator    { get; set; }
    [Parameter]                 public          EventCallback<string> Edit         { get; set; }
    [Parameter]                 public          EventCallback<string> Delete       { get; set; }

    private async Task MarkAsReadAsync()
    {
        await Api.Announcements.ReadAnnouncementAsync(Announcement.Id);
        Announcement.Read = true;
    }

    private Task DeleteAnnouncementAsync() =>
        Global.ConfirmDialog?.Confirm(new EventCallback<bool>(this, DeleteAnnouncementCallback), Loc["Delete announcement?"], Icons.Trash, Loc["Delete"])!;

    private async Task DeleteAnnouncementCallback(bool confirm)
    {
        if (confirm) await Delete.InvokeAsync(Announcement.Id);
    }
}
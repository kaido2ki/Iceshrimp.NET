@using Iceshrimp.Frontend.Core.Services
@typeparam TBind
@inject JsService Js;

<button class="dropdown-root" popovertarget="@Id">
    @CurrentIcon
</button>

<div @ref="Popover" class="dropdown-menu" id="@Id" popover="auto">
    <div class="elements">
        @foreach (var entry in Elements)
        {
            <DropdownElement TBind="TBind" OnSelect="Select" Icon="entry.Icon" Content="entry.Content"
                             Selection="entry.Selection"/>
        }
    </div>
</div>

@code {
    private                                      TBind                               _value = default!;
    [Parameter] [EditorRequired] public required IEnumerable<DropdownElement<TBind>> Elements { get; set; }
    [Parameter] [EditorRequired] public required string                              Id       { get; set; }

    [Parameter]
    [EditorRequired]
    #pragma warning disable BL0007 // While this implementation is suboptimal, this is technically fine. Should be reworked.
    public required TBind Value
    {
        get => _value;
        set
        {
            _value           = value;
            CurrentSelection = Elements.First(element => element.Selection != null && element.Selection.Equals(value));
            CurrentIcon      = CurrentSelection.Icon;
        }
    }
    #pragma warning restore BL0007

    [Parameter] public EventCallback<TBind>    ValueChanged     { get; set; }
    private            DropdownElement<TBind>? CurrentSelection { get; set; }
    private            RenderFragment?         CurrentIcon      { get; set; }
    private            ElementReference        Popover          { get; set; }

    private async Task Select(DropdownElement<TBind> element)
    {
        await UpdateSelected(element);
        await Js.HidePopoverAsync(Popover);
    }

    private async Task UpdateSelected(DropdownElement<TBind> element)
    {
        CurrentSelection = element;
        CurrentIcon      = CurrentSelection.Icon;
        await ValueChanged.InvokeAsync(element.Selection);
    }

    protected override async Task OnInitializedAsync()
    {
        await UpdateSelected(Elements.FirstOrDefault() ?? throw new InvalidOperationException());
    }
}
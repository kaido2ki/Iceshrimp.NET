@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Frontend.Core.Services.NoteStore
@using Iceshrimp.Shared.Schemas.Web
@inject IStringLocalizer<Localization> Loc;
@inject IJSRuntime                     Js;
@inject JsService                      JsSvc;
@inject SessionService                 Session;
@inject GlobalComponentSvc             GlobalComponentSvc
@inject MetadataService                MetadataSvc;
@inject NavigationManager              Nav;
@inject NoteActions                    NoteActions;

<div class="note-footer">
    @if (Reactions.Count > 0)
    {
        <div class="reactions @(Indented ? "indent" : "")">
            @foreach (var reaction in Reactions)
            {
                <NoteReaction Reaction="reaction"/>
            }
        </div>
    }
    <button class="btn" @onclick="Reply" @onclick:stopPropagation="true" aria-label="reply">
        <Icon Name="Icons.ArrowUUpLeft" Size="1.3em"/>
        @if (Replies > 0)
        {
            <span class="reply-count">@Replies</span>
        }
    </button>
    <button @ref="RenoteButton" class="btn @(RenotePossible ? "" : "disabled")"
            @onclick="@(RenotePossible ? ToggleRenoteMenu : () => { })" @onclick:stopPropagation="true"
            aria-label="renote">
        @if (RenotePossible)
        {
            <Icon Name="Icons.Repeat" Size="1.3em"/>
            <Menu @ref="RenoteMenu">
                @if (!Note.Renoted)
                {
                    @if (Note.Visibility == NoteVisibility.Public)
                    {
                        <MenuElement Icon="Icons.Repeat" OnSelect="() => Renote(NoteVisibility.Public)">
                            <Text>@Loc[L.Note_Renote]</Text>
                        </MenuElement>
                    }
                    <MenuElement Icon="Icons.House" OnSelect="() => Renote(NoteVisibility.Home)">
                        <Text>@Loc[L.Note_Renote_Unlisted]</Text>
                    </MenuElement>
                    <MenuElement Icon="Icons.Lock" OnSelect="() => Renote(NoteVisibility.Followers)">
                        <Text>@Loc[L.Note_Renote_Followers]</Text>
                    </MenuElement>
                }
                else
                {
                    <MenuElement Icon="Icons.Minus" OnSelect="Unrenote">
                        <Text>@Loc[L.Note_Unrenote]</Text>
                    </MenuElement>
                }
                <ClosingBackdrop OnClose="RenoteMenu.Close"></ClosingBackdrop>
            </Menu>
        }
        else
        {
            <Icon Name="Icons.Lock" Size="1.3em" class="faded"/>
        }
        @if (Renotes > 0)
        {
            <span class="renote-count">@Renotes</span>
        }
    </button>
    <button @onclick="Like" @onclick:stopPropagation="true" class="btn" aria-label="like">
        @if (IsLiked)
        {
            <Icon Name="Icons.Heart" Pack="IconStyle.Fill" Size="1.3em"/>
        }
        else
        {
            <Icon Name="Icons.Heart" Size="1.3em"/>
        }
        @if (Likes > 0)
        {
            <span class="like-count">@Likes</span>
        }
    </button>
    <button @ref="EmojiButton" class="btn" @onclick="ToggleEmojiPicker" @onclick:stopPropagation="true"
            aria-label="emoji picker">
        <Icon Name="Icons.Smiley" Size="1.3em"/>
        @if (Reactions.Count > 0)
        {
            <span class="like-count">@Reactions.Sum(r => r.Count)</span>
        }
    </button>
    <button class="btn @(RenotePossible ? "" : "disabled")" @onclick="@(RenotePossible ? Quote : () => { })"
            @onclick:stopPropagation="true" aria-label="quote">
        <Icon Name="@(RenotePossible ? Icons.Quotes : Icons.Lock)" Size="1.3em" class="@(RenotePossible ? "" : "faded")"/>
    </button>
    <button @ref="MenuButton" class="btn" @onclick="ToggleMenu" @onclick:stopPropagation="true" aria-label="more">
        <Icon Name="Icons.DotsThreeOutline" Size="1.3em"/>
        <Menu @ref="ContextMenu">
            @if (Note.CanBite)
            {
                <MenuElement Icon="Icons.Tooth" OnSelect="Bite">
                    <Text>@Loc[L.Common_Bite]</Text>
                </MenuElement>
            }
            @if (Note.User.Host != null)
            {
                <MenuElement Icon="Icons.ArrowsClockwise" OnSelect="RefetchNote">
                    <Text>@Loc[L.Common_Refetch]</Text>
                </MenuElement>
            }
            <MenuElement Icon="Icons.BookmarkSimple" OnSelect="Bookmark">
                <Text>@(Note.Bookmarked ? Loc[L.Note_Menu_Bookmark_Remove] : Loc[L.Note_Menu_Bookmark_Add])</Text>
            </MenuElement>
            @if (Note.User.Id == Session.Current?.Id)
            {
                <MenuElement Icon="@(Note.Pinned ? Icons.PushPinSlash : Icons.PushPin)" OnSelect="Pin">
                    <Text>@(Note.Pinned ? Loc[L.Note_Menu_Unpin] : Loc[L.Note_Menu_Pin])</Text>
                </MenuElement>
            }
            <MenuElement Icon="Icons.SpeakerX" OnSelect="Mute">
                <Text>@Loc[L.Note_Menu_MuteThread]</Text>
            </MenuElement>
            <hr class="rule"/>
            <MenuElement Icon="Icons.Info" OnSelect="OpenAbout">
                <Text>@Loc[L.AboutPage]</Text>
            </MenuElement>
            <MenuElement Icon="Icons.ArrowSquareOut" OnSelect="OpenOriginal">
                <Text>@Loc[L.Common_OpenOriginal]</Text>
            </MenuElement>
            @if (CanShare)
            {
                <MenuElement Icon="Icons.Share" OnSelect="Share">
                    <Text>@Loc[L.Common_Share]</Text>
                </MenuElement>
            }
            <MenuElement Icon="Icons.Share" OnSelect="CopyLink">
                <Text>@Loc[L.Common_CopyLink]</Text>
            </MenuElement>
            @if (Note.User.Host != null)
            {
                <MenuElement Icon="Icons.ShareNetwork" OnSelect="CopyLinkRemote">
                    <Text>@Loc[L.Common_CopyLink_Remote]</Text>
                </MenuElement>
            }
            @if (!string.IsNullOrWhiteSpace(Note.Text))
            {
                <MenuElement Icon="Icons.Copy" OnSelect="CopyContents">
                    <Text>@Loc[L.Common_CopyContents]</Text>
                </MenuElement>
            }
            <hr class="rule"/>
            @if (Note.User.Id == Session.Current?.Id)
            {
                <MenuElement Icon="Icons.Pencil" OnSelect="Edit">
                    <Text>@Loc[L.Common_Edit]</Text>
                </MenuElement>
                <MenuElement Icon="Icons.Eraser" OnSelect="Redraft" Danger>
                    <Text>@Loc[L.Note_Menu_Redraft]</Text>
                </MenuElement>
                <MenuElement Icon="Icons.Trash" OnSelect="Delete" Danger>
                    <Text>@Loc[L.Common_Delete]</Text>
                </MenuElement>
            }
            else
            {
                <MenuElement Icon="Icons.WarningCircle" OnSelect="Report" Danger>
                    <Text>@Loc[L.Report_Note]</Text>
                </MenuElement>
            }
            <ClosingBackdrop OnClose="ContextMenu.Close"></ClosingBackdrop>
        </Menu>
    </button>
</div>

@code {
    [Parameter] [EditorRequired] public required List<NoteReactionSchema> Reactions      { get; set; }
    [Parameter] [EditorRequired] public required int                      Likes          { get; set; }
    [Parameter] [EditorRequired] public required bool                     IsLiked        { get; set; }
    [Parameter] [EditorRequired] public required int                      Renotes        { get; set; }
    [Parameter] [EditorRequired] public required int                      Replies        { get; set; }
    [Parameter]                  public          bool                     RenotePossible { get; set; }
    [Parameter]                  public          bool                     Indented       { get; set; }
    private                                      Menu                     ContextMenu    { get; set; } = null!;
    private                                      Menu                     RenoteMenu     { get; set; } = null!;
    private                                      ElementReference         RenoteButton   { get; set; }
    private                                      ElementReference         EmojiButton    { get; set; }
    private                                      ElementReference         MenuButton     { get; set; }
    private                                      bool                     CanShare       { get; set; }

    [CascadingParameter] NoteBase Note { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CanShare = await JsSvc.CanShareAsync($"Note by {Note.User.DisplayName ?? Note.User.Username}", Note.Url);
    }

    private void ToggleMenu() => ContextMenu.Toggle(MenuButton);

    private void Delete() => _ = NoteActions.DeleteAsync(Note);

    private void Report() => _ = NoteActions.ReportAsync(Note);

    private void OpenAbout() => Nav.NavigateTo($"/notes/{Note.Id}/about");

    private void OpenOriginal() => Js.InvokeVoidAsync("open", Note.Url, "_blank");

    private async Task CopyLink()
    {
        var instance = await MetadataSvc.Instance.Value;
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", $"https://{instance.WebDomain}/notes/{Note.Id}");
    }

    private void CopyLinkRemote() => Js.InvokeVoidAsync("navigator.clipboard.writeText", Note.Url);

    private void CopyContents() => Js.InvokeVoidAsync("navigator.clipboard.writeText", Note.Text);

    private void Share() => JsSvc.ShareAsync($"Note by {Note.User.DisplayName ?? Note.User.Username}", Note.Url);

    private void Bookmark()
    {
        _ = NoteActions.ToggleBookmarkAsync(Note);
    }

    private void Pin()
    {
        _ = NoteActions.TogglePinnedAsync(Note);
    }

    private void Like()
    {
        _ = NoteActions.ToggleLikeAsync(Note);
    }

    private void Reply()
    {
        NoteActions.Reply(Note);
    }

    private void Edit()
    {
        NoteActions.Edit(Note);
    }

    private void ToggleRenoteMenu()
    {
        RenoteMenu.Toggle(RenoteButton);
    }

    private void Renote(NoteVisibility visibility)
    {
        _ = NoteActions.RenoteAsync(Note, visibility);
    }

    private void Unrenote()
    {
        _ = NoteActions.UnrenoteAsync(Note);
    }

    private void Quote()
    {
        NoteActions.DoQuote(Note);
    }

    private async Task ToggleEmojiPicker()
    {
        await GlobalComponentSvc.EmojiPicker?.Open(EmojiButton, new EventCallback<EmojiResponse>(this, React))!;
    }

    private void React(EmojiResponse emoji)
    {
        NoteActions.React(Note, emoji);
    }

    private void Redraft()
    {
        _ = NoteActions.RedraftAsync(Note);
    }

    private async Task Bite()
    {
        try
        {
            await NoteActions.BiteAsync(Note);
            await GlobalComponentSvc.NoticeDialog?.Display(Loc[L.User_BiteDialog_Notice, Note.User.DisplayName ?? Note.User.Username])!;
        }
        catch (ApiException e)
        {
            await GlobalComponentSvc.NoticeDialog?.DisplayApiError(e)!;
        }
    }

    private void Mute()
    {
        _ = NoteActions.MuteAsync(Note);
    }

    private async Task RefetchNote() =>
        await GlobalComponentSvc.ConfirmDialog?.Confirm(new EventCallback<bool>(this, RefetchNoteCallback), Loc[L.Note_RefetchDialog_Question])!;

    private async Task RefetchNoteCallback(bool refetch)
    {
        if (!refetch) return;
        await NoteActions.RefetchRemoteNoteAsync(Note.Id);
    }
}

@using Iceshrimp.Assets.PhosphorIcons

    @if (NoteResponse.Renote != null)
    {
        <div class="renote">
            <div class="renote-info">
                <span class="user">
                    <Icon Name="Icons.Repeat" Size="1.3em"/>
                    @if (NoteResponse.User.IsBot)
                    {
                        <Icon Name="Icons.Robot" Size="1.3em" title="Automated"/>
                    }
                    @Loc[L.Note_RenotedLabel]
                    <a href="@($"/{NoteResponse.User.Handle}")">
                        <UserDisplayName User="@NoteResponse.User"/>
                    </a>
                </span>
                <span class="metadata">
                    <NoteMetadata Visibility="NoteResponse.Visibility" CreatedAt="DateTime.Parse(NoteResponse.CreatedAt)"/>
                </span>
            </div>
            <NoteComponent Note="NoteResponse.Renote" Quote="NoteResponse.Quote" Indented="Indented" OpenNote="@OpenNote"/>
        </div>
    }
    else
    {
        @if (NoteResponse.Filtered is not null && NoteResponse.Filtered.Hide == false)
        {
            <div>
                @Loc[L.Note_HiddenByFilter]
                <span class="filter-name">@NoteResponse.Filtered.Name</span>
                <button
                    @onclick="@ShowNote"
                    @onclick:stopPropagation="true">
                    @if (_overrideHide)
                    {
                        @Loc[L.Common_Hide]
                    }
                    else
                    {
                        @Loc[L.Common_Show]
                    }
                </button>
            </div>
        }

        @if (_overrideHide || NoteResponse.Filtered == null)
        {
            <NoteComponent Note="NoteResponse" Quote="NoteResponse.Quote" Indented="Indented" ReplyInaccessible="NoteResponse.ReplyInaccessible" OpenNote="@OpenNote" RootNote="RootNote"/>
        }
    }

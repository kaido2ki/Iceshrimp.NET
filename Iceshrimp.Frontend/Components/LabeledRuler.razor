<span class="labeled-ruler">
    @if (LeftRule)
    {
        <span class="rule"></span>
    }

    <span class="label">@Label</span>

    @if (RightRule)
    {
        <span class="rule"></span>
    }
</span>

@code {
    [Parameter, EditorRequired] public required string Label     { get; set; }
    [Parameter]                 public          bool   LeftRule  { get; set; } = true;
    [Parameter]                 public          bool   RightRule { get; set; } = true;
}
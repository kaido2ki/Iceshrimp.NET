@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@inject AnnouncementService            AnnouncementService;
@inject ApiService                     Api;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;

<dialog class="modal" @ref="Dialog">
    <div class="dialog-header header">
        <Icon Name="Icons.Megaphone" Size="1.3em"/>
        @if (Announcements.Count != 1)
        {
            <span>@Loc[L.Announcements_Count, Current + 1, Announcements.Count]</span>
        }
        else
        {
            <span>@Loc[L.Announcement]</span>
        }
    </div>
    <div class="body">
        @if (Announcements.Count != 0)
        {
            var current = Announcements[Current];

            <span class="title">
                    <MfmText Text="@current.Title" Emoji="@current.Emojis" Simple/>
                </span>
            <span class="text">
                    <MfmText Text="@current.Text" Emoji="@current.Emojis"/>
                </span>

            @if (current.ImageUrl != null)
            {
                <img src="@current.ImageUrl"/>
            }

            <span class="date">
                    @if (current.UpdatedAt != null)
                {
                    @Loc[L.Announcement_Date_CreatedAt_UpdatedAt, current.CreatedAt.ToLocalTime().ToString("G"), current.UpdatedAt.Value.ToLocalTime().ToString("G")]
                }
                else
                {
                    @current.CreatedAt.ToLocalTime().ToString("G")
                }
                </span>
        }
    </div>
    <div class="dialog-footer button-group">
        @if (Announcements.Count != 1)
        {
            <button class="button" @onclick="Previous"
                    disabled="@(Current == 0 && NextButton?.State != StateButton.StateEnum.Loading)">
                <Icon Name="Icons.CaretLeft"/>
                @Loc[L.Common_Previous]
            </button>
        }
        <StateButton OnClick="Next" ExtraClasses="button primary-button" @ref="NextButton">
            <Initial>
                <span>@Loc[L.Common_Next]</span>
                <Icon Name="Icons.CaretRight"/>
            </Initial>
            <Success>
                <span>@Loc[L.Common_Close]</span>
            </Success>
            <Loading>
                <span>@Loc[L.StateButton_Loading]</span>
                <LoadingSpinner/>
            </Loading>
            <Failed>
                @Loc[L.StateButton_Retry]<Icon Name="Icons.X"/>
            </Failed>
        </StateButton>
    </div>
</dialog>

@code {
    private ElementReference           Dialog { get; set; }
    private StateButton?               NextButton     { get; set; }
    private int                        Current        { get; set; }
    private PaginationData?            PaginationData { get; set; }
    private List<AnnouncementResponse> Announcements  { get; set; } = [];

    private async Task CloseDialog()
    {
        Announcements = [];
        await Js.CloseDialogAsync(Dialog);
    }

    public async Task Display()
    {
        // Don't display announcement dialog if it hasn't closed
        if (Announcements.Count != 0) return;

        var res = await Api.Announcements.GetAnnouncementsAsync(true, new PaginationQuery { MinId = "0" });
        PaginationData = res.Links;
        Announcements  = res.Data.OrderBy(p => p.Id).ToList();
        Current        = 0;

        // Don't display announcement dialog if there are no new announcements
        if (Announcements.Count == 0) return;

        NextButton?.State = Announcements.Count != 1 ? StateButton.StateEnum.Initial : StateButton.StateEnum.Success;

        StateHasChanged();

        await Js.ShowDialogAsync(Dialog);
    }

    private void Previous()
    {
        if (Current != 0)
        {
            Current--;
            NextButton?.State = StateButton.StateEnum.Initial;
        }
    }

    private async Task Next()
    {
        if (NextButton?.State == StateButton.StateEnum.Loading) return;

        await Api.Announcements.ReadAnnouncementAsync(Announcements[Current].Id);

        if (NextButton?.State == StateButton.StateEnum.Success)
        {
            await CloseDialog();
        }
        if (NextButton?.State == StateButton.StateEnum.Initial)
        {
            if (Current != Announcements.Count - 2)
            {
                Current++;
                return;
            }
            if (Current == Announcements.Count - 2 && PaginationData?.Prev == null)
            {
                Current++;
                NextButton.State = StateButton.StateEnum.Success;
                return;
            }

            NextButton.State = StateButton.StateEnum.Loading;

            var pq  = new PaginationQuery { MinId = PaginationData?.Prev?.Split('=')[1], Limit = PaginationData?.Limit };
            var res = await Api.Announcements.GetAnnouncementsAsync(true, pq);

            PaginationData = res.Links;
            Announcements.AddRange(res.Data.OrderBy(p => p.Id));

            NextButton.State = res.Data.Count == 0 ? StateButton.StateEnum.Success : StateButton.StateEnum.Initial;
            Current++;
        }
    }

    protected override void OnInitialized()
    {
        AnnouncementService.AnnouncementsDialog = this;
    }
}
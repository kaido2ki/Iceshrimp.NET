@using System.Text.Json
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Services
@inject GlobalComponentSvc             GlobalComponentSvc;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;

<dialog @onkeyup="HandleKeys" class="dialog" @ref="Dialog">
    <div class="notice">
        <span class="notice-icon">
            @switch (Type)
            {
                case NoticeType.Warning:
                    <Icon Name="Icons.WarningCircle" Size="3em"/>
                    break;
                case NoticeType.Error:
                    <Icon Name="Icons.Warning" Size="3em"/>
                    break;
                case NoticeType.Notice:
                    <Icon Name="Icons.Info" Size="3em"/>
                    break;
                default:
                    throw new ArgumentOutOfRangeException();
            }
        </span>
        @foreach (var line in Text)
        {
            <p class="text">@line</p>
        }
        <button class="button confirm-btn" @onclick="CloseDialog">@Loc[L.Dialog_Confirm]</button>
    </div>
</dialog>

@code {
    private ElementReference Dialog { get; set; }
    private NoticeType       Type   { get; set; }
    private string[]         Text   { get; set; } = [];

    public enum NoticeType
    {
        Notice,
        Warning,
        Error
    }

    private async Task CloseDialog()
    {
        await Js.CloseDialogAsync(Dialog);
    }

    public async Task Display(string text, NoticeType type = NoticeType.Notice)
    {
        Type = type;
        Text = text.Split('\n');

        StateHasChanged();

        await Js.ShowDialogAsync(Dialog);
    }

    public async Task DisplayApiError(ApiException exception)
    {
        var message = exception is { Response.Message: not null }
            ? exception.Response.Message
            : exception.InnerException switch
            {
                HttpRequestException { StatusCode: not null } e => Loc[L.Error_Api_Http_Status, e.StatusCode],
                HttpRequestException e                          => Loc[L.Error_Api_Http_Request, e.HttpRequestError.ToString()],
                JsonException { Path: not null } e              => Loc[L.Error_Api_Json_Path_Message, e.Path, e.Message],
                JsonException e                                 => Loc[L.Error_Api_Json_Message, e.Message],
                OperationCanceledException                      => Loc[L.Error_Api_Timeout],
                _                                               => Loc[L.Error_Api_Unknown],
            };

        await Display(message, NoticeType.Error);
    }

    private async Task HandleKeys(KeyboardEventArgs e)
    {
        if (e is { Code: "Enter" or "Escape" })
        {
            await CloseDialog();
        }
    }

    protected override void OnInitialized()
    {
        GlobalComponentSvc.NoticeDialog = this;
    }
}
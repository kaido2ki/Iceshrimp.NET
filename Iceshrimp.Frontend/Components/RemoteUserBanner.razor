@inject IStringLocalizer<Localization> Loc;

<div class="remote-user-notice">
    <WarningBanner>
        @Loc[L.User_RemoteBannerNotice]
        <a href="@OriginalPageUrl" target="_blank">@Loc[L.Common_OpenOriginal]</a>
    </WarningBanner>
</div>

@code {
    [Parameter, EditorRequired] public required string OriginalPageUrl { get; set; }
}
@using AngleSharp.Text
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@inject EmojiService       EmojiService
@inject GlobalComponentSvc GlobalComponentSvc
@inject JsService          Js
@inject IStringLocalizer<Localization> Loc;

<dialog class="dialog" @ref="EmojiPickerRef">
    <div class="emoji-picker" style="--top: @(_top)px; --left: @(_left)px">
        <input @bind="EmojiFilter" @bind:event="oninput" @bind:after="FilterEmojis" class="search" type="text" placeholder="Search" aria-label="search"/>
        @foreach (var category in Categories)
        {
            <details open>
                <summary aria-label="category">@category.Category</summary>
                <div class="emoji-list">
                    @foreach (var emoji in category.Emojis)
                    {
                        <div @onclick="() => Select(emoji)" class="emoji" title=":@emoji.Name:">
                            <InlineEmoji Name="@emoji.Name" Url="@emoji.PublicUrl" Size="2rem"/>
                        </div>
                    }
                </div>
            </details>
        }
    </div>
    <ClosingBackdrop OnClose="Close"></ClosingBackdrop>
</dialog>


@code {
    private EventCallback<EmojiResponse> OnEmojiSelect  { get; set; }
    private List<EmojiResponse>          EmojiList      { get; set; } = [];
    private ElementReference             EmojiPickerRef { get; set; }
    private double                       _top;
    private double                       _left;

    private string                               EmojiFilter { get; set; } = "";
    private List<(string Category, List<EmojiResponse> Emojis)> Categories  { get; set; } = [];

    protected override void OnInitialized()
    {
        GlobalComponentSvc.EmojiPicker = this;
    }

    private async Task Select(EmojiResponse emoji)
    {
        await OnEmojiSelect.InvokeAsync(emoji);
        await Close();
    }

    private async Task Close()
    {
        await Js.CloseDialogAsync(EmojiPickerRef);
    }

    public async Task Open(ElementReference root, EventCallback<EmojiResponse> func)
    {
        if (EmojiList.Count == 0)
        {
            EmojiList = await EmojiService.GetEmojiAsync();
            FilterEmojis();
        }

        OnEmojiSelect = func;
        (_left, _top) = await Js.GetPositionAsync(root, true);
        await Js.ShowDialogAsync(EmojiPickerRef, false);
        StateHasChanged();
    }

    private bool FilterName(EmojiResponse emoji)
    {
        var split = EmojiFilter.StripLeadingTrailingSpaces().SplitSpaces();
        return split.All(x => emoji.Name.Contains(x));
    }

    private void FilterEmojis()
    {
        Categories = EmojiList
            .Where(p => FilterName(p) || p.Tags.Count(a => a.Contains(EmojiFilter.StripLeadingTrailingSpaces())) != 0)
            .OrderBy(p => p.Name)
            .ThenBy(p => p.Id)
            .GroupBy(p => p.Category)
            .OrderBy(p => p.Key == null)
            .ThenBy(p => p.Key)
            .Select(p => (p.Key ?? Loc[L.Common_Other], p.ToList()))
            .ToList();
    }
}
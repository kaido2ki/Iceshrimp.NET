@using Iceshrimp.Assets.Emoji
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@inject EmojiService                   EmojiService
@inject JsService                      Js
@inject IStringLocalizer<Localization> Loc;
@inject MetadataService                Meta;

<div @ref="Popover" class="emoji-picker" popover="auto">
    <input @bind="EmojiFilter" @bind:event="oninput" @bind:after="FilterEmojis" class="search" type="text" placeholder="Search" aria-label="search"/>
    @if (CustomCategories.Count != 0)
    {
        <p>@InstanceName</p>
    }
    @foreach (var category in CustomCategories)
    {
        <details open>
            <summary aria-label="category">@category.Name</summary>
            <div class="emoji-list">
                @foreach (var emoji in category.Emojis)
                {
                    <div @onclick="() => Select(emoji)" class="emoji" title=":@emoji.Name:">
                        <InlineEmoji Name="@emoji.Name" Url="@emoji.PublicUrl" Size="2rem"/>
                    </div>
                }
            </div>
        </details>
    }
    @if (UnicodeCategories.Count != 0)
    {
        @if (ShowSkinTonePicker)
        {
            <div class="skin-tone-picker">
                <button @onclick="() => SetSkinTone(null)">👋</button>
                @foreach (var skinTone in Emoji.SkinTones)
                {
                    <button @onclick="() => SetSkinTone(skinTone)">
                        @("👋" + skinTone)
                    </button>
                }
            </div>
        }
        else
        {
            <div class="skin-tone-picker">
                <button @onclick="() => { ShowSkinTonePicker = true; }">
                    @("👋" + SkinTone)
                </button>
                Unicode
            </div>
        }
    }
    @foreach (var category in UnicodeCategories)
    {
        <details open>
            <summary aria-label="category">@category.Name</summary>
            <div class="emoji-list">
                @foreach (var emoji in category.Emojis)
                {
                    <div @onclick="() => Select(emoji.Name)" class="emoji" title="@emoji.License">
                        <InlineEmoji Name="@emoji.Name" Url="@null" Size="2rem"/>
                    </div>
                }
            </div>
        </details>
    }
    @if (CustomCategories.Count == 0 && UnicodeCategories.Count == 0)
    {
        <p>No emojis found</p>
    }
</div>


@code {
    private EventCallback<SelectedEmoji> OnEmojiSelect { get; set; }
    private ElementReference             Popover       { get; set; }
    private string                       InstanceName  { get; set; } = null!;

    private string              EmojiFilter        { get; set; } = "";
    private List<EmojiCategory> CustomCategories   { get; set; } = [];
    private List<EmojiCategory> UnicodeCategories  { get; set; } = [];
    private string?             SkinTone           { get; set; }
    private bool                ShowSkinTonePicker { get; set; }

    private record EmojiCategory(string Name, List<EmojiResponse> Emojis);

    public abstract record SelectedEmoji;

    public sealed record SelectedEmojiResponse(EmojiResponse Emoji) : SelectedEmoji;

    public sealed record SelectedUnicodeEmoji(string Value) : SelectedEmoji;

    protected override async Task OnInitializedAsync()
    {
        InstanceName = (await Meta.Instance.Value).Name;
    }

    private async Task Select(EmojiResponse emoji)
    {
        await OnEmojiSelect.InvokeAsync(new SelectedEmojiResponse(emoji));
        await Close();
    }

    private async Task Select(string emoji)
    {
        await OnEmojiSelect.InvokeAsync(new SelectedUnicodeEmoji(emoji));
        await Close();
    }

    private async Task Close()
    {
        await Js.HidePopoverAsync(Popover);
    }

    public async Task Open(ElementReference source, EventCallback<SelectedEmoji> func)
    {
        await EmojiService.GetEmojiAsync();
        FilterEmojis();

        OnEmojiSelect = func;
        await Js.TogglePopoverAsync(Popover, source);
        StateHasChanged();
    }

    private bool FilterName(EmojiResponse emoji)
    {
        var split = EmojiFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return split.All(x => emoji.Name.Contains(x, StringComparison.InvariantCultureIgnoreCase));
    }

    private bool FilterName(string emojiName)
    {
        var split = EmojiFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return split.All(x => emojiName.Contains(x, StringComparison.InvariantCultureIgnoreCase));
    }

    private void FilterEmojis()
    {
        CustomCategories = EmojiService.Emojis?
                           .Where(p => FilterName(p) || p.Tags.Any(FilterName))
                           .OrderBy(p => p.Name)
                           .ThenBy(p => p.Id)
                           .GroupBy(p => p.Category)
                           .OrderBy(p => p.Key == null)
                           .ThenBy(p => p.Key)
                           .Select(p => new EmojiCategory(p.Key ?? Loc[L.Common_Other], p.ToList()))
                           .ToList() ?? [];

        UnicodeCategories = EmojiList.Emojis
                                     .Where(p => FilterName(p.Slug) && (!p.SkinToneSupport || SkinTone == null || (SkinTone != null && p.Value.Contains(SkinTone))))
                                     .GroupBy(p => p.Group)
                                     .Select(p => new EmojiCategory(p.Key, p.Select(e => new EmojiResponse
                                                                            {
                                                                                Id        = "",
                                                                                Name      = e.Value,
                                                                                Uri       = null,
                                                                                Tags      = [],
                                                                                Category  = e.Group,
                                                                                PublicUrl = "",
                                                                                License   = e.Slug,
                                                                                Sensitive = false
                                                                            })
                                                                            .ToList()))
                                     .ToList();
    }

    private void SetSkinTone(string? skinTone)
    {
        SkinTone           = skinTone;
        ShowSkinTonePicker = false;
        FilterEmojis();
        StateHasChanged();
    }
}

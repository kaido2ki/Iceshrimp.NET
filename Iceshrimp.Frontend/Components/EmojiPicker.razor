@using Blazored.LocalStorage
@using Iceshrimp.Assets.Emoji
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@inject EmojiService                   EmojiService
@inject JsService                      Js
@inject IStringLocalizer<Localization> Loc;
@inject ISyncLocalStorageService       LocalStorage;
@inject MetadataService                Meta;

<div @ref="Popover" class="emoji-picker" popover="auto">
    <div class="controls">
        <button class="close" @onclick="Close"><Icon Name="Icons.X"/></button>
        <input @bind="EmojiFilter" @bind:event="oninput" @bind:after="FilterEmojis" class="search" type="text" placeholder="Search" aria-label="search"/>
    </div>
    <div class="scroller">
        @if (Preferences.RecentEmojis.Count != 0 && string.IsNullOrWhiteSpace(EmojiFilter))
        {
            <div class="header">
                <Icon Name="Icons.Clock"/>
                @Loc[L.Emojis_Recent]
            </div>
            <div class="emoji-list">
                @foreach (var emoji in Preferences.RecentEmojis)
                {
                    <div @onclick="() => emoji.Slug != null ? Select(emoji.Name, emoji.Slug) : Select(emoji)"
                         class="emoji" title="@(emoji.Slug ?? emoji.Name)">
                    <InlineEmoji Name="@emoji.Name"
                                     Url="@(string.IsNullOrEmpty(emoji.PublicUrl) ? null : emoji.PublicUrl)"
                                     Size="2rem"/>
                    </div>
                }
            </div>
        }
        @if (EmojiService.Emojis is { Count: > 0 })
        {
            <div class="header">
                @if (InstanceIcon != null)
                {
                    <img class="instance-icon" src="@InstanceIcon" aria-hidden="true"/>
                }
                @InstanceName
            </div>
        }
        @foreach (var category in CustomCategories)
        {
            <details open>
                <summary aria-label="category">@category.Name</summary>
                <div class="emoji-list">
                    @foreach (var emoji in category.Emojis)
                    {
                        <div @onclick="() => Select(emoji)" class="emoji" title=":@emoji.Name:">
                            <InlineEmoji Name="@emoji.Name" Url="@emoji.PublicUrl" Size="2rem"/>
                        </div>
                    }
                </div>
            </details>
        }
        @if (UnicodeCategories.Count != 0)
        {
            @if (ShowSkinTonePicker)
            {
                <div class="header skin-tone-picker">
                    <button @onclick="() => SetSkinTone(null)">👋</button>
                    @foreach (var skinTone in Emoji.SkinTones)
                    {
                        <button @onclick="() => SetSkinTone(skinTone)">
                            @("👋" + skinTone)
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="header">
                    <button @onclick="() => { ShowSkinTonePicker = true; }">
                        @("👋" + Preferences.SkinTone)
                    </button>
                    Unicode
                </div>
            }
        }
        @foreach (var category in UnicodeCategories)
        {
            <details open>
                <summary aria-label="category">@category.Name</summary>
                <div class="emoji-list">
                    @foreach (var emoji in category.Emojis)
                    {
                        <div @onclick="() => Select(emoji.Name, emoji.Slug!)" class="emoji" title="@emoji.License">
                            <InlineEmoji Name="@emoji.Name" Url="@null" Size="2rem"/>
                        </div>
                    }
                </div>
            </details>
        }
        @if (CustomCategories.Count == 0 && UnicodeCategories.Count == 0)
        {
            <i class="header">@Loc[L.Emojis_Empty]</i>
        }
    </div>
</div>


@code {
    private EventCallback<SelectedEmoji> OnEmojiSelect { get; set; }
    private ElementReference             Popover       { get; set; }
    private string                       InstanceName  { get; set; } = null!;
    private string?                      InstanceIcon  { get; set; }

    private EmojiPreferences    Preferences        { get; set; } = null!;
    private string              EmojiFilter        { get; set; } = "";
    private List<EmojiCategory> CustomCategories   { get; set; } = [];
    private List<EmojiCategory> UnicodeCategories  { get; set; } = [];
    private bool                ShowSkinTonePicker { get; set; }

    private record EmojiCategory(string Name, List<EmojiResponse> Emojis);

    public abstract record SelectedEmoji;

    public sealed record SelectedEmojiResponse(EmojiResponse Emoji) : SelectedEmoji;

    public sealed record SelectedUnicodeEmoji(string Value) : SelectedEmoji;

    private class EmojiPreferences
    {
        public string?             SkinTone     { get; set; }
        public List<EmojiResponse> RecentEmojis { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        Preferences = LocalStorage.GetItem<EmojiPreferences>(nameof(EmojiPreferences)) ?? new EmojiPreferences();

        var instance = await Meta.Instance.Value;
        InstanceName = instance.Name;
        InstanceIcon = instance.IconUrl;
    }

    private void UpdateRecents(EmojiResponse emoji)
    {
        // Add/move emoji to start of list
        Preferences.RecentEmojis.RemoveAll(p => (emoji.Slug != null && p.Slug == emoji.Slug) || p.Name == emoji.Name);
        Preferences.RecentEmojis.Insert(0, emoji);

        // Make sure list isn't too long
        while (Preferences.RecentEmojis.Count > 8)
        {
            Preferences.RecentEmojis.RemoveAt(Preferences.RecentEmojis.Count - 1);
        }
    }

    private async Task Select(EmojiResponse emoji)
    {
        UpdateRecents(emoji);
        await OnEmojiSelect.InvokeAsync(new SelectedEmojiResponse(emoji));
        await Close();
    }

    private async Task Select(string emoji, string slug)
    {
        UpdateRecents(new EmojiResponse
        {
            Id        = "",
            Name      = emoji,
            Uri       = null,
            Tags      = [],
            Category  = null,
            PublicUrl = "",
            License   = null,
            Sensitive = false,
            Slug      = slug
        });
        await OnEmojiSelect.InvokeAsync(new SelectedUnicodeEmoji(emoji));
        await Close();
    }

    private async Task Close()
    {
        LocalStorage.SetItem(nameof(EmojiPreferences), Preferences);
        await Js.HidePopoverAsync(Popover);

        if (!string.IsNullOrWhiteSpace(EmojiFilter))
        {
            EmojiFilter = "";
            FilterEmojis();
        }
    }

    public async Task Open(ElementReference source, EventCallback<SelectedEmoji> func)
    {
        await EmojiService.GetEmojiAsync();
        FilterEmojis();

        OnEmojiSelect = func;
        await Js.TogglePopoverAsync(Popover, source);
        StateHasChanged();
    }

    private bool FilterName(EmojiResponse emoji)
    {
        var split = EmojiFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return split.All(x => emoji.Name.Contains(x, StringComparison.InvariantCultureIgnoreCase));
    }

    private bool FilterName(string emojiName)
    {
        var split = EmojiFilter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return split.All(x => emojiName.Contains(x, StringComparison.InvariantCultureIgnoreCase));
    }

    private void FilterEmojis()
    {
        CustomCategories = EmojiService.Emojis?
                           .Where(p => FilterName(p) || p.Tags.Any(FilterName))
                           .OrderBy(p => p.Name)
                           .ThenBy(p => p.Id)
                           .GroupBy(p => p.Category)
                           .OrderBy(p => p.Key == null)
                           .ThenBy(p => p.Key)
                           .Select(p => new EmojiCategory(p.Key ?? Loc[L.Emojis_Uncategorized], p.ToList()))
                           .ToList() ?? [];

        UnicodeCategories = EmojiList.Emojis
                                     .Where(p => FilterName(p.Slug) && (!p.SkinToneSupport || Preferences.SkinTone == null || (Preferences.SkinTone != null && p.Value.Contains(Preferences.SkinTone))))
                                     .GroupBy(p => p.Group)
                                     .Select(p => new EmojiCategory(p.Key, p.Select(e => new EmojiResponse
                                                                            {
                                                                                Id        = "",
                                                                                Name      = e.Value,
                                                                                Uri       = null,
                                                                                Tags      = [],
                                                                                Category  = null,
                                                                                PublicUrl = "",
                                                                                License   = null,
                                                                                Sensitive = false,
                                                                                Slug      = e.Slug
                                                                            })
                                                                            .ToList()))
                                     .ToList();
    }

    private void SetSkinTone(string? skinTone)
    {
        Preferences.SkinTone = skinTone;
        ShowSkinTonePicker   = false;
        FilterEmojis();
        StateHasChanged();
    }
}

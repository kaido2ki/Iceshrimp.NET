@using System.Text
@using Blazored.LocalStorage
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Core.InMemoryLogger
@using Iceshrimp.Frontend.Core.Services
@inject IStringLocalizer<Localization> Loc;
@inject NavigationManager              Navigation;
@inject VersionService                 Version;
@inject InMemoryLogService             LogService;
@inject IJSRuntime                     Js;
@inject ISyncLocalStorageService       LocalStorage;
@inject SessionService                 Session;
@inject UpdateService UpdateService;

<div class="error-ui">
    <h3>@Loc[L.ErrorUi_UnhandledExceptionWarning]</h3>
    <div class="body">
        <div class="text">
            <div>
                @Loc[L.ErrorUi_JoinSupportChat]
                <a href="https://chat.iceshrimp.dev/" target="_blank">https://chat.iceshrimp.dev/</a><br/>
                @Loc[L.ErrorUi_StackTrace]
            </div>
        </div>
        <div class="log-block">
            <pre><code>@Exception.GetType(): @Exception.Message
@Exception.StackTrace</code></pre>
        </div>
        <div class="version">
            <span class="name">Iceshrimp.NET</span>
            <span class="value">
                <code>@Version.Version</code>
            </span>
            <span class="name">@Loc[L.Update_Codename]</span>
            <span class="value">
                <code>@Version.Codename</code>
            </span>
            @if (Version.CommitHash != null)
            {
                <span class="name">@Loc[L.Update_Commit]</span>
                <span class="value">
                    <code>@Version.CommitHash</code>
                </span>
            }
        </div>
        @Loc[L.ErrorUi_Logs]
        @Loc[L.ErrorUi_LogsWarning]
        <div class="log-block">
            <pre><code>
                @foreach (var line in _rawLog)
                {
                    @line
                }
            </code></pre>
        </div>
    </div>
    <button class="button" @onclick="Reload"><Icon Name="Icons.ArrowsClockwise"/>@Loc[L.ErrorUi_Reload]</button>
    <button class="button" @onclick="DownloadLogs"><Icon Name="Icons.DownloadSimple"/>@Loc[L.ErrorUi_DownloadLogs]</button>
    <button class="button" @onclick="ClearData"><Icon Name="Icons.Warning"/>@Loc[L.ErrorUi_ClearData]</button>

</div>

@code {
    [Parameter] [EditorRequired] public required Exception                   Exception { get; set; }
    private                                      IJSInProcessObjectReference _module = null!;
    private                                      List<string>                _rawLog = null!;

    private void Reload()
    {
        Navigation.Refresh(true);
    }

    protected override async Task OnInitializedAsync()
    {
        _rawLog = LogService.GetLogs();
        _module = (IJSInProcessObjectReference)await Js.InvokeAsync<IJSObjectReference>("import", "./Components/ErrorUi.razor.js");
    }

    private void DownloadLogs()
    {
        var logBytes = LogService.GetLogs().SelectMany(p => Encoding.UTF8.GetBytes(p)).ToArray();
        _module.InvokeVoid("DownloadFile", "log.txt", "text/plain", logBytes);
    }

    private async Task ClearData()
    {
        Session.EndSession();
        LocalStorage.Clear();
        await UpdateService.UnregisterAllSwAsync();
        Navigation.NavigateTo("/", true);
    }
}
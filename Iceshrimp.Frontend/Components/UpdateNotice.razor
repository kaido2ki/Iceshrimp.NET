@using Iceshrimp.Frontend.Core.Services
@inject UpdateService                  UpdateSvc;
@inject JsService                      Js;
@inject IStringLocalizer<Localization> Loc;
@implements IDisposable

<dialog closedby="none" class="modal" @ref="Dialog">
    <div class="dialog-header">@Loc[L.Update_Notice]</div>
    <div class="version">
        <span class="name">Iceshrimp.NET</span>
        <span class="value">
            <code>@UpdateSvc.BackendVersion?.Version</code>
        </span>
        <span class="name">@Loc[L.Update_Codename]</span>
        <span class="value">
            <code>@UpdateSvc.BackendVersion?.Codename</code>
        </span>
        @if (UpdateSvc.BackendVersion?.CommitHash != null)
        {
            <span class="name">@Loc[L.Update_Commit]</span>
            <span class="value">
                <code>@UpdateSvc.BackendVersion?.CommitHash</code>
            </span>
        }
        <span class="name">
            <a href="@UpdateSvc.BackendVersion?.ReleaseUrl" target="_blank">@Loc[L.Update_ReleaseNotes]</a>
        </span>
    </div>
    <div class="dialog-footer button-group">
        <StateButton @ref="UpdateButton" OnClick="SwitchVersion" ExtraClasses="button">
            <Success>@Loc[L.Update_StateButton_Success]</Success>
            <Initial>@Loc[L.Update_StateButton_Initial]</Initial>
            <Loading>@Loc[L.StateButton_Loading]<LoadingSpinner/>
            </Loading>
            <Failed>@Loc[L.Update_StateButton_Error]</Failed>
        </StateButton>
    </div>
</dialog>

@code {
    private ElementReference Dialog       { get; set; }
    private StateButton      UpdateButton { get; set; } = null!;

    protected override void OnInitialized()
    {
        UpdateSvc.UpdateStatusEvent += OnUpdateStatusChange;
    }

    private void OnUpdateStatusChange(object? _, UpdateService.UpdateStates newState)
    {
        if (newState != UpdateService.UpdateStates.NoUpdate)
            OpenDialog();

        if (newState == UpdateService.UpdateStates.UpdateInstalled)
            UpdateButton.State  = StateButton.StateEnum.Initial;

        StateHasChanged();
    }

    private void OpenDialog()
    {
        Js.ShowDialogAsync(Dialog);

        UpdateSvc.DialogOpen = true;
    }

    private async Task SwitchVersion()
    {
        if (UpdateSvc.UpdateState == UpdateService.UpdateStates.UpdateInstalled)
        {
            UpdateButton.State = StateButton.StateEnum.Loading;
            await UpdateSvc.SwSkipWaitingAsync();
        }
    }

    public void Dispose()
    {
        UpdateSvc.UpdateStatusEvent -= OnUpdateStatusChange;
    }
}

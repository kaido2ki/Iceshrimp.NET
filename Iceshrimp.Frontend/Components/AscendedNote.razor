@* ReSharper disable once RedundantUsingDirective *@
@using Iceshrimp.Frontend.Components.Note
@using Iceshrimp.Shared.Schemas.Web
@inject NavigationManager Nav;

<div class="note-parent">
    <div class="note-container">
        <div class="note-indent">
            <UserAvatar User="@Note.User" OnClick="OpenProfile"/>
            <Line></Line>
        </div>
        <div class="note">
            <Note Indented="true" NoteResponse="Note" OpenNote="true"/>
        </div>
    </div>
</div>


@code {
    [Parameter] [EditorRequired] public required NoteResponse Note { get; set; }

    private void OpenProfile() => Nav.NavigateTo($"/{Note.User.Handle}");
}
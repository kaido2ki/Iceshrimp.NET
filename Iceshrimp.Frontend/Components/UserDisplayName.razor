@using Iceshrimp.Shared.Schemas.Web
@if (!string.IsNullOrWhiteSpace(User.DisplayName) && User.Emojis.Count != 0)
{
    <MfmText Text="@User.DisplayName.Split('\n')[0]" Emoji="@User.Emojis" Simple="@true"/>
}
else
{
    @(!string.IsNullOrWhiteSpace(User.DisplayName) ? User.DisplayName : User.Username)
}

@code {
    [Parameter] [EditorRequired] public required UserResponse User { get; set; }
}
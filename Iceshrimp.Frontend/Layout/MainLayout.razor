@using Iceshrimp.Frontend.Core.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase
@inject SettingsService Settings;

<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Settings.Preferences.CustomCss))
    {
        <style>@Settings.Preferences.CustomCss</style>
    }
</HeadContent>

<div class="page">
    <div class="sidebar" role="navigation">
        <AuthorizeView>
            <Authorized>
                <Sidebar/>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="main" role="main">
        <div class="top-bar">
            <SectionOutlet SectionName="top-bar-icon"/>
            <span class="title">
                <SectionOutlet SectionName="top-bar"/>
            </span>
            <section class="actions">
                <SectionOutlet SectionName="top-bar-actions"/>
            </section>
        </div>
        @Body
    </div>
    <div class="widget-panel" role="region" aria-label="widgets">
        <AuthorizeView>
            <Authorized>
                <WidgetPanel/>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

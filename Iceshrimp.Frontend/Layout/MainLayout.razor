@using Blazored.LocalStorage
@using Iceshrimp.Frontend.Components
@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Schemas
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase
@inject ApiService                     Api;
@inject GlobalComponentSvc             Global;
@inject IJSRuntime                     Js;
@inject IStringLocalizer<Localization> Loc;
@inject ILocalStorageService           LocalStorage;
@inject ILogger<MainLayout>            Logger;
@inject MetadataService                Metadata;
@inject NavigationManager              Nav;
@inject SessionService                 Session;
@inject SettingsService                Settings;

<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Settings.Preferences.CustomCss))
    {
        <style>@Settings.Preferences.CustomCss</style>
    }
</HeadContent>

<div class="page">
    <div class="sidebar" role="navigation">
        <AuthorizeView>
            <Authorized>
                <Sidebar/>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="main" role="main">
        <div class="top-bar">
            <SectionOutlet SectionName="top-bar-icon"/>
            <span class="title">
                <SectionOutlet SectionName="top-bar"/>
            </span>
            <section class="actions">
                <SectionOutlet SectionName="top-bar-actions"/>
            </section>
        </div>
        @Body
    </div>
    <div class="widget-panel" role="region" aria-label="widgets">
        <AuthorizeView>
            <Authorized>
                <WidgetPanel/>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    const string PushRegisteredKey = "push_registered";

    private IJSObjectReference       Module         { get; set; } = null!;
    private Dictionary<string, bool> PushRegistered { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current == null)
            return;

        var res = await Api.Auth.GetAuthStatusAsync();
        if (res.Status != AuthStatusEnum.Authenticated)
        {
            var id = Session.Current.Id;
            Session.EndSession();
            Session.DeleteUser(id);
            Nav.NavigateTo("/login");
        }

        PushRegistered = await LocalStorage.GetItemAsync<Dictionary<string, bool>>(PushRegisteredKey) ?? new Dictionary<string, bool>();

        if (PushRegistered.ContainsKey(Session.Current.Id)) return;

        Global.BannerComponent?.AddBanner(new BannerContainer.Banner
        {
            Text    = Loc[L.Notification_Banner_EnablePush],
            OnClose = DeclinePushAsync,
            OnTap   = SubscribePushAsync
        });
    }

    private async Task SubscribePushAsync()
    {
        PushSubscriptionJson? subscription;
        try
        {
            subscription = await Module.InvokeAsync<PushSubscriptionJson?>("setupPush", (await Metadata.Instance.Value).VapidKey);
        }
        catch (JSException e)
        {
            Logger.LogError("Failed to setup push notifications: {Message}", e.Message);
            return;
        }

        if (subscription == null) return;

        try
        {
            await Api.Notifications.SubscribePushAsync(new WebPushSubscriptionRequest { Endpoint = subscription.Endpoint, PublicKey = subscription.Keys.P256Dh, AuthSecret = subscription.Keys.Auth });
        }
        catch (ApiException e)
        {
            Logger.LogWarning("Failed to subscribe to push notifications: {Message}", e.Response?.Message ?? e.Response?.StatusCode.ToString() ?? "HTTP error");
            return;
        }

        PushRegistered.Add(Session.Current!.Id, true);
        await LocalStorage.SetItemAsync(PushRegisteredKey, PushRegistered);
    }

    private async Task DeclinePushAsync()
    {
        PushRegistered.Add(Session.Current!.Id, false);
        await LocalStorage.SetItemAsync(PushRegisteredKey, PushRegistered);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Module = await Js.InvokeAsync<IJSObjectReference>("import", "./push.js");
        }
    }
}

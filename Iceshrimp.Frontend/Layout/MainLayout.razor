@using Iceshrimp.Frontend.Core.Miscellaneous
@using Iceshrimp.Frontend.Core.Schemas
@using Iceshrimp.Frontend.Core.Services
@using Iceshrimp.Shared.Schemas.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase
@inject ApiService        Api;
@inject IJSRuntime        Js;
@inject MetadataService   Metadata;
@inject NavigationManager Nav;
@inject SessionService    Session;
@inject SettingsService   Settings;

<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Settings.Preferences.CustomCss))
    {
        <style>@Settings.Preferences.CustomCss</style>
    }
</HeadContent>

<div class="page">
    <div class="sidebar" role="navigation">
        <AuthorizeView>
            <Authorized>
                <Sidebar/>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="main" role="main">
        <div class="top-bar">
            <SectionOutlet SectionName="top-bar-icon"/>
            <span class="title">
                <SectionOutlet SectionName="top-bar"/>
            </span>
            <section class="actions">
                <SectionOutlet SectionName="top-bar-actions"/>
            </section>
        </div>
        @Body
    </div>
    <div class="widget-panel" role="region" aria-label="widgets">
        <AuthorizeView>
            <Authorized>
                <WidgetPanel/>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Session.Current != null)
        {
            var res = await Api.Auth.GetAuthStatusAsync();
            if (res.Status != AuthStatusEnum.Authenticated)
            {
                var id = Session.Current.Id;
                Session.EndSession();
                Session.DeleteUser(id);
                Nav.NavigateTo("/login");
            }
        }

        var module = (IJSInProcessObjectReference)await Js.InvokeAsync<IJSObjectReference>("import", "./push.js");
        var subscription = await module.InvokeAsync<PushSubscriptionJson?>("setupPush", (await Metadata.Instance.Value).VapidKey);
        if (subscription == null) return;

        try
        {
            await Api.Notifications.SubscribePushAsync(new WebPushSubscriptionRequest { Endpoint = subscription.Endpoint, PublicKey = subscription.Keys.P256Dh, AuthSecret = subscription.Keys.Auth });
        }
        catch (ApiException e)
        {
            Console.WriteLine($"Failed to subscribe to push notifications: {e.Response.Message ?? e.Response.StatusCode.ToString()}");
        }
    }
}

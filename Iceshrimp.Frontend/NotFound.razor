@page "/not-found"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Frontend.Components
@using Microsoft.AspNetCore.Components.Sections
@inject IStringLocalizer<Localization.Localization> Loc;
@inject NavigationManager                           Nav;

<HeadTitle Text="@Loc[L.Error_PageNotFound]"/>

<LayoutView Layout="@typeof(MainLayout)">
    <SectionContent SectionName="top-bar">
        <Icon Name="Icons.TriangleDashed"/>
        @Loc[L.Error_PageNotFound]
    </SectionContent>

    <div class="not-found">
        <Icon Name="Icons.TriangleDashed" Size="3em"/>
        <h2>@Loc[L.Error_PageNotFound]</h2>
        <p>@Loc[L.Error_NotFound_Notice]</p>
        <button class="button" @onclick="NavHome">
            <Icon Name="Icons.House"/>
            @Loc[L.Common_GoHome]
        </button>
    </div>
</LayoutView>

@code
{
    private void NavHome() => Nav.NavigateTo("/");
}
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Backend.Components.Generic
@using Iceshrimp.Backend.Components.PublicPreview.Schemas

<div class="note">
    <div class="note-details">
        <UserComponent User="Note.User" Link="true"/>
        <a href="/notes/@Note.Id">
            <Timestamp Date="@Note.CreatedAt"/>
        </a>
    </div>

    <div class="content">
        @if (Note.Cw != null)
        {
            <details>
                <summary>@Note.Cw</summary>
                <span class="mfm">@Note.Text</span>
                <NoteComponentFooter Note="Note" ShowMedia="ShowMedia"/>
            </details>
        }
        else
        {
            <span class="mfm">@Note.Text</span>
            <NoteComponentFooter Note="Note" ShowMedia="ShowMedia"/>
        }
    </div>

    @if (ShowMedia)
    {
        <div class="reactions">
            @foreach (var reaction in Note.Reactions)
            {
                <span class="reaction" title="@reaction.Name">
                    @if (reaction.Url != null)
                    {
                        <img class="@("emoji" + (reaction.Sensitive ? " sensitive" : ""))" src="@reaction.Url" alt="@reaction.Name"/>
                    }
                    else
                    {
                        <span class="emoji">@reaction.Name</span>
                    }
                    @reaction.Count
                </span>
            }
        </div>
    }

    <div class="note-counts">
        <span class="count">
            <Icon Name="Icons.ArrowUUpLeft" Size="1.3em"/>
            @Note.RepliesCount
        </span>
        <span class="count">
            <Icon Name="Icons.Repeat" Size="1.3em"/>
            @Note.RenoteCount
        </span>
        <span class="count">
            <Icon Name="Icons.Heart" Size="1.3em"/>
            @Note.LikeCount
        </span>
        <span class="count">
            <Icon Name="Icons.Smiley" Size="1.3em"/>
            @Note.Reactions.Sum(p => p.Count)
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required PreviewNote Note      { get; set; }
    [Parameter, EditorRequired] public required bool        ShowMedia { get; set; }
}
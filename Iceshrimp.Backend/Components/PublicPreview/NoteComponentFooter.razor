@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Backend.Components.PublicPreview.Schemas
@if (!HasFooterContent)
{
    return;
}

<div class="footer">
    @if (Note.QuoteUrl != null)
    {
        var displayUrl = Note.QuoteUrl.StartsWith("https://") ? Note.QuoteUrl[8..] : Note.QuoteUrl[7..];
        <div>
            @if (Note.QuoteInaccessible)
            {
                <i>This note is quoting <a href="@Note.QuoteUrl">@displayUrl</a>, which has either been deleted or is
                    not
                    publicly visible.</i>
            }
            else
            {
                <i>This note is quoting <a href="@Note.QuoteUrl">@displayUrl</a></i>
            }
        </div>
    }

    @if (Note.Poll != null)
    {
        var total = Note.Poll.Choices.Sum(p => p.Votes);

        <div class="poll-results">
            @foreach (var choice in Note.Poll.Choices)
            {
                var percentage = total == 0 ? 0 : Math.Floor(choice.Votes / (double)total * 100);

                <span class="poll-result" style="--percentage: @percentage%;">
                    <span class="poll-value">@choice.Value</span>
                    <span class="poll-info"><span class="vote-count">@choice.Votes votes</span><span
                            class="vote-percentage">@percentage%</span></span>
                </span>
            }
        </div>

        List<string> footerText = [];
        @if (Note.Poll.Multiple)
            footerText.Add("Multiple choice");
        @if (Note.Poll.VotersCount != null)
            footerText.Add($"{Note.Poll.VotersCount} users voted");
        @if (Note.Poll.ExpiresAt != null)
            footerText.Add(Note.Poll.ExpiresAt <= DateTime.UtcNow ? "Ended" : $"Ends at {Note.Poll.ExpiresAt.Value.ToLocalTime():G}");

        <span>@string.Join(" - ", footerText)</span>
    }

    @if (Note.Attachments is { Count: > 0 })
    {
        if (!ShowMedia)
        {
            <div>
                <i>This post has attachments, but this server's configuration prevents them from being displayed
                    here.</i>
            </div>
        }
        else
        {
            <div class="attachment-container" data-count="@Note.Attachments.Count">
                @foreach (var file in Note.Attachments)
                {
                    <div class="wrapper">
                        @if (file.MimeType.StartsWith("image/"))
                        {
                            <img class="attachment" src="@file.Url" alt="@file.Alt" title="@(file.Alt ?? "No alt text.")"/>
                        }
                        else if (file.MimeType.StartsWith("audio/"))
                        {
                            <audio controls class="attachment" src="@file.Url" title="@(file.Alt ?? "No alt text.")"></audio>
                        }
                        else if (file.MimeType.StartsWith("video/"))
                        {
                            <video controls class="attachment" title="@(file.Alt ?? "No alt text.")">
                                <source src="@file.Url" type="@file.MimeType"/>
                                <p>@(file.Alt ?? "No alt text.")</p>
                            </video>
                        }
                        else
                        {
                            <div class="attachment contents" title="@(file.Alt ?? "No alt text.")">
                                <Icon Name="Icons.FileArrowDown" Size="3em"/>
                                <a href="@file.Url" target="_blank">
                                    @file.Name
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required PreviewNote Note         { get; set; }
    [Parameter, EditorRequired] public required bool        ShowMedia { get; set; }

    private bool HasFooterContent =>
        Note.QuoteUrl != null || Note.Poll != null || Note.Attachments is { Count: > 0 };
}
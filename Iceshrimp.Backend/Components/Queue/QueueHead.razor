@using Iceshrimp.Backend.Components.Helpers
@using Microsoft.AspNetCore.Components.Web

<PageTitle>@Title - Queue - @(InstanceName ?? "Iceshrimp.NET")</PageTitle>

<HeadContent>
    <VersionedLink rel="stylesheet" href="/css/queue.css"/>
    <VersionedScript src="/js/queue.js"/>
    @if (QueueIndex)
    {
        <VersionedScript src="/js/queue-index.js"/>
    }
</HeadContent>

<QueueNav/>

@code {
    [Parameter, EditorRequired] public required string Title      { get; set; }
    [Parameter]                 public          bool   QueueIndex { get; set; }

    [CascadingParameter(Name = "InstanceName")]
    public required string? InstanceName { get; set; }
}
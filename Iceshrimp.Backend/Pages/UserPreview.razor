@page "/User"
@using Iceshrimp.Assets.PhosphorIcons
@using Iceshrimp.Backend.Components.Generic
@using Iceshrimp.Backend.Components.PublicPreview.Attributes
@attribute [Route("/@{Acct}")]
@attribute [PublicPreviewRouteFilter]
@inherits AsyncComponentBase

@if (_user is null)
{
    Context.Response.StatusCode = 404;
    <div>
        <h2>Not found</h2>
        <p>This user doesn't appear to exist on this server</p>
    </div>
}
else
{
    @if (_user.BannerUrl != null)
    {
        <img class="banner" src="@_user.BannerUrl" draggable="false"/>
    }
    <div class="user">
        <div class="user-details @(_user.BannerUrl != null ? "above-banner" : "")">
            <UserComponent User="_user" Large/>
        </div>
        @if (!string.IsNullOrEmpty(_badges))
        {
            <div class="badges">
                @_badges
            </div>
        }
        <div class="bio">
            @(_user.Bio ?? new MarkupString("<i>This user hasn't added a bio yet.</i>"))
        </div>
        <div class="data">
            @if (_location != null)
            {
                <div class="field">
                    <span class="field-name">
                        <Icon Name="Icons.MapPin"/>
                        Location
                    </span>
                    <span class="field-value">@_location</span>
                </div>
            }
            @if (_birthday != null)
            {
                <div class="field">
                    <span class="field-name">
                        <Icon Name="Icons.Balloon"/>
                        Birthday
                    </span>
                    <span class="field-value">@_birthday</span>
                </div>
            }
            @if (_pronouns != null)
            {
                <div class="field">
                    <span class="field-name">
                        <Icon Name="Icons.IdentificationCard"/>
                        Pronouns
                    </span>
                    <span class="field-value">@_pronouns</span>
                </div>
            }
            @foreach (var field in _fields)
            {
                <div class="field">
                    <span class="field-name@(field.IsVerified is true ? " verified" : "")">
                        @if (field.IsVerified is true)
                        {
                            <Icon Name="Icons.SealCheck"/>
                            <span> </span>
                        }
                        @field.Name
                    </span>
                    <span class="field-value">@field.Value</span>
                </div>
            }
        </div>
        @if (_user.MovedToUri != null)
        {
            <div class="bio">
                <i>This user has migrated to a <a href="@_user.MovedToUri">different account</a>.</i>
            </div>
        }
        @if (_feeds != null)
        {
            <div class="data">
                <a href="@_feeds["Atom"].Item2" type="@_feeds["Atom"].Item1">Atom feed</a>
                <span aria-hidden="true">|</span>
                <a href="@_feeds["JSON"].Item2" type="@_feeds["JSON"].Item1">JSON feed</a>
                <span aria-hidden="true">|</span>
                <a href="@_feeds["RSS"].Item2" type="@_feeds["RSS"].Item1">RSS feed</a>
            </div>
        }
    </div>
    @if (_pinnedNotes.Count != 0)
    {
        <LabeledRuler Label="Pinned notes"/>
    }
    @foreach (var note in _pinnedNotes)
    {
        <NoteComponent Note="note" ShowMedia="false"/>
    }
    @if (_pinnedNotes.Count != 0 && _notes.Count != 0)
    {
        <LabeledRuler Label="Latest notes"/>
    }
    @foreach (var note in _notes)
    {
        <NoteComponent Note="note" ShowMedia="false"/>
    }

    <div class="pagination">
        @if (Offset is > 0)
        {
            <button class="button" role="link" data-target="/@@@Acct?offset=@(Math.Max(0, Offset.Value - 20))"
                    onclick="navigate(event)">❮ Previous page
            </button>
        }
        else
        {
            <button class="button" disabled>❮ Previous page</button>
        }

        @if (_notes.Count == 20)
        {
            <button class="button" role="link" data-target="/@@@Acct?offset=@((Offset ?? 0) + 20)" onclick="navigate(event)">
                Next page ❯
            </button>
        }
        else
        {
            <button class="button" disabled>Next page ❯</button>
        }
    </div>

    <PageTitle>@@@_user.Username - @_instanceName</PageTitle>
    <HeadContent>
        <meta name="twitter:card" content="summary">
        <meta property="og:site_name" content="@_instanceName">
        <meta property="og:title" content="@@@_user.Username">
        @if (_user.Bio is { } bio)
        {
            <meta property="og:description" content="@bio">
        }
        <meta property="og:image" content="@_user.AvatarUrl">
        <link rel="alternate" type="application/activity+json" href="@_user.Uri">
        @if (_feeds != null)
        {
            @foreach (var feed in _feeds.Values)
            {
                <link rel="alternate" type="@feed.Item1" href="@feed.Item2">
            }
        }
        <VersionedLink rel="stylesheet" href="/_content/Iceshrimp.Assets.PhosphorIcons/css/ph-regular.css"/>
        <VersionedLink rel="stylesheet" href="/css/public-preview.css"/>
        <VersionedScript src="/js/user-preview.js"/>
    </HeadContent>
}
@page "/queue/{Name?}/{Pagination:int?}/{Status?}"
@using Iceshrimp.Backend.Components.Queue
@using Iceshrimp.Backend.Core.Database.Tables
@using Iceshrimp.Backend.Core.Extensions
@inherits AdminComponentBase

<QueueHead Title="@(Name ?? "Overview")" QueueIndex="@(Name == null)"/>

@if (Name == null)
{
    <form onsubmit="return lookupJob(event)">
        <input type="text" id="lookup" placeholder="Lookup job by id" minlength="36" maxlength="36" class="inline"/>
        <button class="button" type="submit">Submit</button>
    </form>

    <h3>Queue status &mdash; <span id="update-status" class="status-delayed">Connecting...</span></h3>

    <table class="auto-table" id="queue-status">
        <thead>
        <th>Name</th>
        @foreach (var status in Enum.GetValues<Job.JobStatus>())
        {
            var name = Enum.GetName(status);
            <th class="justify-right">@name</th>
        }
        </thead>
        <tbody>
        @foreach (var queue in QueueStatuses!)
        {
            var isScheduled = ScheduledQueues.Contains(queue.Name);
            var scheduled   = isScheduled ? queue.JobCounts[Job.JobStatus.Delayed].ToString() : "-";
            var delayed     = !isScheduled ? queue.JobCounts[Job.JobStatus.Delayed].ToString() : "-";

            <tr>
                <td>
                    <a href="/queue/@queue.Name" class="color-fg">@queue.Name</a>
                </td>
                @foreach (var status in Enum.GetValues<Job.JobStatus>())
                {
                    var name = Enum.GetName(status)!.ToLowerInvariant();
                    if (status == Job.JobStatus.Delayed)
                    {
                        if (!isScheduled)
                        {
                            <td class="justify-right">
                                <a href="/queue/@queue.Name/1/delayed" class="status-@name">@delayed</a>
                            </td>
                        }
                        else
                        {
                            <td class="justify-right status-@name">@delayed</td>
                        }
                    }
                    else if (status == Job.JobStatus.Queued && isScheduled)
                    {
                        <td class="justify-right">
                            (<a href="/queue/@queue.Name/1/delayed" class="status-scheduled">@scheduled</a>)
                            <a href="/queue/@queue.Name/1/queued" class="status-queued">@queue.JobCounts[status]</a>
                        </td>
                    }
                    else
                    {
                        <td class="justify-right">
                            <a href="/queue/@queue.Name/1/@name" class="status-@name">@queue.JobCounts[status]</a>
                        </td>
                    }
                }
            </tr>
        }
        </tbody>
    </table>

    <h3>Recent jobs</h3>
    <table class="auto-table" id="recent-jobs">
        <thead>
        <th class="width0">ID</th>
        <th>Queue</th>
        <th>Status</th>
        <th>Actions</th>
        </thead>
        <tbody>
        @foreach (var job in Jobs)
        {
            @RenderJob(job, true)
        }
        </tbody>
    </table>

    <h3>Top delayed deliver job targets</h3>
    <table class="auto-table" id="top-delayed">
        <thead>
        <th class="width0">Instance</th>
        <th>Count</th>
        </thead>
        <tbody>
        @foreach (var instance in TopDelayed)
        {
            <tr>
                <td>@instance.Host</td>
                <td><i>@instance.Count jobs</i></td>
            </tr>
        }
        </tbody>
    </table>
    @if (TopDelayed is [])
    {
        <i>No delayed jobs found.</i>
    }

    var last        = Jobs.FirstOrDefault();
    var lastUpdated = last != null ? new DateTimeOffset(last.LastUpdatedAt).ToUnixTimeMilliseconds() : 0;

    <div class="display-none" id="last-updated">@lastUpdated</div>
}
else
{
    var delayedStr = ScheduledQueues.Contains(Name) ? "scheduled" : "delayed";
    if (Filter == null)
    {
        <p>Listing @TotalCount <b>@Name</b> jobs, out of which <span class="status-running">@RunningCount</span> are
            <span class="status-running">running</span>, <span class="status-queued">@QueuedCount</span> are <span
                class="status-queued">queued</span> and <span class="status-@delayedStr">@DelayedCount</span> are <span
                class="status-@delayedStr">@delayedStr</span>.</p>
    }
    else
    {
        var filterStr = Filter.Value == Job.JobStatus.Delayed && ScheduledQueues.Contains(Name)
            ? "scheduled"
            : Filter.Value.ToString().ToLowerInvariant();

        <p>
            Listing @TotalCount <span class="status-@filterStr">@filterStr</span> <b>@Name</b> jobs.
            @if (Filter is Job.JobStatus.Failed)
            {
                <span>Batch retry: <a class="fake-link" onclick="retryAllFailed('@Name')">all failed</a> / <a
                        class="fake-link" onclick="retryAllOnPage('@Name')">all on this page</a></span>
            }
        </p>
    }

    <table class="auto-table">
        <thead>
        <th class="width0">ID</th>
        <th>Status</th>
        <th>Actions</th>
        </thead>
        <tbody>
        @foreach (var job in Jobs)
        {
            @RenderJob(job)
        }
        </tbody>
    </table>

    <div class="flex">
        @if (PrevPage != null)
        {
            if (Filter.HasValue)
            {
                <button class="button" role="link"
                        data-target="/queue/@Name/@PrevPage/@Filter.Value.ToString().ToLowerInvariant()"
                        onclick="navigate">❮ Previous page
                </button>
            }
            else
            {
                <button class="button" role="link" data-target="/queue/@Name/@PrevPage" onclick="navigate(event)">❮
                    Previous page
                </button>
            }
        }
        else
        {
            <button class="button" disabled>❮ Previous page</button>
        }

        @if (NextPage != null)
        {
            if (Filter.HasValue)
            {
                <button class="button" role="link"
                        data-target="/queue/@Name/@NextPage/@Filter.Value.ToString().ToLowerInvariant()"
                        onclick="navigate(event)">Next page ❯
                </button>
            }
            else
            {
                <button class="button" role="link" data-target="/queue/@Name/@NextPage" onclick="navigate(event)">Next
                    page ❯
                </button>
            }
        }
        else
        {
            <button class="button" disabled>Next page ❯</button>
        }

        <select onchange="filter('@Name')" id="filter" class="inline-flex">
            @if (Filter == null)
            {
                <option value="all" selected>All</option>
            }
            else
            {
                <option value="all">All</option>
            }
            @foreach (var status in Enum.GetValues<Job.JobStatus>())
            {
                var statusStr = status == Job.JobStatus.Delayed && ScheduledQueues.Contains(Name)
                    ? "Scheduled"
                    : status.ToString();

                if (Filter.Equals(status))
                {
                    <option value="@status.ToString().ToLowerInvariant()" selected>@statusStr</option>
                }
                else
                {
                    <option value="@status.ToString().ToLowerInvariant()">@statusStr</option>
                }
            }
        </select>

        <form onsubmit="return lookupJob(event)" class="inline-flex flex-grow">
            <input type="text" id="lookup" placeholder="Lookup job by id" minlength="36" maxlength="36"
                   class="flex-grow"/>
        </form>
    </div>
}

@code {
    private RenderFragment RenderJob(Job job, bool withQueue = false)
    {
        var id = job.Id.ToStringLower();
        var additional = job.Status switch
        {
            Job.JobStatus.Delayed when job.RetryCount is 0 => $"for {job.DelayedUntil?.ToLocalTime().ToDisplayStringTz() ?? "<unknown>"}",
            // Separated for readability
            Job.JobStatus.Queued    => $"for {job.QueueDuration.ToDurationDisplayString()}",
            Job.JobStatus.Running   => $"for {job.Duration.ToDurationDisplayString()}",
            Job.JobStatus.Delayed   => $"until {job.DelayedUntil?.ToLocalTime().ToDisplayStringTz() ?? "<unknown>"}",
            Job.JobStatus.Completed => $"at {job.FinishedAt?.ToLocalTime().ToDisplayStringTz() ?? "<unknown>"}",
            Job.JobStatus.Failed    => $"at {job.FinishedAt?.ToLocalTime().ToDisplayStringTz() ?? "<unknown>"}",
            _                       => throw new ArgumentOutOfRangeException()
        };

        var classes = Last != null && new DateTimeOffset(job.LastUpdatedAt).ToUnixTimeMilliseconds() > Last
            ? "new-item"
            : "";

        var status = job is { Status: Job.JobStatus.Delayed, RetryCount: 0 } ? "Scheduled" : job.Status.ToString();

        return @<tr class="@classes">
                   @if (withQueue)
                   {
                       <td class="uuid-abbrev">@id[..8]...@id[24..]</td>
                       <td>@job.Queue</td>
                   }
                   else
                   {
                       <td class="uuid">@id</td>
                   }
                   <td class="status-@status.ToLowerInvariant()">
                       <b>@status</b> <small>@additional</small>
                   </td>
                   <td>
                       <a href="/queue/job/@id">View details</a>
                   </td>
               </tr>;
    }
}